msgctxt "res_entregue"
msgid "The file it was missing did arrive, in the width this program can use."
msgstr "Le fichier qui manquait est bien arrive, dans la largeur que ce programme utilise."

msgctxt "res_nao_chegou"
msgid "What was installed did not put the missing file where the program looks."
msgstr "Ce qui a ete installe n'a pas mis le fichier manquant la ou le programme le cherche."

msgctxt "res_sem_alvo"
msgid "There was no file I could check for, so I cannot say either way."
msgstr "Il n'y avait aucun fichier a verifier, je ne peux donc dire ni oui ni non."

msgctxt "res_abriu"
msgid "It opened."
msgstr "Il s'est ouvert."

msgctxt "res_executou"
