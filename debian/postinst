#!/bin/bash
set -e

update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
# Registra os tipos .xapk/.apks/.apkm. Sem isso o sistema ve so um ZIP e o
# duplo clique nunca chega ao Tandem.
update-mime-database /usr/share/mime 2>/dev/null || true

# Descobre quem instalou, para aplicar as associacoes no perfil certo.
USUARIO="${SUDO_USER:-}"
if [ -z "$USUARIO" ] && [ -n "${PKEXEC_UID:-}" ]; then
    USUARIO="$(getent passwd "$PKEXEC_UID" | cut -d: -f1 || true)"
fi
[ -z "$USUARIO" ] && USUARIO="$(logname 2>/dev/null || true)"

# Adiantar o trabalho por-usuario e so um atalho: quando as tres vias acima
# falham - e todas falham juntas se o .deb for instalado pelo instalador
# grafico, que roda num daemon sem sudo e sem terminal - o proprio programa
# faz isso na primeira execucao, ja rodando como o dono do HOME.
# TANDEM_SILENCIOSO impede que um dialogo abra no meio do apt e trave o dpkg.
if [ -n "$USUARIO" ] && [ "$USUARIO" != "root" ]; then
    LAR="$(getent passwd "$USUARIO" | cut -d: -f6 || true)"
    if [ -n "$LAR" ] && [ -d "$LAR" ]; then
        runuser -u "$USUARIO" -- env TANDEM_SILENCIOSO=1 PATH=/usr/bin:/bin \
            tandem --primeira-vez >/dev/null 2>&1 || true
    fi
fi

cat <<'FIM'

  Tandem instalado.

    Clique duas vezes num .exe ou .msi   -> roda no Windows (Wine)
    Clique duas vezes num .apk ou .xapk  -> instala no Android
    Menu de aplicativos -> Tandem        -> painel com tudo

  Verifique o ambiente com:  tandem doctor

FIM
exit 0
