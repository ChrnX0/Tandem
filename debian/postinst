#!/bin/bash
set -e

update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
# Registers the .xapk/.apks/.apkm types. Without this the system sees only a
# ZIP and the double click never reaches Tandem.
update-mime-database /usr/share/mime 2>/dev/null || true

# Find out who installed it, so the associations are applied to the right
# profile.
USUARIO="${SUDO_USER:-}"
if [ -z "$USUARIO" ] && [ -n "${PKEXEC_UID:-}" ]; then
    USUARIO="$(getent passwd "$PKEXEC_UID" | cut -d: -f1 || true)"
fi
[ -z "$USUARIO" ] && USUARIO="$(logname 2>/dev/null || true)"

# Getting the per-user work done here is only a shortcut: when the three
# routes above fail - and they all fail together if the .deb is installed by
# the graphical installer, which runs inside a daemon with no sudo and no
# terminal - the program itself does this on the first run, already running as
# the owner of the HOME.
# TANDEM_SILENCIOSO keeps a dialog from opening in the middle of apt and
# hanging dpkg.
if [ -n "$USUARIO" ] && [ "$USUARIO" != "root" ]; then
    LAR="$(getent passwd "$USUARIO" | cut -d: -f6 || true)"
    if [ -n "$LAR" ] && [ -d "$LAR" ]; then
        runuser -u "$USUARIO" -- env TANDEM_SILENCIOSO=1 PATH=/usr/bin:/bin \
            tandem --primeira-vez >/dev/null 2>&1 || true
    fi
fi

cat <<'FIM'

  Tandem instalado.

    Clique duas vezes num .exe ou .msi   -> roda no Windows (Wine)
    Clique duas vezes num .apk ou .xapk  -> instala no Android
    Clique duas vezes num .AppImage      -> roda direto, sem instalar
    Clique duas vezes num .jar           -> roda no Java
    Menu de aplicativos -> Tandem        -> painel com tudo

  Verifique o ambiente com:  tandem doctor

FIM
exit 0
