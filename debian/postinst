#!/bin/bash
set -e

update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
# Registers the .xapk/.apks/.apkm types. Without this the system sees only a
# ZIP and the double click never reaches Tandem.
update-mime-database /usr/share/mime 2>/dev/null || true

# Find out who installed it, so the associations are applied to the right
# profile.
USUARIO="${SUDO_USER:-}"
if [ -z "$USUARIO" ] && [ -n "${PKEXEC_UID:-}" ]; then
    USUARIO="$(getent passwd "$PKEXEC_UID" | cut -d: -f1 || true)"
fi
[ -z "$USUARIO" ] && USUARIO="$(logname 2>/dev/null || true)"

# Getting the per-user work done here is only a shortcut: when the three
# routes above fail - and they all fail together if the .deb is installed by
# the graphical installer, which runs inside a daemon with no sudo and no
# terminal - the program itself does this on the first run, already running as
# the owner of the HOME.
# TANDEM_SILENCIOSO keeps a dialog from opening in the middle of apt and
# hanging dpkg.
if [ -n "$USUARIO" ] && [ "$USUARIO" != "root" ]; then
    LAR="$(getent passwd "$USUARIO" | cut -d: -f6 || true)"
    if [ -n "$LAR" ] && [ -d "$LAR" ]; then
        runuser -u "$USUARIO" -- env TANDEM_SILENCIOSO=1 PATH=/usr/bin:/bin \
            tandem --primeira-vez >/dev/null 2>&1 || true
    fi
fi

# The install notice, in the language the machine is set to.
#
# The catalogue is READ here, never sourced: postinst runs as root, and a file
# that will one day arrive from a translator must not be able to execute in that
# context. awk pulls one @key out of it, and nothing else happens.
#
# Falls back to English, which is the default language of the program.
diz_msg() {
    local chave="$1" lang="" arq base
    base=/usr/lib/tandem/idiomas
    lang="${LANG:-}"
    [ -z "$lang" ] && [ -r /etc/default/locale ] &&
        lang="$(sed -n 's/^LANG=//p' /etc/default/locale 2>/dev/null | tr -d '"')"
    lang="${lang%%.*}"; lang="${lang%%@*}"
    for arq in "$base/$lang.txt" "$base/${lang%%_*}.txt" "$base/en.txt"; do
        [ -r "$arq" ] || continue
        T_CHAVE="@$chave" awk '
            BEGIN { alvo = ENVIRON["T_CHAVE"] }
            $0 == alvo { dentro = 1; next }
            substr($0, 1, 1) == "@" { dentro = 0 }
            dentro { print }' "$arq"
        return 0
    done
}

printf '\n'
diz_msg instalado_resumo
printf '\n'
# ON BY DEFAULT, so this is the moment the owner is told. It is printed before
# anything has been sent, it names the one command that turns it off, and it is
# the reason a default rather than a question is defensible at all.
#
# dpkg shows this on a terminal install. A graphical installer swallows it,
# which is why the same notice is shown again on first use, with the actual
# line in it.
diz_msg envio_aviso_ligado
printf '\n'
exit 0
