// Tandem - lets the Android container start without asking for a password.
//
// The scope is deliberately narrow: only the start/restart actions of the
// waydroid-container.service unit, only for someone physically sitting at the
// machine (subject.local), with an active session, and in the administrators
// group. Every other systemd unit still requires normal authentication.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    if (unit !== "waydroid-container.service") {
        return polkit.Result.NOT_HANDLED;
    }
    var verbo = action.lookup("verb");
    if (verbo !== "start" && verbo !== "restart") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
