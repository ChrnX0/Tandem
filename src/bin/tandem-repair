#!/bin/bash
# Tandem - reapplies the file associations.
#
# Why this is necessary: GNOME reads several association files in order of
# precedence. The ~/.config/mimeapps.list is the normal one, but
# gnome-mimeapps.list and zorin-mimeapps.list have HIGHER precedence and
# override it silently. Here we write to the right place and clean up the
# competitors, with a backup.
#
# Two modes. Run by the owner, it claims every type Tandem handles - he asked.
# Run with --somente-novos, from the first execution after an upgrade, it claims
# only the types that were never claimed on this machine.
#
# That distinction is the whole reason this file keeps a record. Reclaiming
# everything on every upgrade would overwrite a choice the owner made on purpose;
# claiming nothing would mean a version that learned a new format never gets to
# open it, and the double click goes on doing nothing - which is the exact bug
# this project exists to kill. A type this machine has never seen Tandem claim
# carries no decision of the owner's to respect.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"
t_log_init repair

SOMENTE_NOVOS=0
[ "${1:-}" = "--somente-novos" ] && SOMENTE_NOVOS=1

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$CFG"
ALVO="$CFG/mimeapps.list"
# The types already applied on this machine, one per line. Lives next to the
# protected-prefix list, which is the folder that holds this user's decisions.
JA_FEITOS="$(dirname -- "$TANDEM_PROTEGIDOS")/tipos-aplicados.txt"
mkdir -p "$(dirname -- "$JA_FEITOS")" 2>/dev/null

TIPOS_APK="application/vnd.android.package-archive
application/vnd.android.xapk
application/vnd.android.apks
application/vnd.android.apkm"
TIPOS_EXE="application/x-ms-dos-executable
application/x-msdownload
application/vnd.microsoft.portable-executable
application/x-msi
application/x-msdos-program
application/x-ms-shortcut"
# The native formats. The dispute here is different in kind: for .exe there is
# a rival handler, while an AppImage usually has NOBODY - the browser saves it
# without the execute bit and the system has no idea what to do with it. The
# .jar does have a rival, the system's own Java launcher, and losing to it is
# what turns a missing Java into "nothing happened".
TIPOS_APPIMAGE="application/vnd.appimage
application/x-iso9660-appimage"
TIPOS_JAR="application/java-archive
application/x-java-archive"
# The distribution's own formats. On the machine this was written on NOBODY owned
# any of these four - the double click did nothing, exactly like an AppImage. On a
# full desktop a store claims .deb, and losing to it is fine for a package from
# the distribution's own repositories; what the store handles badly is the
# third-party .deb built for another release, which is the case that brings
# somebody here.
TIPOS_DEB="application/vnd.debian.binary-package
application/x-deb
application/x-debian-package"
TIPOS_RPM="application/x-rpm
application/x-redhat-package-manager"
TIPOS_FLATPAK="application/vnd.flatpak.ref
application/vnd.flatpak.repo"
TIPOS_SNAP="application/vnd.snap"

# application/x-shellscript is deliberately NOT in this list.
#
# It is the one type where the existing default is defensible: opening a
# downloaded script in a text editor is a better answer than running it, and a
# machine with a folder full of .sh files would have every one of them routed
# here. tandem-script is still reachable - it declares the type, so it appears
# under "Open with", and "tandem install file.sh" goes straight to it - but
# Tandem does not take a type away from a handler that is already doing the right
# thing.

# Who owned the types before? Zorin already installs "Windows App Support" and
# Waydroid installs waydroid.app.install.desktop - both fight with Tandem.
ANTES_EXE="$(t_dono_do_tipo application/x-ms-dos-executable)"
ANTES_APK="$(t_dono_do_tipo application/vnd.android.package-archive 2>/dev/null)"
ANTES_APPIMAGE="$(t_dono_do_tipo application/vnd.appimage 2>/dev/null)"
ANTES_JAR="$(t_dono_do_tipo application/java-archive 2>/dev/null)"
ANTES_DEB="$(t_dono_do_tipo application/vnd.debian.binary-package 2>/dev/null)"
t_diz "before: exe=$ANTES_EXE apk=$ANTES_APK appimage=$ANTES_APPIMAGE jar=$ANTES_JAR deb=$ANTES_DEB"

# Which types this run is responsible for.
TODOS="$TIPOS_APK $TIPOS_EXE $TIPOS_APPIMAGE $TIPOS_JAR $TIPOS_DEB $TIPOS_RPM
$TIPOS_FLATPAK $TIPOS_SNAP"
TIPOS=""
for t in $TODOS; do
    if [ "$SOMENTE_NOVOS" = 1 ] &&
       grep -qxF -- "$t" "$JA_FEITOS" 2>/dev/null; then
        continue
    fi
    TIPOS="$TIPOS $t"
done
if [ -z "$TIPOS" ]; then
    t_diz "nothing new to associate; the type list is already applied"
    exit 0
fi
t_diz "associating:$TIPOS"

for f in "$CFG"/*-mimeapps.list; do
    [ -f "$f" ] || continue
    cp -f "$f" "$f.bak-tandem" 2>/dev/null || true
    for t in $TIPOS; do
        sed -i "\|^${t}=|d" "$f" 2>/dev/null || true
    done
    t_diz "cleared conflicts in $f"
done

[ -f "$ALVO" ] || printf '[Default Applications]\n' > "$ALVO"
grep -q '^\[Default Applications\]' "$ALVO" || printf '\n[Default Applications]\n' >> "$ALVO"

aplicar() {
    local tipo="$1" app="$2"
    if grep -q "^${tipo}=" "$ALVO"; then
        sed -i "s|^${tipo}=.*|${tipo}=${app}|" "$ALVO"
    else
        sed -i "0,/^\[Default Applications\]/s||[Default Applications]\n${tipo}=${app}|" "$ALVO"
    fi
    command -v gio >/dev/null 2>&1 && gio mime "$tipo" "$app" >/dev/null 2>&1
    command -v xdg-mime >/dev/null 2>&1 && xdg-mime default "$app" "$tipo" >/dev/null 2>&1
    return 0
}

# Which handler answers for which type. Only the types selected above.
#
# Written as a loop over the unquoted variable, which splits on whitespace, and
# not as a "case" against a padded string: the lists are separated by NEWLINES,
# so a pattern looking for a type surrounded by spaces matched nothing and every
# type came out pointed at an empty handler. The suite caught it; reading it did
# not.
dono_de() {
    local t
    for t in $TIPOS_APK;      do [ "$t" = "$1" ] && { printf 'tandem-apk.desktop';      return 0; }; done
    for t in $TIPOS_EXE;      do [ "$t" = "$1" ] && { printf 'tandem-exe.desktop';      return 0; }; done
    for t in $TIPOS_APPIMAGE; do [ "$t" = "$1" ] && { printf 'tandem-appimage.desktop'; return 0; }; done
    for t in $TIPOS_JAR;      do [ "$t" = "$1" ] && { printf 'tandem-jar.desktop';      return 0; }; done
    for t in $TIPOS_DEB;      do [ "$t" = "$1" ] && { printf 'tandem-deb.desktop';      return 0; }; done
    for t in $TIPOS_RPM;      do [ "$t" = "$1" ] && { printf 'tandem-rpm.desktop';      return 0; }; done
    for t in $TIPOS_FLATPAK;  do [ "$t" = "$1" ] && { printf 'tandem-flatpak.desktop';  return 0; }; done
    for t in $TIPOS_SNAP;     do [ "$t" = "$1" ] && { printf 'tandem-snap.desktop';     return 0; }; done
    return 1
}
for t in $TIPOS; do
    # An unresolved handler would be written as "type=" - an association that
    # points at nothing, which reads to the system as "no default" and to a
    # person as "Tandem did apply it". Refuse instead, and say so.
    app="$(dono_de "$t")" || { t_diz "!!! no handler for $t; did not associate"; continue; }
    aplicar "$t" "$app"
    grep -qxF -- "$t" "$JA_FEITOS" 2>/dev/null ||
        printf '%s\n' "$t" >> "$JA_FEITOS" 2>/dev/null
done

update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

DEPOIS_EXE="$(t_dono_do_tipo application/x-ms-dos-executable)"
DEPOIS_APK="$(t_dono_do_tipo application/vnd.android.package-archive 2>/dev/null)"
DEPOIS_APPIMAGE="$(t_dono_do_tipo application/vnd.appimage 2>/dev/null)"
DEPOIS_JAR="$(t_dono_do_tipo application/java-archive 2>/dev/null)"
DEPOIS_DEB="$(t_dono_do_tipo application/vnd.debian.binary-package 2>/dev/null)"
# One message per row, with the type and both handlers as data, so a translator
# can put the labels where that language puts them instead of receiving
# "before:" and "now:" as loose fragments to slot into an order somebody else
# chose. NENHUM is a word the owner reads - "nobody owns this type" - so it is
# a message too, not a placeholder.
NENHUM="$(t_msg rep_nenhum)"
linha_do_tipo() {
    t_msg rep_linha "$1" "${2:-$NENHUM}" "${3:-$NENHUM}"
}
RES="$(linha_do_tipo ".exe" "$ANTES_EXE" "$DEPOIS_EXE")

$(linha_do_tipo ".apk" "$ANTES_APK" "$DEPOIS_APK")

$(linha_do_tipo ".AppImage" "$ANTES_APPIMAGE" "$DEPOIS_APPIMAGE")

$(linha_do_tipo ".jar" "$ANTES_JAR" "$DEPOIS_JAR")

$(linha_do_tipo ".deb" "$ANTES_DEB" "$DEPOIS_DEB")"
t_diz "$RES"

RELATORIO="$(t_msg rep_reaplicadas)

$RES"

# Called from inside the postinst or from the first run: it must not open any
# window at all. The zenity --info waits for the click, and a dialog opened in
# the middle of an "apt install" would hang the package manager until someone
# noticed and clicked.
if [ -n "${TANDEM_SILENCIOSO:-}" ]; then
    exit 0
fi

# The report goes through t_texto - the one path that tries the modern One UI
# window first, then zenity's text view, then plain output. Before, this opened
# the old zenity info box directly, so the repair report was the one screen still
# drawn in the old style while the rest of the interface had moved on; routing it here makes
# it read like everything else and still never vanish without a word (t_texto
# prints to a terminal, a pipe or a file, and only then reaches for a window).
printf '%s\n' "$RELATORIO

$(t_msg rep_saia_e_entre)" | t_texto "Tandem"
