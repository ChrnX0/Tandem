#!/bin/bash
# Tandem - installs a local .snap, and is honest about what that means.
#
# A .snap file downloaded from a website is an unusual thing to have, and the
# reason matters: snaps normally come from the store, where they are signed and
# checked. A loose .snap file has no signature that snapd will accept, so the
# only way to install it is with a flag literally named --dangerous.
#
# That flag is not hidden behind a progress bar here. The owner is told, in his
# own language, that this file cannot be checked and that installing it means
# trusting whoever sent it - and then he decides. A tool that passes
# --dangerous quietly is making that decision on his behalf, which is not its
# decision to make.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"

t_log_init snap "$*"

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "$(t_msg sem_arquivo)"; exit 1; }
ARQ="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$ARQ" ] && [ -f "$ARQ" ] || { t_erro "$(t_msg arquivo_sumiu "$BRUTO")"; exit 1; }

NOME="$(basename -- "${ARQ%.snap}")"
# The name a snap file carries is name_revision; the revision is not part of it.
NOME="${NOME%%_*}"
t_diz "local snap: $ARQ (probable name: $NOME)"

# A snap is a squashfs, so the same truncation check the AppImage reader does
# applies - and here it is the whole verdict, because a short snap is the most
# likely reason somebody has a loose .snap that will not install.
if ! head -c 4 -- "$ARQ" 2>/dev/null | grep -q 'hsqs'; then
    # Before the reader's own complaint, which is true and useless when the
    # file is an error page the site handed back instead of the program: a
    # download that goes wrong rarely produces nothing. Same ordering and
    # same sentence tandem-deb has had since 3.8 - eight handlers were never
    # wired to a detector and a translated message that already existed.
    if t_parece_pagina_web "$ARQ"; then
        t_erro "$(t_msg baixou_pagina_web "$(basename -- "$ARQ")")"
    else
        t_erro "$(t_msg snap_nao_e_pacote "$(basename -- "$ARQ")")"
    fi
    exit 1
fi

if ! command -v snap >/dev/null 2>&1; then
    t_erro "$(t_msg snap_falta_snapd "$NOME")"
    exit 1
fi

if snap list "$NOME" >/dev/null 2>&1; then
    t_ok "$(t_msg snap_ja_instalado "$NOME")"
    exit 0
fi

if ! t_pergunta "$(t_msg snap_pergunta "$NOME" "$(basename -- "$ARQ")")

$(t_msg snap_aviso_sem_assinatura)" "$(t_msg botao_instalar_assim_mesmo)" "$(t_msg botao_cancelar)"; then
    if [ -t 0 ]; then
        printf '%s' "$(t_msg snap_confirma_terminal)"
        read -r r
        if ! t_confirmou "$r"; then printf '%s\n' "$(t_msg cancelado)"; exit 0; fi
    else
        t_erro "$(t_msg snap_sem_confirmacao "$NOME")"
        exit 1
    fi
fi

ANTES_ATALHOS="$(t_atalhos_do_sistema)"
# THE WORDS OF THIS RUN, in a file only this run writes to. A marker fixes
# where a slice STARTS and cannot keep another Tandem's lines out of the
# middle - and the log is shared, one file per handler with no PID in the name.
# Measured with two double clicks a second apart: the program that printed
# nothing was reported as having said the OTHER program's words, and the
# silent-success guard was defeated at the same time. See t_saida_abre.
SAIDA="$(t_saida_abre snap)"
t_progresso_abre "$(t_msg snap_instalando "$NOME")"
t_como_root 'snap install --dangerous -- "$1"' "$ARQ" >>"$SAIDA" 2>&1
CODIGO=$?
t_saida_fecha "$SAIDA"
t_progresso_fecha

if [ "$CODIGO" -eq 127 ]; then
    t_erro "$(t_msg snap_sem_senha "$ARQ")"
    exit 1
fi

if snap list "$NOME" >/dev/null 2>&1; then
    t_memoria_grava "$ARQ" RESULTADO instalado 2>/dev/null
    t_memoria_grava "$ARQ" VISTO_EM "$(date +%F)" 2>/dev/null
    ONDE="$(t_anuncia_atalhos_do_sistema "$ANTES_ATALHOS")"
    t_ok "$(t_msg snap_instalado "$NOME")${ONDE:+

$(t_msg procure_no_menu_por)
$(printf '%s\n' "$ONDE" | sed 's/^/  /')}"
    exit 0
fi

PARCIAL="$SAIDA"
PORQUE=""
if grep -qi 'classic confinement' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg snap_porque_classic)"
elif grep -qi 'cannot install.*devmode\|snap is not compatible' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg snap_porque_devmode)"
elif grep -qi 'No space left on device' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg porque_disco_cheio)"
elif grep -qiE 'system does not fully support snapd|cannot communicate with server' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg snap_porque_servico)"
fi
ULTIMAS="$(t_palavras_do_programa "$PARCIAL" 3)"
rm -f "$PARCIAL"
t_memoria_grava "$ARQ" RESULTADO "nao instalou" 2>/dev/null
t_erro "$(t_msg snap_nao_instalou "$NOME")
${PORQUE:+
$PORQUE
}${ULTIMAS:+$([ -z "$PORQUE" ] && printf '\n%s\n\n%s\n' "$(t_msg sistema_disse)" "$ULTIMAS")}
$(t_msg registro_completo_em "$LOG")"
exit "$CODIGO"
