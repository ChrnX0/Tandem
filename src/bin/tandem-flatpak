#!/bin/bash
# Tandem - installs a .flatpakref or adds a .flatpakrepo.
#
# A .flatpakref is a four-line text file saying "this program lives over there".
# Double-clicked on a machine with no store installed, it does nothing - and the
# owner cannot tell that from a broken download, because both look the same:
# nothing happens.
#
# What makes this worth handling rather than refusing: unlike an .rpm, a flatpak
# DOES run on this system. The only thing missing is a program to read the
# pointer. That is a gap worth closing, not a limit worth explaining.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"

t_log_init flatpak "$*"

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "$(t_msg sem_arquivo)"; exit 1; }
ARQ="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$ARQ" ] && [ -f "$ARQ" ] || { t_erro "$(t_msg arquivo_sumiu "$BRUTO")"; exit 1; }

# Which of the two files this is. A .flatpakrepo adds a SOURCE and installs no
# program; treating them the same would promise the owner an application and
# hand him a repository.
EH_REPO=0
case "${ARQ,,}" in
    *.flatpakrepo) EH_REPO=1 ;;
    *) grep -qi '^\[Flatpak Repo\]' "$ARQ" 2>/dev/null && EH_REPO=1 ;;
esac

NOME="$(t_flatpak_campo "$ARQ" Name)"
TITULO="$(t_flatpak_campo "$ARQ" Title)"
URL="$(t_flatpak_campo "$ARQ" Url)"
RAMO="$(t_flatpak_campo "$ARQ" Branch)"
REPO_RUNTIME="$(t_flatpak_campo "$ARQ" RuntimeRepo)"
t_diz "flatpak ref: nome=$NOME titulo=$TITULO url=$URL ramo=$RAMO repo=$EH_REPO"

if [ -z "$NOME" ] && [ -z "$URL" ]; then
    t_erro "$(t_msg flatpak_ref_ruim)"
    exit 1
fi

AMIGAVEL="${TITULO:-${NOME:-$(t_msg este_programa)}}"

# ------------------------------------------------------- 1. Is flatpak here?
if ! command -v flatpak >/dev/null 2>&1; then
    if t_pergunta "$(t_msg flatpak_falta_pergunta "$AMIGAVEL")" \
       "$(t_msg botao_instalar)" "$(t_msg botao_agora_nao)"; then
        t_progresso_abre "$(t_msg flatpak_instalando_flatpak)"
        t_como_root "$(t_script_instalacao flatpak)" >>"$LOG" 2>&1
        t_progresso_fecha
    fi
    command -v flatpak >/dev/null 2>&1 || {
        t_erro "$(t_msg flatpak_falta_erro)"
        exit 1; }
    t_ok "$(t_msg flatpak_instalado_ok)"
fi

# ---------------------------------------------------------- 2. A repository
if [ "$EH_REPO" = 1 ]; then
    if ! t_pergunta "$(t_msg flatpak_e_uma_loja "${AMIGAVEL}${URL:+
$URL}")" "$(t_msg botao_adicionar_loja)" "$(t_msg botao_cancelar)"; then
        # This branch used to be a bare "exit 0", and with no graphical session
        # it produced exit code 0 and ZERO BYTES of output - the exact silent
        # failure this project treats as a defect. Found by running every new
        # handler with no window and no terminal and demanding a sentence.
        if [ -t 0 ]; then
            printf "$(t_msg flatpak_loja_terminal)" "$AMIGAVEL"
            read -r r
            case "$r" in s|S|sim|SIM) ;; *) echo "Cancelado."; exit 0 ;; esac
        else
            t_tem_gui || t_erro "$(t_msg flatpak_loja_sem_janela "$AMIGAVEL" "$ARQ")"
            exit 0
        fi
    fi
    t_progresso_abre "$(t_msg flatpak_adicionando_loja)"
    t_como_root "flatpak remote-add --if-not-exists --from '$ARQ'" >>"$LOG" 2>&1
    C=$?
    t_progresso_fecha
    if [ "$C" -eq 0 ]; then
        t_ok "$(t_msg flatpak_loja_adicionada)"
        exit 0
    fi
    t_erro "$(t_msg flatpak_loja_falhou)

$(t_msg registro_completo_em "$LOG")"
    exit "$C"
fi

# ------------------------------------------------------------ 3. A program
if [ -n "$NOME" ] && flatpak info "$NOME" >/dev/null 2>&1; then
    t_ok "$(t_msg flatpak_ja_instalado "$AMIGAVEL")"
    exit 0
fi

if ! t_pergunta "$(t_msg flatpak_instalar_pergunta "$AMIGAVEL" "${URL:+

$(t_msg flatpak_vem_de "$URL")}")" "$(t_msg botao_instalar)" "$(t_msg botao_cancelar)"; then
    if [ -t 0 ]; then
        printf "$(t_msg flatpak_instalar_terminal)" "$AMIGAVEL"
        read -r r
        case "$r" in s|S|sim|SIM) ;; *) echo "Cancelado."; exit 0 ;; esac
    else
        t_erro "$(t_msg flatpak_sem_confirmacao "$AMIGAVEL" "$ARQ")"
        exit 1
    fi
fi

# The runtime repository named inside the file has to exist first, or the install
# fails complaining about a runtime the owner has never heard of.
if [ -n "$REPO_RUNTIME" ]; then
    t_diz "garantindo o repositorio de runtime: $REPO_RUNTIME"
    flatpak remote-add --if-not-exists --user flathub "$REPO_RUNTIME" >>"$LOG" 2>&1 ||
        t_como_root "flatpak remote-add --if-not-exists flathub '$REPO_RUNTIME'" >>"$LOG" 2>&1
fi

MARCA=$(wc -l < "$LOG" 2>/dev/null || echo 0)
t_progresso_abre "$(t_msg flatpak_instalando "$AMIGAVEL")"
# Installed for this user, without a password. That is not a shortcut: a program
# installed system-wide asks for a password the owner may not have, and a
# per-user install is what he wanted anyway.
flatpak install --user --noninteractive --assumeyes --from "$ARQ" >>"$LOG" 2>&1
CODIGO=$?
t_progresso_fecha

if [ "$CODIGO" -ne 0 ] && [ -n "$NOME" ]; then
    t_diz "instalacao por usuario falhou ($CODIGO); tentando para o sistema"
    t_progresso_abre "$(t_msg flatpak_tentando_todos)"
    t_como_root "flatpak install --noninteractive --assumeyes --from '$ARQ'" >>"$LOG" 2>&1
    CODIGO=$?
    t_progresso_fecha
fi

if [ "$CODIGO" -eq 0 ] || { [ -n "$NOME" ] && flatpak info "$NOME" >/dev/null 2>&1; }; then
    t_memoria_grava "$ARQ" RESULTADO instalado 2>/dev/null
    t_ok "$(t_msg flatpak_instalado "$AMIGAVEL")"
    exit 0
fi

PARCIAL="$TANDEM_TRAVAS/parcial-flatpak.$$"
tail -n +"$((MARCA+1))" "$LOG" > "$PARCIAL" 2>/dev/null || : > "$PARCIAL"
PORQUE=""
if grep -qiE 'Could not resolve|Temporary failure|network is unreachable|Connection timed out' \
        "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg porque_sem_rede)"
elif grep -qi 'No space left on device' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg porque_disco_cheio)"
elif grep -qiE 'runtime.*not found|Unable to load summary|remote.*not found' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg flatpak_porque_loja_muda)"
elif grep -qiE 'no such ref|not available|Nothing matches' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg flatpak_porque_sumiu)"
fi
ULTIMAS="$(t_palavras_do_programa "$PARCIAL" 3)"
rm -f "$PARCIAL"
t_memoria_grava "$ARQ" RESULTADO "nao instalou" 2>/dev/null
t_erro "$(t_msg flatpak_nao_instalou "$AMIGAVEL")
${PORQUE:+
$PORQUE
}${ULTIMAS:+$([ -z "$PORQUE" ] && printf '\n%s\n\n%s\n' "$(t_msg flatpak_disse)" "$ULTIMAS")}
$(t_msg registro_completo_em "$LOG")"
exit "$CODIGO"
