#!/bin/bash
# Tandem - shows what a downloaded script is, before anything runs it.
#
# This is the one handler in the project whose default answer is NOT to run the
# file, and the reason is worth stating plainly: a shell script can do anything
# the owner can do, including deleting everything he has. Every other format
# here describes a program; this one describes instructions, and the instructions
# arrived from a stranger.
#
# So the split is by what the file actually is. A vendor installer - makeself,
# shar, a megabyte of payload behind a shell header - is meant to be run, and
# running it is what the double click was for; it gets the execute bit and a
# clear warning. A small plain script is far more likely something the owner
# wants to LOOK at, and offering to execute it first would be teaching a habit
# that gets machines broken. He is offered the text.
#
# What this replaces is not a good experience. On the machine this was written
# on, application/x-shellscript belonged to a text editor - which is a defensible
# default - and on a full desktop the double click produces a dialog offering to
# "Run in Terminal" with no indication of what the script does. Neither tells
# the owner anything he can use to decide.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"

t_log_init script "$*"

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "$(t_msg sem_arquivo)"; exit 1; }
SCRIPT="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$SCRIPT" ] && [ -f "$SCRIPT" ] || { t_erro "$(t_msg arquivo_sumiu "$BRUTO")"; exit 1; }

# A saved web page named .sh, before anything else. A broken install URL hands
# back a 404/login page, and this handler's whole job is to not run what it
# should not - so "this is a web page, not a script" is exactly the answer it
# owes. A real script starts with #! or shell; only an actual HTML file carries
# these markers in its first 512 bytes, so a legitimate installer is not caught.
if t_parece_pagina_web "$SCRIPT"; then
    t_erro "$(t_msg baixou_pagina_web "$(basename -- "$SCRIPT")")"; exit 1
fi

TAM="$(stat -c%s -- "$SCRIPT" 2>/dev/null || echo 0)"
t_diz "script: $SCRIPT ($TAM bytes)"

# The first lines, which is the only thing anybody can judge this by. Read as
# text and truncated hard: a self-extracting installer has a binary payload two
# lines down, and dumping it into a dialog would fill the screen with rubbish.
CABECA="$(head -c 4096 -- "$SCRIPT" 2>/dev/null | head -20 |
          tr -d '\000' | LC_ALL=C sed 's/[^[:print:][:space:]]/./g' | head -14)"

if t_script_instalador "$SCRIPT"; then
    # ------------------------------------------------ a vendor installer
    QUAL="$(t_msg script_qual_instalador)"
    ACAO="$(t_msg botao_instalar)"
    t_diz "recognised as an installer"
else
    QUAL="$(t_msg script_qual_script)"
    ACAO="$(t_msg botao_executar)"
    t_diz "recognised as an ordinary script"
    # For a plain script the first offer is to READ it. Whoever wanted to run it
    # says so on the second question, which is one click further away on purpose.
    if t_pergunta "$(t_texto_script_perigo "$SCRIPT")

$(t_msg script_ver_antes)" "$(t_msg botao_ver_conteudo)" "$(t_msg botao_nao_ver)"; then
        {
            printf '%s\n\n' "$(basename -- "$SCRIPT")"
            printf -- '----------------------------------------\n'
            head -c 65536 -- "$SCRIPT" | tr -d '\000' |
                LC_ALL=C sed 's/[^[:print:][:space:]]/./g'
        } | t_texto "$(t_msg janela_titulo_arquivo "$(basename -- "$SCRIPT")")"
    fi
fi

if ! t_pergunta "$QUAL

$(basename -- "$SCRIPT")   ($(t_tamanho_amigavel "$TAM"))

$(t_msg script_primeiras_linhas)
$CABECA

$(t_msg script_aviso_poder)" "$ACAO" "$(t_msg botao_cancelar)"; then
    if [ -t 0 ]; then
        printf '%s\n\n%s' "$QUAL" "$(t_msg script_confirma_terminal "$ACAO")"
        read -r r
        if ! t_confirmou "$r"; then printf '%s\n' "$(t_msg cancelado)"; exit 0; fi
    else
        # No window, no terminal, and this is the one file type where carrying on
        # without a confirmation is out of the question.
        t_erro "$(t_msg script_sem_confirmacao "$SCRIPT")"
        exit 1
    fi
fi

if [ ! -x "$SCRIPT" ]; then
    chmod +x -- "$SCRIPT" 2>>"$LOG" ||
        t_diz "could not mark as executable; trying via the interpreter"
fi

INICIO=$SECONDS
# THE WORDS OF THIS RUN, in a file only this run writes to. The marker that
# used to bound this slice fixes where it STARTS and cannot keep another
# Tandem's lines out of the middle - and the log is shared, one file per
# handler with no PID in the name. Measured with two double clicks a second
# apart: the program that printed nothing was reported as having said the
# OTHER program's words. See t_saida_abre in common.sh.
SAIDA="$(t_saida_abre script)"
t_aviso "$(t_msg script_executando "$(basename -- "$SCRIPT")")"
(
    cd -- "$(dirname -- "$SCRIPT")" || exit 1
    # Never as root. A vendor installer that needs root asks for it itself, with
    # its own explanation; handing it root because it happens to be a script
    # would be granting more than the owner agreed to.
    if [ -x "$SCRIPT" ]; then
        "$SCRIPT" >>"$SAIDA" 2>&1
    else
        # A folder mounted noexec, a read-only stick: the interpreter can still
        # read the file even when the kernel refuses to execute it.
        sh -- "$SCRIPT" >>"$SAIDA" 2>&1
    fi
)
CODIGO=$?
t_saida_fecha "$SAIDA"

if [ "$CODIGO" -eq 0 ]; then
    DUROU=$((SECONDS-INICIO))
    t_memoria_grava "$SCRIPT" RESULTADO executou 2>/dev/null
    t_memoria_grava "$SCRIPT" SEGUNDOS "$DUROU" 2>/dev/null
    t_memoria_grava "$SCRIPT" VISTO_EM "$(date +%F)" 2>/dev/null
    # The script's OWN words, which means the part of the log written after it
    # started. Passing the whole log put Tandem's internal lines - "reconhecido
    # como script comum", in Portuguese - on the screen under the heading "this
    # is what it said", and it also meant the guard below could never fire,
    # because a log with Tandem's own lines in it is never empty. The failure
    # path a few lines down had always sliced it correctly; the success path
    # never did. Found by running a script that does nothing and reading the
    # output, which is the only method that has ever caught this class of thing.
    SAIU="$(t_palavras_do_programa "$SAIDA" 6)"
    rm -f "$SAIDA"
    # "exit 0 stopped meaning it worked" is a rule this project applies
    # everywhere else, and a shell installer was the one place it did not: there
    # is no database to ask afterwards, so the exit code was the whole story.
    # There is still evidence available, and it is the same evidence the silent-
    # success guard uses for a program: an installer that finishes almost
    # instantly having printed nothing at all has not installed anything.
    #
    # Tandem cannot prove that either, which is why this is a warning that says
    # what was seen rather than a verdict. Congratulating the owner is the one
    # answer that is certainly wrong.
    if t_saida_suspeita "$DUROU" && [ -z "$SAIU" ]; then
        t_aviso "$(t_msg script_calado)"
        exit 0
    fi
    t_ok "$(t_msg script_ok)${SAIU:+

$(t_msg script_disse)

$SAIU}"
    exit 0
fi

PARCIAL="$SAIDA"
PORQUE=""
if grep -qiE 'Permission denied' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg script_porque_permissao)"
elif grep -qiE 'command not found' "$PARCIAL" 2>/dev/null; then
    FALTA="$(sed -n 's/.*: \([^:]*\): command not found.*/\1/p' "$PARCIAL" | head -3 |
             tr '\n' ' ')"
    PORQUE="$(t_msg script_porque_falta_programa "${FALTA:+ $FALTA}")"
elif grep -qi 'No space left on device' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg porque_disco_cheio)"
elif grep -qiE 'not found|No such file or directory' "$PARCIAL" 2>/dev/null; then
    PORQUE="$(t_msg script_porque_sem_arquivo)"
fi
ULTIMAS="$(t_palavras_do_programa "$PARCIAL" 4)"
rm -f "$PARCIAL"
t_memoria_grava "$SCRIPT" RESULTADO "nao executou" 2>/dev/null
t_erro "$(t_msg script_erro "$CODIGO")
${PORQUE:+
$PORQUE
}${ULTIMAS:+
$(t_msg script_disse)

$ULTIMAS
}
$(t_msg registro_completo_em "$LOG")"
exit "$CODIGO"
