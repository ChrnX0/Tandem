#!/bin/bash
# Tandem - main command and control panel.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"

# Every extension the nine handlers claim, for the panel's file chooser. Here
# rather than inside acao_painel because these are formats, not prose: a
# translator opening a catalogue should not be shown a list of globs to consider
# rewording, and the literal counter should not have to be told to ignore them.
TANDEM_GLOBS="*.exe *.msi *.apk *.xapk *.apks *.apkm *.AppImage *.appimage *.jar *.deb *.rpm *.flatpakref *.snap *.sh *.run"
t_log_init tandem "$*"
t_primeira_vez

# One source of truth: common.sh. This line still says VERSAO= so the coupled
# check in the suite can find it, and it reads the value rather than repeating it.
VERSAO="$TANDEM_VERSAO"

uso() {
    t_msg ajuda
    printf '
'
}

# ---------------------------------------------------------------- actions

acao_install() {
    local f="$1"
    [ -n "$f" ] || { t_erro "$(t_msg informe_arquivo)"; return 1; }
    # Before anything else: is the file there at all?
    #
    # It was not checked, and the consequence reached a real machine. The
    # routing below falls back to sniffing the contents with "head ...
    # 2>/dev/null" when the name says nothing, so a file that does not exist
    # fails every test in silence and lands on the last else - and the owner
    # was told "I did not recognise the type of this file" about a file that
    # was simply not there. Naming the wrong cause is worse than naming none:
    # they went looking for a defect in Tandem's format support while the real
    # answer was that they were in the wrong folder.
    #
    # And a word with no slash and no dot that matches nothing on disk is
    # almost never a file - it is a mistyped command, because the case at the
    # bottom of this script sends every unrecognised word here. Those two
    # mistakes wear the same shape and deserve opposite answers.
    if [ ! -e "$f" ]; then
        case "$f" in
            */*|*.*) t_erro "$(t_msg arquivo_sumiu "$f")" ;;
            *)       t_erro "$(t_msg comando_desconhecido "$f")" ;;
        esac
        return 1
    fi
    [ -d "$f" ] && { t_erro "$(t_msg e_uma_pasta "$f")"; return 1; }
    [ -r "$f" ] || { t_erro "$(t_msg sem_permissao_ler "$f")"; return 1; }
    case "${f,,}" in
        *.apk|*.xapk|*.apks|*.apkm) exec "$TANDEM_BIN"/tandem-apk "$f" ;;
        *.exe|*.msi|*.msp|*.lnk|*.bat|*.cmd|*.url) exec "$TANDEM_BIN"/tandem-exe "$f" ;;
        *.appimage) exec "$TANDEM_BIN"/tandem-appimage "$f" ;;
        *.jar)      exec "$TANDEM_BIN"/tandem-jar "$f" ;;
        *.deb|*.udeb) exec "$TANDEM_BIN"/tandem-deb "$f" ;;
        *.rpm)      exec "$TANDEM_BIN"/tandem-rpm "$f" ;;
        *.flatpakref|*.flatpakrepo) exec "$TANDEM_BIN"/tandem-flatpak "$f" ;;
        *.snap)     exec "$TANDEM_BIN"/tandem-snap "$f" ;;
        *.sh|*.run|*.bin) exec "$TANDEM_BIN"/tandem-script "$f" ;;
        *)
            # By content, when the name says nothing. The order matters, and it
            # is the specific mark before the generic one every time: an AppImage
            # is an ELF, a .jar is a zip, a .deb is an ar archive. A zip that is
            # not a jar is an Android package; an ELF that is not an AppImage is
            # an ordinary Linux program that needs nobody's help to run.
            if head -c2 -- "$f" 2>/dev/null | grep -q MZ; then
                exec "$TANDEM_BIN"/tandem-exe "$f"
            elif head -c8 -- "$f" 2>/dev/null | grep -q '<arch>'; then
                exec "$TANDEM_BIN"/tandem-deb "$f"
            elif head -c4 -- "$f" 2>/dev/null | od -An -tx1 2>/dev/null |
                 tr -d ' ' | grep -q '^edabeedb'; then
                exec "$TANDEM_BIN"/tandem-rpm "$f"
            elif t_appimage_info "$f" 2>/dev/null | grep -q '^TIPO='; then
                exec "$TANDEM_BIN"/tandem-appimage "$f"
            elif t_jar_info "$f" 2>/dev/null | grep -q '^PRINCIPAL=.'; then
                exec "$TANDEM_BIN"/tandem-jar "$f"
            elif grep -qi '^\[Flatpak Ref\]\|^\[Flatpak Repo\]' "$f" 2>/dev/null; then
                exec "$TANDEM_BIN"/tandem-flatpak "$f"
            elif head -c2 -- "$f" 2>/dev/null | grep -q PK; then
                exec "$TANDEM_BIN"/tandem-apk "$f"
            elif head -c2 -- "$f" 2>/dev/null | grep -q '#!'; then
                exec "$TANDEM_BIN"/tandem-script "$f"
            elif t_parece_pagina_web "$f"; then
                t_erro "$(t_msg baixou_pagina_web "$(basename -- "$f")")"; return 1
            else
                t_erro "$(t_msg tipo_desconhecido "$(basename -- "$f")")"; return 1
            fi ;;
    esac
}

acao_doctor() {
    local out="" ip sdk
    # The indentation stays HERE and not in the catalogue. A translator opening
    # a message should see a sentence, not two leading spaces they have to
    # preserve exactly - and a report whose columns depend on invisible
    # characters in a .po file is a report that will drift.
    out+="Tandem $VERSAO\n\n"
    out+="$(t_msg doc_sistema)\n"
    out+="  $( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}" )\n"
    out+="  $(t_msg doc_kernel "$(uname -r)" "${XDG_SESSION_TYPE:-?}")\n\n"

    out+="$(t_msg doc_prog_windows)\n"
    if command -v wine >/dev/null 2>&1; then
        out+="  $(t_msg doc_wine "$(wine --version 2>/dev/null)")\n"
        t_tem_wine64 && out+="  $(t_msg doc_bits64_sim)\n" ||
            out+="  $(t_msg doc_bits64_nao)\n"
        t_tem_wine32 && out+="  $(t_msg doc_bits32_sim)\n" ||
            out+="  $(t_msg doc_bits32_nao)\n"
        command -v winetricks >/dev/null 2>&1 &&
            out+="  $(t_msg doc_winetricks_sim)\n" ||
            out+="  $(t_msg doc_winetricks_nao)\n"
        [ -f "$TANDEM_PREFIXO_PADRAO/system.reg" ] &&
            out+="  $(t_msg doc_ambiente_pronto)\n" ||
            out+="  $(t_msg doc_ambiente_depois)\n"
    else
        out+="  $(t_msg doc_wine_nao)\n"
    fi
    out+="\n$(t_msg doc_apps_android)\n"
    if command -v waydroid >/dev/null 2>&1; then
        out+="  $(t_msg doc_waydroid_sim)\n"
        out+="  $(t_msg doc_servico "$(systemctl is-active waydroid-container 2>/dev/null)")\n"
        t_wd_sessao_ok && out+="  $(t_msg doc_sessao_ativa)\n" ||
            out+="  $(t_msg doc_sessao_parada)\n"
        if t_wd_pronto; then
            sdk="$(t_wd_sdk)"; ip="$(t_wd_ip)"
            out+="  $(t_msg doc_android_pronto "${sdk:-?}" "${ip:-?}")\n"
            t_wd_tem_arm && out+="  $(t_msg doc_arm_sim)\n" ||
                out+="  $(t_msg doc_arm_nao)\n"
        else
            out+="  $(t_msg doc_android_parado)\n"
        fi
        command -v adb >/dev/null 2>&1 &&
            out+="  $(t_msg doc_adb_sim)\n" || out+="  $(t_msg doc_adb_nao)\n"
        # Two checkable facts about THIS machine, in place of a paragraph of
        # folklore. The barrier to a USB device inside Android is not the
        # container - Waydroid denies no devices - it is that the Android image
        # does not declare android.hardware.usb.host, so nothing enumerates.
        if t_wd_usb_declarado; then
            out+="  $(t_msg doc_usb_declarado)\n"
        else
            out+="  $(t_msg doc_usb_nao)\n"
        fi
        if t_wd_uevent; then
            out+="  $(t_msg doc_uevent)\n"
        fi
    else
        out+="  $(t_msg doc_waydroid_nao)\n"
    fi
    out+="\n$(t_msg doc_pacotes_linux)\n"
    if command -v java >/dev/null 2>&1; then
        # The version line, not the first line: with JAVA_TOOL_OPTIONS set in
        # the environment - common on machines somebody has configured - Java
        # prints a paragraph of proxy settings first, and "head -1" put the
        # whole paragraph in the middle of the diagnosis.
        out+="  $(t_msg doc_java "$(t_java_versao 2>/dev/null || echo '?')" \
              "$(java -version 2>&1 | grep -m1 'version "' | sed 's/^ *//')")\n"
    else
        out+="  $(t_msg doc_java_nao)\n"
    fi
    t_tem_fuse2 &&
        out+="  $(t_msg doc_fuse_sim)\n" ||
        out+="  $(t_msg doc_fuse_nao)\n"
    out+="  $(t_msg doc_processador "$(t_maquina_arch)" "$(t_arch_sistema)")\n"
    local n_ai; n_ai="$(t_atalhos_appimage | grep -c . 2>/dev/null)"
    out+="  $(t_msg doc_appimage_menu "${n_ai:-0}")\n"
    command -v apt-get >/dev/null 2>&1 &&
        out+="  $(t_msg doc_deb_sim)\n" ||
        out+="  $(t_msg doc_deb_nao)\n"
    command -v flatpak >/dev/null 2>&1 &&
        out+="  $(t_msg doc_flatpak "$(flatpak --version 2>/dev/null)")\n" ||
        out+="  $(t_msg doc_flatpak_nao)\n"
    command -v snap >/dev/null 2>&1 &&
        out+="  $(t_msg doc_snap_sim)\n" || out+="  $(t_msg doc_snap_nao)\n"
    local arqs_estrangeiras
    arqs_estrangeiras="$(dpkg --print-foreign-architectures 2>/dev/null | tr '\n' ' ')"
    [ -n "$arqs_estrangeiras" ] &&
        out+="  $(t_msg doc_arqs_extras "$arqs_estrangeiras")\n"

    # The counter's hardware. Wine already reaches all of it and the two ways
    # it goes wrong - a number above COM4, and the dialout group - are silent,
    # so they belong in the diagnosis and not in a forum thread.
    out+="\n$(t_msg doc_aparelhos)\n"
    local n_ser n_par
    n_ser="$(t_portas_seriais | awk 'END { print NR + 0 }')"
    n_par="$(t_portas_paralelas | awk 'END { print NR + 0 }')"
    out+="  $(t_msg doc_portas "$n_ser" "$n_par")\n"
    t_no_grupo dialout &&
        out+="  $(t_msg doc_dialout_sim)\n" ||
        out+="  $(t_msg doc_dialout_nao)\n"
    if [ -f "$TANDEM_PREFIXO_PADRAO/system.reg" ]; then
        local id_serial
        id_serial="$(cat "$TANDEM_PREFIXO_PADRAO/drive_c/.windows-serial" 2>/dev/null)"
        [ -n "$id_serial" ] &&
            out+="  $(t_msg doc_id_presa)\n" ||
            out+="  $(t_msg doc_id_solta)\n"
    fi

    # Only shown when there is something to show. A shop with no hardware key
    # does not need a line about hardware keys in its diagnosis, and a
    # diagnosis nobody reads to the end diagnoses nothing.
    local fam
    for fam in sentinel codemeter; do
        case "$(t_chave_estado "$fam" | tr '\n' ' ')" in
            *SERVICO=sim*|*PORTA=sim*)
                out+="  $(t_msg doc_chave "$fam")\n" ;;
        esac
    done

    # Where Wine ends, a real Windows in a virtual machine begins - and it is
    # the only route to a kernel driver or a legacy dongle. Tandem does not
    # install one; it says whether this machine could carry one, because
    # "buy a Windows Pro licence" is bad advice on a machine whose BIOS has
    # virtualisation switched off.
    case "$(t_vm_possivel)" in
        sim*)      out+="  $(t_msg doc_vm_cabe)\n" ;;
        apertado*) out+="  $(t_msg doc_vm_apertado)\n" ;;
        bios*)     out+="  $(t_msg doc_vm_bios)\n" ;;
        *)         out+="  $(t_msg doc_vm_nao)\n" ;;
    esac

    out+="\n$(t_msg doc_perfis)\n"
    if [ -s "$TANDEM_PROTEGIDOS" ]; then
        while read -r l; do [ -n "$l" ] && out+="  $l\n"; done < "$TANDEM_PROTEGIDOS"
    else
        out+="  $(t_msg doc_perfis_nenhum)\n"
    fi

    # THE DIAGNOSTIC WAS SILENT ABOUT THE THING THAT DISABLES DIAGNOSIS.
    # Every verdict Tandem reaches about a program is read back out of its log,
    # so a notes folder that cannot be written turns "Visual C++ 2003 is
    # missing" into a bare exit code - and this report, which exists to say
    # what is wrong with the environment, said nothing at all. Byte-for-byte
    # the same report on a machine where it worked and one where it did not.
    # Last, because it is about Tandem rather than about the machine, and
    # unconditional in the sense that matters: it appears exactly when there is
    # something to say.
    SEM_ANOTA="$(t_aviso_sem_log)" && out+="\n$SEM_ANOTA\n"

    # %b (and not raw "$out") because the text has \n to expand but may
    # contain % coming from paths and versions, which would break the format.
    printf '%b' "$out" | t_texto "$(t_msg doctor_titulo)"
}

# ---------------------------------------------------------------- dados
#
# "If you give up on Linux, your data comes back with you." That sentence is
# what makes a shop owner willing to try - and up to version 3.4 Tandem had no
# way to keep it, because nothing here told the environment (rebuildable)
# apart from the files the person typed in (not).
acao_dados() {
    local sub="${1:-listar}"
    case "$sub" in
        salvar|save|copiar)   acao_dados_salvar "${2:-}" ;;
        restaurar|restore)    acao_dados_restaurar "${2:-}" ;;
        listar|lista|"")      acao_dados_listar ;;
        *) t_erro "$(t_msg dados_nao_conheco "$sub")"; return 1 ;;
    esac
}

acao_dados_listar() {
    local p="$TANDEM_PREFIXO_PADRAO" total linhas
    [ -d "$p/drive_c" ] || { t_erro "$(t_msg sem_ambiente_windows)"; return 1; }
    linhas="$(t_dados_lista "$p" 2>/dev/null)"
    total="$(printf '%s\n' "$linhas" | awk -F'\t' '{s += $3} END {print s + 0}')"
    if [ -z "$linhas" ]; then
        printf '%s\n' "$(t_msg dados_vazio)" | t_texto "$(t_msg dados_titulo)"
        return 0
    fi
    printf '%s\n' "$(t_msg dados_lista \
        "$(printf '%s\n' "$linhas" | sort -t"$(printf '\t')" -k3 -rn | head -40 |
           while IFS="$(printf '\t')" read -r _ caminho bytes; do
               printf -- '- %-52s %s\n' "$caminho" "$(t_tamanho_amigavel "$bytes")"
           done)" \
        "$(t_tamanho_amigavel "$total")" \
        "$(printf '%s\n' "$linhas" | grep -c .)")" | t_texto "$(t_msg dados_titulo)"
}

acao_dados_salvar() {
    local p="$TANDEM_PREFIXO_PADRAO" destino="${1:-}" total
    [ -d "$p/drive_c" ] || { t_erro "$(t_msg sem_ambiente_windows)"; return 1; }
    total="$(t_dados_total "$p")"
    if [ "${total:-0}" -eq 0 ]; then
        t_aviso "$(t_msg dados_nada_para_copiar)"
        return 0
    fi
    [ -n "$destino" ] || destino="$HOME/tandem-dados-$(date +%F-%H%M).tar.gz"
    t_progresso_abre "$(t_msg dados_copiando "$(t_tamanho_amigavel "$total")")"
    t_dados_salva "$p" "$destino"; local c=$?
    t_progresso_fecha
    if [ $c -eq 0 ]; then
        t_ok "$(t_msg dados_copiados "$destino")"
    else
        t_erro "$(t_msg dados_nao_copiou)"
    fi
    return $c
}

acao_dados_restaurar() {
    local p="$TANDEM_PREFIXO_PADRAO" arq="${1:-}"
    [ -n "$arq" ] || arq="$(ls -1t "$HOME"/tandem-dados-*.tar.gz 2>/dev/null | head -1)"
    [ -n "$arq" ] && [ -f "$arq" ] || {
        t_erro "$(t_msg dados_sem_copia)"; return 1; }
    [ -d "$p/drive_c" ] || { t_erro "$(t_msg dados_sem_ambiente_devolver)"; return 1; }
    # Giving data back DELETES nothing: a file that already exists stays as it
    # is. A restore that overwrites today's work with last week's copy is
    # exactly the damage this command exists to prevent.
    t_pergunta "$(t_msg dados_devolver_pergunta "$(basename -- "$arq")")" \
        "$(t_msg botao_devolver)" "$(t_msg botao_cancelar)" || return 1
    t_progresso_abre "$(t_msg dados_devolvendo)"
    tar -C "$p/drive_c" -xzf "$arq" --skip-old-files 2>>"$LOG"; local c=$?
    t_progresso_fecha
    [ $c -eq 0 ] && t_ok "$(t_msg dados_devolvidos)" || t_erro "$(t_msg dados_nao_devolveu)"
    return $c
}

acao_backup() {
    local p="$TANDEM_PREFIXO_PADRAO" pedido="${1:-}"
    [ -f "$p/system.reg" ] || { t_erro "$(t_msg bkp_sem_ambiente)"; return 1; }
    local dest
    # WHERE THE OWNER SAID. This used to discard the argument in silence and
    # write to $HOME, so somebody typing a pen-drive path got a file on the
    # machine he was trying to copy off. See t_destino_arquivo.
    dest="$(t_destino_arquivo "$pedido" "tandem-backup-$(date +%F-%H%M).tar.gz")" ||
        { t_erro "$(t_msg sem_essa_pasta "$(dirname -- "$pedido")")"; return 1; }
    t_progresso_abre "$(t_msg bkp_salvando)"
    tar -C "$(dirname -- "$p")" -czf "$dest" "$(basename -- "$p")" 2>>"$LOG"
    local c=$?
    t_progresso_fecha
    local so_dados; so_dados="$(t_dados_total "$p")"
    [ $c -eq 0 ] && t_ok "$(t_msg bkp_salvo "$dest" "$(t_tamanho_amigavel "${so_dados:-0}")")" || t_erro "$(t_msg bkp_nao_salvou)"
    return $c
}

acao_restore() {
    local arq="${1:-}"
    # A PATH, when the owner gives one. Without this the argument was thrown
    # away and the answer was "no backup found in your home folder" while he
    # was holding the file and pointing at it.
    if [ -n "$arq" ]; then
        [ -f "$arq" ] || { t_erro "$(t_msg arquivo_sumiu "$arq")"; return 1; }
    else
        arq="$(ls -1t "$HOME"/tandem-backup-*.tar.gz 2>/dev/null | head -1)"
        [ -n "$arq" ] || { t_erro "$(t_msg rst_nenhum_backup)"; return 1; }
    fi
    # BEFORE the rm -rf below, not after it. A truncated archive used to leave
    # the environment deleted and half rebuilt, and tar can say so first.
    t_backup_valido "$arq"
    case $? in
        2) t_erro "$(t_msg rst_nao_e_backup "$(basename -- "$arq")")"; return 1 ;;
        1) t_erro "$(t_msg rst_backup_danificado "$(basename -- "$arq")")"; return 1 ;;
    esac
    # A refusal with a window means the owner said no, and silence is right.
    # A refusal with NO window means nobody was asked - and this command
    # produced ZERO BYTES and exit 1 on a machine without a graphical session,
    # which is the shape every handler was audited for. The CLI commands were
    # not in that audit. Asking in the terminal is the first half of the fix:
    # answering "run this in the Terminal" TO somebody who is already in one
    # was the second attempt, and it was no better than the silence.
    t_pergunta_ou_terminal "$(t_msg rst_pergunta "$(basename -- "$arq")")" \
        "$(t_msg botao_restaurar)" "$(t_msg botao_cancelar)" \
        "$(t_msg rst_confirma_terminal)"
    case $? in
        1) return 1 ;;
        2) t_erro "$(t_msg rst_sem_janela "$arq")"; return 1 ;;
    esac
    # Before swapping the whole environment, save what cannot be remade.
    # Without this the command gave back last week's environment and took the
    # month's sales along with it - silently, and with no chance to undo.
    local resgate
    local c_resgate
    resgate="$(t_dados_resgate "$TANDEM_PREFIXO_PADRAO" antes-de-restaurar)"; c_resgate=$?
    case $c_resgate in
        0) t_aviso "$(t_msg rst_copia_guardada "$resgate")" ;;
        1) t_pergunta "$(t_texto_resgate_falhou)

$(t_msg rst_mesmo_assim)" "$(t_msg botao_restaurar_assim_mesmo)" "$(t_msg botao_parar)" || return 1 ;;
    esac
    t_progresso_abre "$(t_msg rst_restaurando)"
    rm -rf -- "$TANDEM_PREFIXO_PADRAO"
    mkdir -p "$(dirname -- "$TANDEM_PREFIXO_PADRAO")"
    tar -C "$(dirname -- "$TANDEM_PREFIXO_PADRAO")" -xzf "$arq" 2>>"$LOG"
    local c=$?
    t_progresso_fecha
    [ $c -eq 0 ] && t_ok "$(t_msg rst_restaurado)" || t_erro "$(t_msg rst_nao_restaurou)"
    return $c
}

acao_protect() {
    local p; p="$(readlink -f -- "${1:-}" 2>/dev/null)"
    [ -n "$p" ] && [ -d "$p" ] || { t_erro "$(t_msg prot_caminho_invalido)"; return 1; }
    t_protege "$p" || { t_erro "$(t_msg prot_nao_gravou)"; return 1; }
    t_ok "$(t_msg prot_protegido "$p")"
}

# ----------------------------------------------------------------- preparar
#
# "When you install Tandem it should also install Wine and Waydroid and
# everything it needs" - the user's request, and the honest technical answer:
# during the .deb installation that is impossible (dpkg's lock), but one
# command afterwards settles everything at once. And clicking a .exe with no
# Wine offers it too.
acao_preparar() {
    local faltas linha codigos=() descricoes=() plano="" script c

    faltas="$(t_pecas_faltando)"
    if [ -z "$faltas" ]; then
        t_ok "$(t_msg prep_nada_falta)"
        return 0
    fi

    while IFS='|' read -r c linha; do
        [ -n "$c" ] || continue
        codigos+=("$c"); descricoes+=("$linha")
        plano="$plano
• $linha"
    done <<< "$faltas"

    if ! t_pergunta "$(t_msg prep_pergunta "$plano")" "$(t_msg botao_instalar_tudo)" "$(t_msg botao_agora_nao)"; then
        if [ -t 0 ]; then
            # NOT `printf "$(t_msg ...)" "$plano"`, which handed a catalogue
            # message to printf as its FORMAT STRING - the one thing the {1}
            # decision exists to prevent. These files will arrive from
            # strangers, and a translator who writes "100% seguro" should not
            # be able to break a prompt; a path with a percent sign in it is
            # the other half, and this project already has a test with a folder
            # called "50% off".
            printf '%s' "$(t_msg prep_terminal "$plano")"
            read -r r
            # And t_confirmou, not `case s|S|sim|SIM`. That comparison was
            # copied into five HANDLERS and fixed in all five - and missed here,
            # because the CLI is not a handler. Same scoping shape as the
            # thirteenth miss of the literal counter. The screen prints [y/N] in
            # English and [o/N] in French, so an owner who does exactly what it
            # asks was told his install was cancelled.
            t_confirmou "$r" || { printf '%s\n' "$(t_msg cancelado)"; return 1; }
        else
            t_erro "$(t_msg prep_sem_confirmacao)"
            return 1
        fi
    fi

    script="$(t_script_instalacao "${codigos[@]}")"
    t_diz "preparar: instalando ${codigos[*]}"
    t_progresso_abre "$(t_msg prep_instalando)"
    t_como_root "$script" >>"$LOG" 2>&1
    c=$?
    t_progresso_fecha

    if [ "$c" -eq 127 ]; then
        t_erro "$(t_msg prep_sem_senha)"
        return 1
    fi
    if [ "$c" -ne 0 ]; then
        t_erro "$(t_msg prep_nao_terminou)"
        return 1
    fi
    # The install-time question, asked at the only moment where a dialog is
    # possible. It cannot be asked from the postinst: dpkg holds a lock while
    # that runs, and a window waiting for a click there would hang apt until
    # somebody noticed and clicked - the same reason "preparar" exists as a
    # separate command at all.
    #
    # Asked here without a concrete line to show, so it describes rather than
    # displays. If the owner skips it, the question comes back once with the
    # real line, the first time a program of his actually works.
    # Sending is ON by default, so this is not a question about whether to start:
    # it is the notice, with the button that stops it. Asking "may I?" about
    # something already running would be the dishonest version.
    if ! t_envio_decidido; then
        t_config_grava ENVIAR_AVISADO sim
        if t_pergunta "$(t_msg envio_aviso_ligado)" \
                       "$(t_msg botao_deixar_ligado)" "$(t_msg botao_desligar_envio)"; then
            t_diz "envio deixado ligado no preparar"
        else
            t_envio_define nao
            t_ok "$(t_msg envio_desligado_agora)"
        fi
    fi

    t_ok "$(t_msg prep_tudo_pronto)"
    return 0
}

# Picks one item from a list of names. Returns the chosen name.
# One column only, on purpose: the hidden-column options changed between
# zenity versions, and it is not worth depending on them.
escolher() {
    local titulo="$1" pergunta="$2"; shift 2
    if t_tem_gui && command -v zenity >/dev/null 2>&1; then
        zenity --list --title="$titulo" --text="$pergunta" \
               --width=520 --height=400 --column="$(t_msg col_programa)" "$@" 2>/dev/null
        return $?
    fi
    return 1
}

# ---------------------------------------------------------------- programas
#
# The system menu is not a reliable way back to the installed program: under
# Wayland, GNOME only re-reads the application list after you log out and log
# back in, and until then the installed program simply does not exist for the
# user. Tandem knows what it installed, so it shows and opens them itself.
acao_programas() {
    local filtro="${1:-}" d nome escolha achou="" nomes=()
    # Windows shortcuts and AppImage entries in the same list. For the owner
    # they are the same thing - a program he installed with Tandem - and the
    # reason this command exists applies to both: on Wayland, GNOME does not
    # re-read the application list, so a program he cannot find again is a
    # program he has not installed.
    local lista; lista="$(t_atalhos_nossos; t_atalhos_appimage)"
    lista="$(printf '%s\n' "$lista" | grep -v '^$')"
    if [ -z "$lista" ]; then
        t_erro "$(t_msg prog_nenhum)"
        return 1
    fi

    if [ -n "$filtro" ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            nome="$(t_nome_do_atalho "$d")"
            case "${nome,,}" in *"${filtro,,}"*) achou="$d"; break ;; esac
        done <<< "$lista"
        [ -n "$achou" ] || { t_erro "$(t_msg prog_nao_achei "$filtro")"; return 1; }
        setsid gio launch "$achou" >/dev/null 2>&1 &
        t_ok "$(t_msg abrindo "$(t_nome_do_atalho "$achou")")"
        return 0
    fi

    while IFS= read -r d; do
        [ -n "$d" ] || continue
        nomes+=("$(t_nome_do_atalho "$d")")
    done <<< "$lista"

    # With no window (terminal, SSH), the list comes out as text. "escolher"
    # returns empty both on Cancel and when zenity is missing; in the first
    # case the listing is harmless, in the second it is the only path left.
    escolha="$(escolher "$(t_msg prog_titulo_janela)" \
                        "$(t_msg prog_qual_abrir)" "${nomes[@]}")"
    if [ -z "$escolha" ]; then
        printf '%s\n\n' "$(t_msg prog_instalados_titulo)"
        printf '  %s\n' "${nomes[@]}"
        printf '\n%s\n' "$(t_msg prog_para_abrir)"
        return 0
    fi
    acao_programas "$escolha"
}

# ------------------------------------------------------------- desinstalar
#
# The target user does not know how to use Wine, and has no reason to. Without
# this the only path was "WINEPREFIX=... wine uninstaller", which is exactly
# the kind of thing this project exists so as not to demand of anyone.
acao_uninstall() {
    local filtro="${1:-}" pref="$TANDEM_PREFIXO_PADRAO" lista linha nome
    local escolha achou="" nomes=() silencioso normal

    [ -f "$pref/system.reg" ] || {
        t_erro "$(t_msg desinst_nenhum_ainda)"; return 1; }

    # Uninstalling changes the prefix, so it only holds for ours. A
    # third-party prefix - the point-of-sale system's, for example - is
    # untouchable.
    export WINEPREFIX="$pref"
    lista="$(t_uninstall_dump "$pref")"
    if [ -z "$lista" ]; then
        t_erro "$(t_msg desinst_nenhum_para_remover)"
        return 1
    fi

    while IFS= read -r linha; do
        [ -n "$linha" ] || continue
        nome="${linha#*|||}"; nomes+=("${nome%%|||*}")
    done <<< "$lista"

    if [ -z "$filtro" ]; then
        escolha="$(escolher "$(t_msg des_titulo_janela)" \
                            "$(t_msg des_qual_remover)" "${nomes[@]}")"
        if [ -z "$escolha" ]; then
            printf '%s\n\n' "$(t_msg desinst_podem_ser_removidos)"
            printf '  %s\n' "${nomes[@]}"
            printf '\n%s\n' "$(t_msg desinst_para_remover)"
            return 0
        fi
        filtro="$escolha"
    fi

    while IFS= read -r linha; do
        [ -n "$linha" ] || continue
        nome="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $2}')"
        case "${nome,,}" in
            *"${filtro,,}"*)
                achou="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $1}')"
                silencioso="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $3}')"
                normal="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $4}')"
                break ;;
        esac
    done <<< "$lista"
    [ -n "$achou" ] || { t_erro "$(t_msg prog_nao_achei "$filtro")"; return 1; }
    command -v wine >/dev/null 2>&1 || { t_erro "$(t_msg wine_nao_instalado)"; return 1; }

    # Confirmation: a window; failing that, the terminal; with neither, it
    # refuses SAYING why - removing a program with nobody confirming is a
    # risk, and giving up silently is a defect.
    if ! t_pergunta "$(t_msg desinst_pergunta "$nome")" "$(t_msg botao_remover)" "$(t_msg botao_cancelar)"; then
        if [ -t 0 ]; then
            printf '%s' "$(t_msg desinst_terminal "$nome")"
            read -r r
            t_confirmou "$r" || { printf '%s\n' "$(t_msg cancelado)"; return 1; }
        else
            t_erro "$(t_msg desinst_sem_confirmacao "$nome")"
            return 1
        fi
    fi

    # The program's uninstaller wipes its whole folder - and in Brazilian
    # commercial software the database usually lives right in there, next to
    # the executable. The owner confirmed removing the PROGRAM; nobody asked
    # whether he wanted to lose the records. The copy is made first, always.
    local resgate
    local c_resgate
    resgate="$(t_dados_resgate "$TANDEM_PREFIXO_PADRAO" antes-de-remover)"; c_resgate=$?
    case $c_resgate in
        0) t_aviso "$(t_msg desinst_copia_guardada "$resgate")" ;;
        1) t_pergunta "$(t_texto_resgate_falhou)

$(t_msg desinst_remover_mesmo_assim)" "$(t_msg botao_remover_assim)" "$(t_msg botao_parar)" || return 1 ;;
    esac

    # We prefer the silent uninstaller, which the program itself declares in
    # the registry. Without it, we run the normal uninstaller: it opens the
    # program's own window and the user confirms there - honest, even if in
    # English.
    local c
    if [ -n "$silencioso" ]; then
        t_progresso_abre "$(t_msg desinst_removendo "$nome")"
        t_diz ">>> $silencioso"
        t_executa_comando_windows "$silencioso" >>"$LOG" 2>&1
        c=$?
        wineserver -w 2>/dev/null
        t_progresso_fecha
    else
        t_aviso "$(t_msg desinst_janela_propria "$nome")"
        t_diz ">>> $normal"
        t_executa_comando_windows "$normal" >>"$LOG" 2>&1
        c=$?
        wineserver -w 2>/dev/null
    fi

    local orfaos; orfaos="$(t_limpa_atalhos_orfaos)"
    t_diz "desinstalar $nome: codigo $c, $orfaos atalho(s) orfao(s) removido(s)"

    # The acid test is the registry: did the key disappear?
    if t_uninstall_dump "$pref" | grep -qF -- "$achou|||"; then
        t_erro "$(t_msg desinst_nao_removeu "$nome")"
        return 1
    fi
    t_ok "$(t_msg desinst_removido "$nome")"
    return 0
}

# ------------------------------------------------------------- alternativas
#
# The owner asks; Tandem answers with what it knows, and says plainly when it
# does not know. It never swaps anything, never insists, and never suggests
# replacing a program that is working.
acao_alternativas() {
    local nome="${1:-}" texto
    if [ -z "$nome" ]; then
        t_erro "$(t_msg alt_diga_o_nome)"
        return 1
    fi
    # Accepts both "photoshop" and the path to a .exe.
    [ -f "$nome" ] && nome="$(basename -- "${nome%.*}")"

    if texto="$(t_texto_alternativas "$nome")"; then
        printf '%s\n%s\n' "$(t_msg alt_cabecalho "$nome")" "$texto" |
            t_texto "$(t_msg alt_titulo "$nome")"
        return 0
    fi

    t_erro "$(t_msg alt_nao_conheco "$nome")"
    return 1
}

# -------------------------------------------------------------- autoteste
#
# The "doctor" LISTS: it says zenity is installed, that the locale exists,
# that Wine answers. That is weak evidence - it proves the part is there, not
# that it works.
#
# Five defects found in the field were invisible to a listing and visible to
# an exercise:
#   - zenity installed, but refusing every accented text (missing locale)
#   - the progress pipe existing, but killing the process when written to
#   - the lock configured, but impossible to create
#   - the doctor working in the terminal, but writing zero bytes to a file
#   - the error being "shown" in a window that never opened
#
# The self-test EXERCISES. Each check runs the real thing and looks at the
# result. Where the exercise is not possible without the owner watching, it
# asks.
acao_autoteste() {
    local ok=0 falhou=0 saida="" tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf -- "$tmp"' RETURN

    passa() { ok=$((ok+1));     saida="$saida  $(t_msg auto_passa)   $1"$'\n'; }
    falha() { falhou=$((falhou+1)); saida="$saida  $(t_msg auto_falha)   $1"$'\n         '"$2"$'\n'; }

    # 1. Does the error message reach SOMEWHERE? Without this, all the rest of
    #    the diagnosis is useless: the owner would never learn of the problem.
    #
    #    WITH THE DESKTOP HALF DELIBERATELY SWITCHED OFF, and that is the whole
    #    point of the subshell. This probe called t_erro for real, and t_erro on
    #    a graphical machine fires a CRITICAL desktop notification - so running
    #    the self-test popped a red alarm reading "self-test: ignore this
    #    message", and `tandem socorro`, which embeds the self-test, popped it
    #    at somebody who is already in trouble and reading carefully. Found in
    #    a real log from the owner's machine, not here.
    #
    #    The old form was `[ -n "$(t_erro ...)" ] || t_tem_gui`, and the shape
    #    of the mistake is worth keeping: bash evaluates the left side FIRST, so
    #    the alarm fired on exactly the machines where `|| t_tem_gui` then made
    #    the result independent of it. It frightened the owner to learn nothing.
    #
    #    Unsetting the display exercises MORE than the old version, not less:
    #    the message-building path is now checked on every machine instead of
    #    being short-circuited away on the graphical ones. What it stops
    #    claiming is that notify-send works - which the old code never checked
    #    either, since it ignored notify-send's result.
    if [ -n "$( unset DISPLAY WAYLAND_DISPLAY
                t_erro "$(t_msg auto_ignore)" 2>&1 1>/dev/null )" ]; then
        passa "$(t_msg at_erro_ok)"
    else
        falha "$(t_msg at_erro_nao)" "$(t_msg at_erro_porque)"
    fi

    # 2. Does accented text survive? This is the defect that wiped out the
    #    whole interface on a real machine, and no listing would catch it.
    if [ "$(locale charmap 2>/dev/null)" = "UTF-8" ]; then
        passa "$(t_msg at_acento_ok)"
    else
        falha "$(t_msg at_acento_nao)" "$(t_msg at_acento_porque)"
    fi

    # 3. Can the diagnosis be written to a file? If not, the owner has no way
    #    to send it to anyone.
    if ( "$0" version > "$tmp/redir.txt" 2>/dev/null ) && [ -s "$tmp/redir.txt" ]; then
        passa "$(t_msg at_diag_ok)"
    else
        falha "$(t_msg at_diag_nao)" "$(t_msg at_diag_porque)"
    fi

    # 4. Can the double-click lock be created? If not, the double click stops
    #    working - and silently, which is what happened.
    if ( exec 7> "$TANDEM_TRAVAS/autoteste.lock" ) 2>/dev/null &&
       rm -f "$TANDEM_TRAVAS/autoteste.lock" 2>/dev/null; then
        passa "$(t_msg at_trava_ok "$TANDEM_TRAVAS")"
    else
        falha "$(t_msg at_trava_nao)" "$(t_msg at_trava_porque "$TANDEM_TRAVAS")"
    fi

    # 5. Does the progress bar survive the window vanishing? Really exercised:
    #    open it, kill the reader, write. This used to kill Tandem with 141.
    if t_tem_gui && command -v zenity >/dev/null 2>&1; then
        ( t_progresso_abre "$(t_msg auto_progresso_titulo)"; kill "${TANDEM_PROG_PID:-0}" 2>/dev/null
          sleep 0.3; t_progresso_texto "$(t_msg auto_depois_de_fechada)"; t_progresso_fecha ) >/dev/null 2>&1
        if [ $? -lt 128 ]; then
            passa "$(t_msg at_progresso_ok)"
        else
            falha "$(t_msg at_progresso_nao)" "$(t_msg at_progresso_porque)"
        fi
    else
        saida="$saida  --      $(t_msg auto_pulou_progresso)"$'\n'
    fi

    # 6. Does the PE reader work on this machine? Exercised against a real
    #    Windows binary, if there is one at hand in the prefix.
    local umexe
    umexe="$(find "$TANDEM_PREFIXO_PADRAO/drive_c" -name '*.exe' -size -20M 2>/dev/null | head -1)"
    if [ -n "$umexe" ]; then
        if [ -n "$(python3 "$TANDEM_LIB/peinfo.py" "$umexe" 2>/dev/null | sed -n 's/^ARQUITETURA=//p')" ]; then
            passa "$(t_msg at_pevoo_ok)"
        else
            falha "$(t_msg at_pevoo_nao)" "$umexe"
        fi
    else
        saida="$saida  --      $(t_msg auto_pulou_pe)"$'\n'
    fi

    # 7. Do the associations point at Tandem? That is what makes the double
    #    click arrive here; without it the rest does not matter.
    if command -v xdg-mime >/dev/null 2>&1; then
        local dono par
        # One line per format, because they are disputed by different rivals:
        # Zorin's "Windows App Support" wants the .exe, Waydroid wants the .apk,
        # the system's own Java launcher wants the .jar, and an AppImage usually
        # has no owner at all - which is precisely why it does nothing when
        # clicked.
        for par in "application/x-ms-dos-executable|.exe|tandem-exe.desktop" \
                   "application/vnd.android.package-archive|.apk|tandem-apk.desktop" \
                   "application/vnd.appimage|.AppImage|tandem-appimage.desktop" \
                   "application/java-archive|.jar|tandem-jar.desktop" \
                   "application/vnd.debian.binary-package|.deb|tandem-deb.desktop" \
                   "application/x-rpm|.rpm|tandem-rpm.desktop" \
                   "application/vnd.flatpak.ref|.flatpakref|tandem-flatpak.desktop" \
                   "application/vnd.snap|.snap|tandem-snap.desktop"; do
            dono="$(xdg-mime query default "${par%%|*}" 2>/dev/null)"
            if [ "$dono" = "${par##*|}" ]; then
                passa "$(t_msg at_clique_ok "$(printf '%s' "$par" | cut -d'|' -f2)")"
            else
                falha "$(t_msg at_clique_nao "$(printf '%s' "$par" | cut -d'|' -f2)")" \
                      "$(t_msg at_clique_porque "${dono:-?}")"
            fi
        done
    fi

    # 8. Does the AppImage reader work on this machine? Exercised against a
    #    header written here and now, so it needs no file and no network: the
    #    twenty bytes that decide everything are the ones being read.
    {
        printf '\177ELF\002\001\001\000AI\002\000\000\000\000\000\003\000>\000'
        head -c 44 /dev/zero
    } > "$tmp/falso.AppImage" 2>/dev/null
    local lido; lido="$(t_appimage_info "$tmp/falso.AppImage" 2>/dev/null)"
    if [ "$(t_campo "$lido" TIPO)" = 2 ] &&
       [ "$(t_campo "$lido" ARQUITETURA)" = x86_64 ]; then
        passa "$(t_msg at_appimage_ok)"
    else
        falha "$(t_msg at_appimage_nao)" "$(t_msg at_python_porque "${lido:-?}")"
    fi

    # 9. Does the jar reader work? Against a real .jar, if this machine has one
    #    - the Java packages of the distribution all ship them.
    local umjar
    umjar="$(find "$TANDEM_PREFIXO_PADRAO" /usr/share/java /usr/lib/jvm \
                  "$HOME/Downloads" -maxdepth 4 -name '*.jar' -size -50M \
                  2>/dev/null | head -1)"
    if [ -n "$umjar" ]; then
        if [ -n "$(t_campo "$(t_jar_info "$umjar")" MAIOR)" ]; then
            passa "$(t_msg at_java_ok)"
        else
            falha "$(t_msg at_java_nao)" "$umjar"
        fi
    else
        saida="$saida  --      $(t_msg auto_pulou_java)"$'\n'
    fi

    # 10. The .deb reader, on a package written here and now. Every current
    #     Ubuntu package uses control.tar.zst, which Python cannot read on its
    #     own - it goes through libzstd by hand - so this is the check that would
    #     notice a machine where that route is unavailable.
    if [ -f "$TANDEM_LIB/../../tests/mkdeb.py" ] || command -v dpkg-deb >/dev/null 2>&1; then
        local umdeb
        umdeb="$(find /var/cache/apt/archives "$HOME/Downloads" -maxdepth 1 \
                      -name '*.deb' -size -80M 2>/dev/null | head -1)"
        if [ -n "$umdeb" ]; then
            local lido_deb; lido_deb="$(t_deb_info "$umdeb")"
            if [ -n "$(t_campo "$lido_deb" PACOTE)" ]; then
                passa "$(t_msg at_deb_ok "$(t_campo "$lido_deb" PACOTE)")"
            else
                falha "$(t_msg at_deb_nao)" \
                      "$umdeb: $(t_erro_do_leitor "$(t_campo "$lido_deb" ERRO)")"
            fi
        else
            saida="$saida  --      $(t_msg auto_pulou_deb)"$'\n'
        fi
    fi

    # 11. Can apt answer WITHOUT root? The whole .deb diagnosis rests on it:
    #     if this fails, the owner gets asked for a password only to be told no.
    if command -v apt-get >/dev/null 2>&1; then
        if t_apt_simula /bin/true 2>&1 | grep -qiE 'Reading package lists|E: |Unable'; then
            passa "$(t_msg at_apt_ok)"
        else
            falha "$(t_msg at_apt_nao)" "$(t_msg at_apt_porque)"
        fi
    fi

    # 12. Java is not required for Tandem to work, but if it IS here its version
    #     has to be readable - the whole "needs a newer Java" diagnosis hangs on
    #     that one number, and Java writes it two different ways.
    if command -v java >/dev/null 2>&1; then
        local jv; jv="$(t_java_versao)"
        case "$jv" in
            ''|*[!0-9]*) falha "$(t_msg at_javaver_nao)" "$(t_msg at_javaver_porque "$(java -version 2>&1 | head -1)")" ;;
            *)           passa "$(t_msg at_javaver_ok "$jv")" ;;
        esac
    else
        saida="$saida  --      $(t_msg auto_pulou_java_versao)"$'\n'
    fi

    # 13. Is the protection of other people's prefixes in force? It exercises
    #    the decision, not the list: it asks the code what it would do.
    local alheio protegidos=0 desprotegidos=""
    while IFS= read -r alheio; do
        [ -n "$alheio" ] || continue
        if t_prefixo_protegido "$alheio"; then protegidos=$((protegidos+1))
        else desprotegidos="$desprotegidos $alheio"; fi
    done <<< "$(t_atalhos_wine >/dev/null 2>&1; grep -v '^$' "$TANDEM_PROTEGIDOS" 2>/dev/null)"
    if [ -n "$desprotegidos" ]; then
        falha "$(t_msg at_protegido_nao)" "$desprotegidos"
    elif [ "$protegidos" -gt 0 ]; then
        passa "$(t_msg_n at_protegido_ok "$protegidos" "$protegidos")"
    else
        saida="$saida  --      $(t_msg auto_pulou_protecao)"$'\n'
    fi

    printf '%s\n\n%s\n%s\n%s\n' \
        "$(t_msg auto_cabecalho "$VERSAO")" "$saida" \
        "$(t_msg auto_resumo "$ok" "$falhou")" \
        "$([ "$falhou" -gt 0 ] && printf '%s' "$(t_msg auto_falha_importa)" \
                                || printf '%s' "$(t_msg auto_tudo_respondeu)")" |
        t_texto "$(t_msg auto_titulo)"
    [ "$falhou" -eq 0 ]
}

# -------------------------------------------------------------- receitas
#
# Collective knowledge with no server: a program's memory becomes a text file
# that the owner sends to another person. Pull only, never push - Tandem reads
# recipes and never sends anything anywhere.
acao_receita() {
    if [ "${1:-}" = "--importar" ]; then
        local rec="${2:-}" prog="${3:-}"
        [ -n "$rec" ] && [ -n "$prog" ] || {
            t_erro "$(t_msg rec_uso_importar)"; return 1; }
        [ -f "$prog" ] || { t_erro "$(t_msg nao_achei_o_programa "$prog")"; return 1; }
        t_receita_importa "$rec" "$prog"
        case $? in
            0) t_ok "$(t_msg rec_aplicada)"
               return 0 ;;
            2) t_erro "$(t_msg rec_nao_e_receita)" ;;
            3) t_erro "$(t_msg rec_outro_programa)" ;;
            4) t_erro "$(t_msg rec_suspeita)" ;;
            *) t_erro "$(t_msg rec_nao_consegui_ler)" ;;
        esac
        return 1
    fi

    local prog="${1:-}"
    [ -n "$prog" ] || { t_erro "$(t_msg rec_diga_qual_programa)"; return 1; }
    [ -f "$prog" ] || { t_erro "$(t_msg nao_achei_o_programa "$prog")"; return 1; }
    # Warn BEFOREHAND, on the error output, so as not to dirty the recipe that
    # goes out on stdout and is usually redirected into a file.
    case "$(t_confianca_da_licao "$prog")" in
        reprovado)
            t_aviso "$(t_msg rec_marcada_reprovado)" ;;
        entregue)
            t_aviso "$(t_msg rec_entregue)" ;;
        so-abriu)
            t_aviso "$(t_msg rec_so_abriu)" ;;
    esac
    if ! t_receita_exporta "$prog"; then
        t_erro "$(t_msg rec_nada_aprendido)"
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------ memoria
#
# What Tandem has learned, in text the owner can read. There is no secret
# memory: if he cannot SEE what was stored, he has no way to trust it and no
# way to correct it.
acao_memoria() {
    local filtro="${1:-}" arq prog res lim saida="" n=0
    if [ ! -d "$TANDEM_MEMORIA" ] || [ -z "$(ls -A "$TANDEM_MEMORIA" 2>/dev/null)" ]; then
        t_erro "$(t_msg mem_nada_aprendido)"
        return 1
    fi
    for arq in "$TANDEM_MEMORIA"/*.txt; do
        [ -f "$arq" ] || continue
        prog="$(sed -n 's/^PROGRAMA=//p' "$arq" | head -1)"
        [ -n "$filtro" ] && case "${prog,,}" in *"${filtro,,}"*) ;; *) continue ;; esac
        n=$((n+1))
        saida="$saida$prog"$'\n'
        # The field NAMES are translated, and so is the RESULTADO value now -
        # but at DISPLAY time, by t_resultado_amigavel, with the value on disk
        # left exactly as written. The old comment here said the values are
        # on-disk format and stopped there, and that half-truth is what kept
        # forty-four Portuguese sentences on this screen in every language:
        # "nao confirmou", "pasta sem permissao", "bitola errada". This is the
        # screen a shop owner opens to find out what happened, and the same
        # text goes into the tandem socorro report he sends to whoever helps.
        # THE OWNER'S ANSWER COMES FIRST, because it outranks everything below
        # it. Until now this screen did not show it AT ALL - `grep CONFIRMADO
        # src/bin/tandem` returned nothing - while faithfully printing
        # RESULTADO=abriu, which the exit code sets and the "no" branch of
        # t_confirma_funcionou deliberately leaves alone. So the one program he
        # had told Tandem was broken was reported back to him as "Result: it
        # opened", and `tandem socorro` embeds this screen verbatim - meaning
        # the report he sends to whoever is helping him ASSERTS the program
        # works.
        #
        # RESULTADO stays on the screen underneath rather than being
        # overwritten: "it launched and he says it does not work" is a more
        # useful pair of facts than either one alone, and it is the shape of
        # the case somebody helping him needs to see.
        res="$(sed -n 's/^CONFIRMADO=//p' "$arq" | tail -1)"
        case "$res" in
            sim) saida="$saida  $(t_msg mem_campo_confirmado)$(t_msg mem_dono_disse_sim)"$'\n' ;;
            nao) saida="$saida  $(t_msg mem_campo_confirmado)$(t_msg mem_dono_disse_nao)"$'\n' ;;
        esac
        res="$(sed -n 's/^RESULTADO=//p' "$arq" | tail -1)"
        [ -n "$res" ] && saida="$saida  $(t_msg mem_campo_resultado)$(t_resultado_amigavel "$res")"$'\n'
        # PROVA is what TANDEM checked, as opposed to what the owner said, and
        # it is on this screen for the reason at the top of this function: a
        # memory he cannot see is a memory he cannot correct. It is also the
        # field that explains an otherwise baffling pair - two runs of the same
        # program, both unanswered, one of which contributes to the list and one
        # of which does not.
        res="$(sed -n 's/^PROVA=//p' "$arq" | tail -1)"
        [ -n "$res" ] && saida="$saida  $(t_msg mem_campo_prova)$(t_resultado_amigavel "$res")"$'\n'
        saida="$saida$(sed -n "
            s/^ARQUITETURA=/  $(t_msg mem_campo_arquitetura)/p
            s/^RESOLVERAM=/  $(t_msg mem_campo_resolveram)/p
            s/^NAO_RESOLVERAM=/  $(t_msg mem_campo_nao_resolveram)/p
            s/^SEGUNDOS=/  $(t_msg mem_campo_segundos)/p
            s/^VISTO_EM=/  $(t_msg mem_campo_visto_em)/p" "$arq")"$'\n'
        # LIMITE is the ONLY field here that is neither a single word nor a
        # plain sentence, and it was printed by the sed map above like all the
        # rest. Found in the field, on a real .deb built for arm64, and it
        # reached the owner exactly like this:
        #
        #   limite:  arquitetura|Este pacote foi feito para outro tipo de
        #   processador.\n\nEle e para arm64 e este computador e amd64.\n\n...
        #
        # Two leaks in one line. The "arquitetura|" is the internal separator
        # that carries the CLASS of the limit - on-disk format, of the kind
        # t_resultado_amigavel exists to keep off the screen. And the \n are
        # literal backslash-n because t_memoria_grava escapes newlines on write
        # so a value stays on one line, and t_memoria_le undoes that with
        # printf '%b' on read - which the sed map above bypasses entirely.
        #
        # So the rule this project already had was right and this one field
        # walked around it: read it the way the library reads it, drop the
        # class, and indent the continuation lines so the block still reads as
        # one field.
        lim="$(sed -n 's/^LIMITE=//p' "$arq" | tail -1)"
        if [ -n "$lim" ]; then
            lim="$(printf '%b' "${lim//%/%%}")"
            lim="${lim#*|}"
            saida="$saida  $(t_msg mem_campo_limite)$(printf '%s' "$lim" |
                   sed "2,\${/./s/^/              /}")"$'\n'
        fi
        saida="$saida"$'\n'
    done
    [ "$n" -gt 0 ] || { t_erro "$(t_msg mem_nao_achei "$filtro")"; return 1; }
    printf '%s' "$saida" | t_texto "$(t_msg mem_titulo)"
}

acao_esquecer() {
    local filtro="${1:-}" arq prog n=0
    [ -n "$filtro" ] || { t_erro "$(t_msg esq_diga_o_nome)"; return 1; }
    # The ledger of what has left this machine is the owner's to erase, and
    # that is not a courtesy: section 3 of the idea ledger rejected telemetry
    # on the rule "nothing the owner cannot see and cannot delete", and a
    # record kept for his benefit that he cannot remove is a record kept
    # against him. Erasing it changes nothing at the far end - what is sent is
    # sent - and it says so.
    if [ "$filtro" = enviados ]; then
        if [ -f "$TANDEM_FILA.enviados" ]; then
            n="$(t_envio_ja_enviados)"
            rm -f -- "$TANDEM_FILA.enviados"
            t_ok "$(t_msg_n esq_enviados_apagado "$n" "$n")"
            return 0
        fi
        t_erro "$(t_msg esq_enviados_vazio)"
        return 1
    fi
    for arq in "$TANDEM_MEMORIA"/*.txt; do
        [ -f "$arq" ] || continue
        prog="$(sed -n 's/^PROGRAMA=//p' "$arq" | head -1)"
        case "${prog,,}" in *"${filtro,,}"*) rm -f -- "$arq"; n=$((n+1)) ;; esac
    done
    [ "$n" -gt 0 ] || { t_erro "$(t_msg mem_nao_achei "$filtro")"; return 1; }
    t_ok "$(t_msg_n esq_esqueci "$n" "$n")"
}

# ------------------------------------------------------ identity and ports
#
# Both are pure diagnosis: they read /sys, /proc and system.reg, start no
# Wine, ask for no password and change nothing unless asked to in so many
# words. They exist because the two questions they answer - "which of my
# machine's numbers did the program see?" and "which COM did my pinpad get?" -
# had no answer at all before, and the owner met them as "activate again" and
# "the printer is not there".
acao_identidade() {
    t_texto_identidade "$TANDEM_PREFIXO_PADRAO" | t_texto "$(t_msg id_titulo_janela)"
}

acao_portas() {
    local p="$TANDEM_PREFIXO_PADRAO"
    case "${1:-}" in
        fixar|prender)
            local porta="${2:-}" caminho="${3:-}"
            case "$porta" in
                COM[0-9]|COM[0-9][0-9]|LPT[0-9]) ;;
                *) t_erro "$(t_msg portas_diga_qual)"; return 1 ;;
            esac
            [ -e "$caminho" ] || { t_erro "$(t_msg portas_sem_aparelho "$caminho")"; return 1; }
            [ -f "$p/system.reg" ] || { t_erro "$(t_msg portas_sem_ambiente)"; return 1; }
            # Rule number 1: this writes into a prefix, so it may only ever be
            # one of ours.
            if t_prefixo_protegido "$p"; then
                t_erro "$(t_msg portas_ambiente_de_terceiro)"
                return 1
            fi
            if WINEPREFIX="$p" WINEDEBUG=-all wine reg add 'HKLM\Software\Wine\Ports' \
                 /v "$porta" /t REG_SZ /d "$caminho" /f >>"$LOG" 2>&1; then
                t_ok "$(t_msg portas_fixada "$caminho" "$porta")"
            else
                t_erro "$(t_msg portas_nao_fixou)"
                return 1
            fi ;;
        soltar|liberar)
            local porta="${2:-}"
            [ -n "$porta" ] || { t_erro "$(t_msg portas_diga_qual_soltar)"; return 1; }
            WINEPREFIX="$p" WINEDEBUG=-all wine reg delete 'HKLM\Software\Wine\Ports' \
                /v "$porta" /f >>"$LOG" 2>&1
            t_ok "$(t_msg portas_soltada "$porta")" ;;
        ""|ver|listar)
            t_texto_portas "$p" | t_texto "$(t_msg portas_titulo_janela)" ;;
        *)
            t_erro "$(t_msg portas_nao_conheco "$1")"
            return 1 ;;
    esac
}

# ----------------------------------------------------------------- idioma
#
# The question is asked on FIRST RUN and not during the package install, and
# the reason is written down at t_primeira_vez: dpkg holds a lock while
# postinst runs, the graphical installer runs it in a daemon with no terminal
# and no session, and the per-user work has no reliable way to know who the
# user even is. Debconf could ask, at the cost of a dependency and a screen
# shown before the program exists. Following the system's own language and
# saying which one was picked costs nothing and is right far more often.
acao_idioma() {
    local escolha="${1:-}" c
    if [ -z "$escolha" ]; then
        {
            t_msg idioma_atual "$(t_idioma_nome "$TANDEM_IDIOMA")"; printf '\n\n'
            t_msg idioma_lista_titulo; printf '\n'
            for c in $TANDEM_IDIOMAS; do
                printf '  %-6s %s' "$c" "$(t_idioma_nome "$c")"
                [ "$c" = "$TANDEM_IDIOMA" ] && printf '   <--'
                t_idioma_revisado "$c" || printf '   (*)'
                printf '\n'
            done
            printf '\n'; t_msg idioma_rodape; printf '\n'
        } | t_texto "$(t_msg idioma_titulo_janela)"
        return 0
    fi

    for c in $TANDEM_IDIOMAS; do
        if [ "$c" = "$escolha" ]; then
            if ! t_idioma_tem_letras "$c"; then
                t_erro "$(t_msg idioma_sem_letra "$(t_idioma_nome "$c")" \
                                                 "$(t_idioma_nome "$TANDEM_IDIOMA")")"
                return 1
            fi
            t_idioma_grava "$c" || { t_erro "$(t_msg idioma_nao_gravou)"; return 1; }
            t_ok "$(t_msg idioma_trocado "$(t_idioma_nome "$c")")"
            t_idioma_revisado "$c" ||
                t_aviso "$(t_msg idioma_nao_revisado "$(t_idioma_nome "$c")")"
            return 0
        fi
    done
    t_erro "$(t_msg idioma_desconhecido "$escolha")"
    return 1
}

acao_logs() {
    local l
    # FIRST, before the glob. "There are no logs yet" and "I cannot write logs
    # at all" are different answers and this gave the first to both: the first
    # says nothing is wrong, while the second is the condition that disables
    # every diagnosis Tandem makes - and the owner reading it here is the owner
    # who came looking for one.
    #
    # The order matters for a second reason. With no state folder TANDEM_ESTADO
    # is the empty string, so the pattern below is "/*.log" and the glob walks
    # the ROOT of the filesystem: any stray log there would have been shown as
    # if it were Tandem's.
    if [ -n "${TANDEM_SEM_LOG:-}" ] || [ -z "${TANDEM_ESTADO:-}" ]; then
        t_erro "$(t_aviso_sem_log)"; return 1
    fi
    l="$(ls -1t "$TANDEM_ESTADO"/*.log 2>/dev/null | head -1)"
    [ -n "$l" ] || { t_erro "$(t_msg logs_nenhum)"; return 1; }
    tail -n 400 "$l" | t_texto "$(t_msg janela_titulo_arquivo "$(basename "$l")")"
}

# ----------------------------------------------------------------- lista
#
# The owner's idea, and it is a good one: instead of a bridge server between
# all the Tandems, a FILE that each installation downloads - the ad-blocker
# filter-list model. See docs/LIST-FORMAT.md.
acao_lista() {
    case "${1:-ver}" in
        atualizar|baixar|sincronizar)
            t_progresso_abre "$(t_msg lista_baixando)"
            t_lista_atualiza; local c=$?
            t_progresso_fecha
            case $c in
                0) t_ok "$(t_msg lista_atualizada \
                        "$(grep -vc '^#' "$TANDEM_LISTA" 2>/dev/null)")" ;;
                1) t_erro "$(t_msg lista_nao_baixou)" ;;
                3) t_erro "$(t_msg lista_nao_e_lista)" ;;
                4) t_erro "$(t_msg lista_nao_publicada)" ;;
                *) t_erro "$(t_msg lista_falta_curl)" ;;
            esac
            return $c ;;
        ligar|receber)
            t_config_grava RECEBER sim
            t_ok "$(t_msg lista_receber_ligado)"
            return 0 ;;
        desligar)
            t_config_grava RECEBER nao
            t_ok "$(t_msg lista_receber_desligado)"
            return 0 ;;
        ver|"")
            # The state of the switch goes on this screen whichever way it is
            # set. Receiving became automatic in 4.11, and an automatic thing
            # the owner cannot see is an automatic thing he cannot turn off.
            local estado
            if t_lista_receber_ligado; then
                estado="$(t_msg lista_recebendo_auto)"
            else
                estado="$(t_msg lista_recebendo_nao)"
            fi
            if [ ! -f "$TANDEM_LISTA" ]; then
                printf '%s\n\n%s\n' "$(t_msg lista_ainda_nao_baixada)" "$estado" |
                    t_texto "$(t_msg lista_titulo)"
                return 1
            fi
            printf '%s\n\n%s\n' "$(t_msg lista_resumo \
                "$(grep -vc '^#' "$TANDEM_LISTA")" "$TANDEM_LISTA" \
                "$(head -1 "$TANDEM_LISTA")")" "$estado" | t_texto "$(t_msg lista_titulo)"
            return 0 ;;
        *) t_erro "$(t_msg lista_uso)"; return 1 ;;
    esac
}

# The switch behind the "there is a newer Tandem" notice. It exists because a
# notice with no off switch is a nuisance, and a nuisance is something people
# learn to dismiss unread - which costs the notice that actually matters.
acao_versao() {
    case "${1:-}" in
        nao-avisar|nao|não|desligar)
            t_config_grava AVISAR_VERSAO nao
            t_ok "$(t_msg versao_avisar_desligado)" ;;
        avisar|ligar|sim)
            t_config_grava AVISAR_VERSAO sim
            t_ok "$(t_msg versao_avisar_ligado)" ;;
        # The same idiom the `version` command uses at the bottom of this
        # file, and exempt for the same reason: a product name is not prose.
        *)  echo "Tandem $VERSAO" ;;
    esac
    return 0
}

# Assembles the record for the owner to check and send. It sends NOTHING: a
# shop's machine does not talk to any server by decision of an automation.
acao_contribuir() {
    local prog="${1:-}" reg
    [ -n "$prog" ] || { t_erro "$(t_msg contrib_diga_qual)"; return 1; }
    [ -f "$prog" ] || { t_erro "$(t_msg nao_achei_o_programa "$prog")"; return 1; }
    reg="$(t_lista_registro "$prog")" || {
        t_erro "$(t_msg contrib_nada_util)"
        return 1; }

    printf '%s\n' "$(t_msg contrib_texto "$reg")" | t_texto "$(t_msg contrib_titulo)"

    # Copying a line off a screen, opening a browser, creating an account and
    # pasting it into an issue form is five steps, and lista/lista.tsv being
    # empty is the measurement of how many people take them. These two shortcuts
    # need no server: the clipboard, and a form that arrives already filled in.
    if t_tem_gui; then
        t_copia_para_area "$reg" && t_ok "$(t_msg contrib_copiada)"
        # The query parameter has to be the issue form's FIELD ID, and it was
        # "linha" while .github/ISSUE_TEMPLATE/list.yml calls that field
        # "record" - so the one shortcut that works opened an EMPTY form, while
        # README.md and LEIAME.md both promise "the form already filled in".
        # A name matching nothing looks exactly like a name matching something,
        # which is why the test for this compares the two files rather than
        # trusting either.
        if command -v xdg-open >/dev/null 2>&1 &&
           t_pergunta "$(t_msg contrib_abrir_formulario)" "$(t_msg botao_abrir_formulario)" "$(t_msg botao_nao_obrigado)"; then
            URL_FORM="https://github.com/ChrnX0/Tandem/issues/new?template=list.yml&record=$(t_url_escapa "$reg")"
            # Not backgrounded, and its status is read. Written as
            # "setsid ... >/dev/null 2>&1 &" the failure was unreachable: with
            # no browser xdg-open exits 3 with its reason on stderr, and the
            # owner was told nothing at all - the exact shape of failure this
            # project treats as a defect rather than a limitation. Dropping
            # setsid too, because xdg-open's terminal-browser fallback would
            # otherwise fight for the tty.
            if ! xdg-open "$URL_FORM" >/dev/null 2>&1; then
                t_erro "$(t_msg contrib_sem_navegador "$URL_FORM")"
            fi
        fi
    fi

    # And the offer that removes the five steps for good.
    if ! t_envio_decidido && t_tem_gui; then
        t_aviso "$(t_msg contrib_pode_mandar_sozinho)"
    fi
    return 0
}

# ----------------------------------------------------------------- enviar
#
# The switch the owner controls. It exists as its own command and not only as a
# dialog because a decision he cannot find again is not a decision he made - and
# because the honest place to tell him the queue is not going anywhere yet is
# here, in plain sight, rather than in a comment in the source.
acao_enviar() {
    local sub="${1:-}" fila
    case "$sub" in
        sim|ligar|on)
            t_envio_define sim
            t_ok "$(t_msg env_ligado)"
            acao_enviar agora >/dev/null 2>&1
            return 0 ;;
        nao|não|desligar|off)
            t_envio_define nao
            t_ok "$(t_msg env_desligado "$TANDEM_FILA")"
            return 0 ;;
        agora|flush)
            if ! t_envio_ligado; then
                t_erro "$(t_msg env_esta_desligado)"
                return 1
            fi
            if [ -z "$TANDEM_LISTA_ENVIO" ]; then
                t_erro "$(t_msg env_sem_endereco)"
                return 1
            fi
            # "forcado": he asked, so the wait after a failed pass does not
            # apply to him. And a pass where the server refused everything gets
            # a sentence instead of a bare "0 sent", which reads like a defect
            # on this machine when it is not one.
            local n rc restam; n="$(t_envio_envia forcado)"; rc=$?
            restam="$(t_envio_pendentes)"
            if [ "$rc" = 3 ]; then
                t_erro "$(t_msg_n env_servidor_recusou "$restam" "$restam")"
                return 1
            fi
            t_ok "$(t_msg_n env_enviadas "${n:-0}" "${n:-0}" "$restam")"
            return 0 ;;
        ''|status|ver) ;;
        *) t_erro "$(t_msg env_nao_conheco "$sub")"
           return 1 ;;
    esac

    fila="$(t_envio_pendentes)"
    {
        printf '%s\n\n' "$(t_msg env_cabecalho)"
        if t_envio_ligado; then
            printf '%s\n' "$(t_msg env_agora_ligado \
                "$(t_config_le ENVIAR_DESDE 2>/dev/null || echo '?')")"
        elif t_envio_decidido; then
            printf '%s\n' "$(t_msg env_agora_desligado \
                "$(t_config_le ENVIAR_DESDE 2>/dev/null || echo '?')")"
        else
            printf '%s\n' "$(t_msg env_ninguem_decidiu)"
        fi
        printf '%s\n' "$(t_msg env_fila "$fila")"
        # What has actually LEFT. Until 4.11 the machine kept no record of it:
        # the sieve refusal and the 4xx refusal both park their line, and the
        # one branch that succeeded destroyed it. So "what has this machine
        # sent about my shop?" had no answer here - which is the question a
        # shopkeeper, or whoever audits him, actually asks, and section 3 of
        # the idea ledger rejected telemetry on exactly this rule: nothing the
        # owner cannot see and cannot delete.
        printf '%s\n' "$(t_msg env_ja_sairam "$(t_envio_ja_enviados)")"
        if [ -n "$TANDEM_LISTA_ENVIO" ]; then
            printf '%s\n' "$(t_msg env_endereco "$TANDEM_LISTA_ENVIO")"
        else
            printf '%s\n' "$(t_msg env_endereco_nao_existe)"
        fi
        printf '\n%s\n\n' "$(t_msg env_o_que_sai)"
        printf '%s\n\n' "$(t_msg env_nunca_sai)"
        printf '%s\n' "$(t_msg env_ligar)"
        printf '%s\n' "$(t_msg env_desligar)"
        printf '%s\n' "$(t_msg env_ver_fila "$TANDEM_FILA")"
        [ "$(t_envio_ja_enviados)" != 0 ] &&
            printf '%s\n' "$(t_msg env_ver_enviados "$TANDEM_FILA.enviados")"
    } | t_texto "$(t_msg env_titulo)"
    return 0
}

# ---------------------------------------------------------------- socorro
#
# Remote support today is someone dictating commands over the phone to a
# person who does not know where the Terminal is. This gathers everything
# whoever understands the thing is going to ask for into a single file, which
# the owner sends over WhatsApp and that is it.
#
# The file says on its first line what is inside it. It contains the owner's
# file paths, and a file path sometimes carries a customer's name - he is the
# one who decides to send it, but he only really decides if he knows what he
# is sending.
acao_socorro() {
    local arq l
    arq="$HOME/tandem-socorro-$(date +%F-%H%M).txt"
    {
        printf '%s\n' "$(t_msg soc_cabecalho)"
        printf '%s\n\n' "$(t_msg soc_gerado_em "$(date '+%x %H:%M')")"
        printf '%s\n' "$(t_msg soc_o_que_tem)"
        printf '\n===== %s =====\n\n' "$(t_msg soc_sec_diagnostico)"
        acao_doctor 2>&1
        printf '\n===== %s =====\n\n' "$(t_msg soc_sec_autoteste)"
        acao_autoteste 2>&1
        printf '\n===== %s =====\n\n' "$(t_msg soc_sec_suspeitas)"
        if [ -s "$TANDEM_ESTADO/traducao-suspeita.tsv" ]; then
            cat "$TANDEM_ESTADO/traducao-suspeita.tsv"
        else
            printf '%s\n' "$(t_msg soc_nenhuma)"
        fi
        printf '\n===== %s =====\n\n' "$(t_msg soc_sec_aprendi)"
        acao_memoria 2>&1
        printf '\n===== %s =====\n' "$(t_msg soc_sec_registros)"
        for l in "$TANDEM_ESTADO"/*.log; do
            [ -f "$l" ] || continue
            printf '\n%s\n' "$(t_msg soc_ultimas_linhas "$(basename -- "$l")")"
            tail -n 200 "$l"
        done
    } > "$arq" 2>/dev/null

    if [ -s "$arq" ]; then
        # NOT t_ok. This is the "send me the diagnosis" button, and t_ok returns
        # as soon as notify-send succeeds - so on a graphical machine the whole
        # message became a ten-second toast, and the owner was left to find a
        # file in his home directory from a notification that had vanished.
        # Worse, the paragraph that goes with it is the one that makes this
        # feature defensible: the file holds HIS file paths, and a path
        # sometimes carries a customer's name. He only really decides to send it
        # if he has read that, and a toast is not somewhere anybody reads.
        #
        # A window, then the same two shortcuts acao_contribuir has had all
        # along, thirty lines above this one.
        printf '%s\n' "$(t_msg soc_pronto "$arq")" | t_texto "$(t_msg soc_titulo)"
        t_copia_para_area "$arq" && t_ok "$(t_msg soc_caminho_copiado)"
        if t_tem_gui && command -v xdg-open >/dev/null 2>&1 &&
           t_pergunta "$(t_msg soc_abrir_pasta)" \
                      "$(t_msg botao_abrir_pasta)" "$(t_msg botao_nao_obrigado)"; then
            # Checked, not backgrounded: with no file manager xdg-open exits
            # non-zero and saying nothing would be the silent failure this whole
            # command exists to help somebody diagnose.
            xdg-open "$(dirname -- "$arq")" >/dev/null 2>&1 ||
                t_erro "$(t_msg soc_sem_gerenciador "$arq")"
        fi
        return 0
    fi
    t_erro "$(t_msg soc_nao_gerou)"
    return 1
}

acao_painel() {
    # With no graphical session the panel has no way to show up: display the
    # help instead of opening and closing an invisible window saying nothing.
    if ! t_tem_gui || ! command -v zenity >/dev/null 2>&1; then uso; return 0; fi
    local esc
    while :; do
        # The action names are the machine-readable half and stay Portuguese
        # forever - "case $esc in" matches them, and a command copied off a
        # forum has to work on any machine.
        #
        # But until 4.12 they were also SHOWN, as the first and leftmost column
        # of the only screen a shop owner who never opens a terminal ever sees.
        # "identidade", "restore", "autoteste" are words he has to decode before
        # he can read the sentence beside them, and decoding them buys him
        # nothing: he is clicking a row, not typing a command. --hide-column
        # keeps the token as the value zenity RETURNS while taking it off the
        # screen, so "case $esc in" below is untouched and the panel becomes one
        # column of plain sentences. Verified with xdotool driving a real
        # zenity: with column 1 hidden it still answers "instalar".
        #
        # The VERSION goes in the title, and the reason is the owner's: to find
        # out which Tandem he is running he had to open a terminal - the exact
        # thing this program exists to spare him.
        esc="$(zenity --list --title="Tandem $VERSAO" --width=560 --height=430 \
            --text="$(t_msg pan_pergunta)" \
            --column="$(t_msg pan_col_acao)" \
            --column="$(t_msg pan_col_descricao)" --hide-header \
            --hide-column=1 --print-column=1 \
            "instalar"   "$(t_msg pan_instalar)" \
            "preparar"   "$(t_msg pan_preparar)" \
            "programas"  "$(t_msg pan_programas)" \
            "remover"    "$(t_msg pan_remover)" \
            "android"    "$(t_msg pan_android)" \
            "doctor"     "$(t_msg pan_doctor)" \
            "autoteste"  "$(t_msg pan_autoteste)" \
            "dados"      "$(t_msg pan_dados)" \
            "portas"     "$(t_msg pan_portas)" \
            "identidade" "$(t_msg pan_identidade)" \
            "backup"     "$(t_msg pan_backup)" \
            "restore"    "$(t_msg pan_restore)" \
            "repair"     "$(t_msg pan_repair)" \
            "memoria"    "$(t_msg pan_memoria)" \
            "lista"      "$(t_msg pan_lista)" \
            "enviar"     "$(t_msg pan_enviar)" \
            "socorro"    "$(t_msg pan_socorro)" \
            "logs"       "$(t_msg pan_logs)" \
            2>/dev/null)" || return 0
        case "$esc" in
            instalar)
                local f
                # zenity's --file-filter is "label | globs", so only the half
                # before the bar is translated. The globs live in a variable at
                # the top of this file rather than here: they are the nine
                # formats, not prose, and a translator opening a catalogue
                # should never be shown a list of extensions to consider
                # rewording.
                f="$(zenity --file-selection --title="$(t_msg pan_escolha_arquivo)" \
                     --file-filter="$(t_msg pan_filtro_programas) | $TANDEM_GLOBS" \
                     --file-filter="$(t_msg pan_filtro_todos) | *" 2>/dev/null)" || continue
                acao_install "$f" ;;
            preparar)  acao_preparar ;;
            programas) acao_programas ;;
            remover)   acao_uninstall ;;
            android)  setsid "$TANDEM_BIN"/tandem-android >/dev/null 2>&1 & ;;
            doctor)   acao_doctor ;;
            autoteste) acao_autoteste ;;
            dados)    acao_dados ;;
            portas)   acao_portas ;;
            identidade) acao_identidade ;;
            backup)   acao_backup ;;
            restore)  acao_restore ;;
            repair)   "$TANDEM_BIN"/tandem-repair ;;
            memoria)  acao_memoria ;;
            lista)    acao_lista atualizar ;;
            enviar)   acao_enviar ;;
            socorro)  acao_socorro ;;
            logs)     acao_logs ;;
            *)        return 0 ;;
        esac
    done
}

# ------------------------------------------------------------------ main
#
# Say the translation is unreviewed, on the path people ACTUALLY arrive by.
#
# t_idioma_revisado had exactly two call sites, both inside acao_idioma - the
# command a person types to CHANGE the language. But step 3 of
# t_idioma_escolhe resolves from the system locale with nobody typing
# anything, which is how almost everybody outside Brazil gets here. So this
# project's own principle - shipping an unreviewed translation is defensible,
# shipping it without saying so is not - was honoured only for the minority,
# and everybody else got the unreviewed prose with the honesty stripped off.
#
# It is also the only recruitment channel that exists for the five catalogues
# waiting on review: the people running them are native speakers who do not
# know there is anything to review.
#
# On stderr and never a dialog, once per (language, version) - a new version
# adds new lines to those catalogues, so the notice is worth repeating then and
# not before. And deliberately NOT from t_primeira_vez, which tandem-exe calls
# at line 9, between the double click and the program: nothing belongs there.
if [ -n "${TANDEM_IDIOMA:-}" ] && ! t_idioma_revisado "$TANDEM_IDIOMA" &&
   [ "$(t_config_le REVISAO_AVISADA 2>/dev/null)" != "$TANDEM_IDIOMA:$VERSAO" ]; then
    t_config_grava REVISAO_AVISADA "$TANDEM_IDIOMA:$VERSAO"
    # The NAME, not the locale code. "fr" is a thing a programmer reads;
    # t_idioma_nome exists and every other screen already uses it.
    printf '%s\n' "$(t_msg idioma_nao_revisado_aviso \
                     "$(t_idioma_nome "$TANDEM_IDIOMA")")" >&2
fi

# Is there a newer Tandem? It only ever LOOKS - see t_versao_busca for why this
# will never install anything by itself. The check runs in the background and
# the answer is used on the NEXT run, so nothing here waits on a network.
#
# Told once per version found, not once a day: a notice that repeats is a
# notice people learn to scroll past, and this one has to survive being ignored
# until he has a quiet minute.
t_versao_talvez_verifica 2>/dev/null
VERSAO_NOVA="$(t_versao_nova_conhecida 2>/dev/null)"
if [ -n "$VERSAO_NOVA" ] &&
   [ "$(t_config_le VERSAO_AVISADA 2>/dev/null)" != "$VERSAO_NOVA" ]; then
    t_config_grava VERSAO_AVISADA "$VERSAO_NOVA"
    printf '%s\n' "$(t_msg versao_nova_aviso "$VERSAO_NOVA" "$VERSAO")" >&2
fi

case "${1:-}" in
    ""|painel|panel)      acao_painel ;;
    install|instalar|abrir) shift; acao_install "$@" ;;
    preparar|setup)       acao_preparar ;;
    programas|apps)       shift; acao_programas "$@" ;;
    desinstalar|uninstall|remover) shift; acao_uninstall "$@" ;;
    android)              exec "$TANDEM_BIN"/tandem-android ;;
    doctor|diagnostico)   acao_doctor ;;
    autoteste|autotest)   acao_autoteste ;;
    repair|consertar)     exec "$TANDEM_BIN"/tandem-repair ;;
    dados|meus-dados)     shift; acao_dados "$@" ;;
    backup)               shift; acao_backup "${1:-}" ;;
    restore|restaurar)    shift; acao_restore "${1:-}" ;;
    protect|proteger)     shift; acao_protect "$@" ;;
    identidade|fingerprint) acao_identidade ;;
    portas|ports)         shift; acao_portas "$@" ;;
    idioma|language|lang) shift; acao_idioma "$@" ;;
    alternativas|alternativa) shift; acao_alternativas "$@" ;;
    receita|receitas)     shift; acao_receita "$@" ;;
    memoria|memória)      shift; acao_memoria "$@" ;;
    esquecer|esqueca)     shift; acao_esquecer "$@" ;;
    lista)                shift; acao_lista "$@" ;;
    versao|versão)        shift; acao_versao "$@" ;;
    enviar|envio)         shift; acao_enviar "$@" ;;
    contribuir|contribuicao) shift; acao_contribuir "$@" ;;
    socorro|ajuda-tecnica) acao_socorro ;;
    logs|log)             acao_logs ;;
    # Internal use by postinst: already done in the t_primeira_vez call up
    # top. Kept out of the help on purpose.
    --primeira-vez)       : ;;
    version|--version|-v) echo "Tandem $VERSAO" ;;
    help|--help|-h)       uso ;;
    *)                    acao_install "$1" ;;
esac
