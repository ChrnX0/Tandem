#!/bin/bash
# Tandem - main command and control panel.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"
t_log_init tandem "$*"
t_primeira_vez

# One source of truth: common.sh. This line still says VERSAO= so the coupled
# check in the suite can find it, and it reads the value rather than repeating it.
VERSAO="$TANDEM_VERSAO"

uso() {
    cat <<'AJUDA'
Tandem - roda programas Windows, apps Android e pacotes do Linux.

  Formatos: .exe .msi  |  .apk .xapk .apks .apkm  |  .AppImage .jar
            .deb .rpm .flatpakref .snap  |  .sh .run

  tandem                      abre o painel
  tandem install <arquivo>    instala/executa qualquer um dos nove formatos
  tandem preparar             instala o que falta (Wine, Java, Android, ...)
  tandem programas [nome]     lista e abre os programas instalados
  tandem desinstalar [nome]   remove um programa Windows instalado
  tandem android              abre a tela do Android
  tandem doctor               diagnostico do ambiente (o que existe)
  tandem autoteste            exercita de verdade (o que funciona)
  tandem repair               reaplica as associacoes de arquivo
  tandem dados                mostra os seus arquivos dentro do Windows
  tandem dados salvar         copia SO os seus arquivos (rapido e pequeno)
  tandem dados restaurar [c]  devolve os seus arquivos de uma copia
  tandem backup               salva o ambiente Windows
  tandem restore              restaura o ambiente Windows
  tandem protect <caminho>    protege um perfil Wine contra alteracoes
  tandem identidade           o que o programa ve da sua maquina (licenca)
  tandem portas               pinpad, balanca, impressora: em que COM ficaram
  tandem portas fixar <p> <d> prende um aparelho numa porta (ex.: COM2)
  tandem alternativas <nome>  procura um programa de Linux que faca o mesmo
  tandem receita <arquivo>    exporta o que aprendeu, para mandar a alguem
  tandem receita --importar <r> <arquivo>   usa a receita de outra pessoa
  tandem memoria [nome]       o que o Tandem aprendeu sobre os programas
  tandem esquecer <nome>      apaga o que ele aprendeu sobre um programa
  tandem lista                o que a comunidade ja descobriu
  tandem lista atualizar      baixa a lista (nao manda nada seu)
  tandem contribuir <arq>     monta a linha para voce mandar, se quiser
  tandem enviar [sim|nao]     mandar automaticamente o que aprende (padrao: nao)
  tandem socorro              junta tudo num arquivo para pedir ajuda
  tandem logs                 mostra o log mais recente
  tandem version              mostra a versao instalada
  tandem help                 mostra esta lista
AJUDA
}

# ---------------------------------------------------------------- actions

acao_install() {
    local f="$1"
    [ -n "$f" ] || { t_erro "Informe o arquivo."; return 1; }
    case "${f,,}" in
        *.apk|*.xapk|*.apks|*.apkm) exec "$TANDEM_BIN"/tandem-apk "$f" ;;
        *.exe|*.msi|*.msp|*.lnk|*.bat|*.cmd|*.url) exec "$TANDEM_BIN"/tandem-exe "$f" ;;
        *.appimage) exec "$TANDEM_BIN"/tandem-appimage "$f" ;;
        *.jar)      exec "$TANDEM_BIN"/tandem-jar "$f" ;;
        *.deb|*.udeb) exec "$TANDEM_BIN"/tandem-deb "$f" ;;
        *.rpm)      exec "$TANDEM_BIN"/tandem-rpm "$f" ;;
        *.flatpakref|*.flatpakrepo) exec "$TANDEM_BIN"/tandem-flatpak "$f" ;;
        *.snap)     exec "$TANDEM_BIN"/tandem-snap "$f" ;;
        *.sh|*.run|*.bin) exec "$TANDEM_BIN"/tandem-script "$f" ;;
        *)
            # By content, when the name says nothing. The order matters, and it
            # is the specific mark before the generic one every time: an AppImage
            # is an ELF, a .jar is a zip, a .deb is an ar archive. A zip that is
            # not a jar is an Android package; an ELF that is not an AppImage is
            # an ordinary Linux program that needs nobody's help to run.
            if head -c2 -- "$f" 2>/dev/null | grep -q MZ; then
                exec "$TANDEM_BIN"/tandem-exe "$f"
            elif head -c8 -- "$f" 2>/dev/null | grep -q '<arch>'; then
                exec "$TANDEM_BIN"/tandem-deb "$f"
            elif head -c4 -- "$f" 2>/dev/null | od -An -tx1 2>/dev/null |
                 tr -d ' ' | grep -q '^edabeedb'; then
                exec "$TANDEM_BIN"/tandem-rpm "$f"
            elif t_appimage_info "$f" 2>/dev/null | grep -q '^TIPO='; then
                exec "$TANDEM_BIN"/tandem-appimage "$f"
            elif t_jar_info "$f" 2>/dev/null | grep -q '^PRINCIPAL=.'; then
                exec "$TANDEM_BIN"/tandem-jar "$f"
            elif grep -qi '^\[Flatpak Ref\]\|^\[Flatpak Repo\]' "$f" 2>/dev/null; then
                exec "$TANDEM_BIN"/tandem-flatpak "$f"
            elif head -c2 -- "$f" 2>/dev/null | grep -q PK; then
                exec "$TANDEM_BIN"/tandem-apk "$f"
            elif head -c2 -- "$f" 2>/dev/null | grep -q '#!'; then
                exec "$TANDEM_BIN"/tandem-script "$f"
            else t_erro "Não reconheci o tipo deste arquivo."; return 1
            fi ;;
    esac
}

acao_doctor() {
    local out="" ip sdk
    out+="Tandem $VERSAO\n\n"
    out+="SISTEMA\n"
    out+="  $( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-desconhecido}" )\n"
    out+="  kernel $(uname -r)   sessão: ${XDG_SESSION_TYPE:-?}\n\n"

    out+="PROGRAMAS WINDOWS\n"
    if command -v wine >/dev/null 2>&1; then
        out+="  wine: $(wine --version 2>/dev/null)\n"
        t_tem_wine64 && out+="  programas de 64 bits: sim\n" ||
            out+="  programas de 64 bits: NÃO (o Wine desta máquina é só de 32 bits)\n"
        t_tem_wine32 && out+="  programas de 32 bits: sim\n" ||
            out+="  programas de 32 bits: NÃO (programas antigos não abrem)\n"
        command -v winetricks >/dev/null 2>&1 &&
            out+="  winetricks: sim\n" || out+="  winetricks: NÃO (não instala dependências)\n"
        [ -f "$TANDEM_PREFIXO_PADRAO/system.reg" ] &&
            out+="  ambiente: pronto\n" || out+="  ambiente: será criado no primeiro uso\n"
    else
        out+="  wine: NÃO INSTALADO\n"
    fi
    out+="\nAPPS ANDROID\n"
    if command -v waydroid >/dev/null 2>&1; then
        out+="  waydroid: instalado\n"
        out+="  serviço: $(systemctl is-active waydroid-container 2>/dev/null)\n"
        t_wd_sessao_ok && out+="  sessão: ativa\n" || out+="  sessão: parada\n"
        if t_wd_pronto; then
            sdk="$(t_wd_sdk)"; ip="$(t_wd_ip)"
            out+="  Android: pronto (API ${sdk:-?}, IP ${ip:-?})\n"
            t_wd_tem_arm && out+="  tradutor ARM: sim\n" || out+="  tradutor ARM: NÃO (apps de celular não instalam)\n"
        else
            out+="  Android: não iniciado\n"
        fi
        command -v adb >/dev/null 2>&1 &&
            out+="  adb: sim\n" || out+="  adb: NÃO (pacotes .xapk não instalam)\n"
        # Two checkable facts about THIS machine, in place of a paragraph of
        # folklore. The barrier to a USB device inside Android is not the
        # container - Waydroid denies no devices - it is that the Android image
        # does not declare android.hardware.usb.host, so nothing enumerates.
        if t_wd_usb_declarado; then
            out+="  USB para o Android: declarado (aparelhos USB podem aparecer lá dentro)\n"
        else
            out+="  USB para o Android: não declarado (é o normal; o Android não enxerga\n"
            out+="    aparelho USB nenhum, e leitor de código de barras não precisa disso)\n"
        fi
        if t_wd_uevent; then
            out+="  acesso direto a aparelhos: ligado — ATENÇÃO: com um leitor de código de\n"
            out+="    barras isto costuma digitar cada código DUAS vezes\n"
        fi
    else
        out+="  waydroid: NÃO INSTALADO\n"
    fi
    out+="\nPACOTES DO LINUX\n"
    if command -v java >/dev/null 2>&1; then
        # The version line, not the first line: with JAVA_TOOL_OPTIONS set in
        # the environment - common on machines somebody has configured - Java
        # prints a paragraph of proxy settings first, and "head -1" put the
        # whole paragraph in the middle of the diagnosis.
        out+="  java: $(t_java_versao 2>/dev/null || echo '?') ($(java -version 2>&1 |
              grep -m1 'version "' | sed 's/^ *//'))\n"
    else
        out+="  java: NÃO INSTALADO (programas .jar não abrem)\n"
    fi
    t_tem_fuse2 &&
        out+="  FUSE: sim (AppImage abre direto)\n" ||
        out+="  FUSE: NÃO (AppImage abre pelo caminho lento, desempacotando)\n"
    out+="  processador: $(t_maquina_arch) (pacotes: $(t_arch_sistema))\n"
    local n_ai; n_ai="$(t_atalhos_appimage | grep -c . 2>/dev/null)"
    out+="  AppImage no menu: ${n_ai:-0}\n"
    command -v apt-get >/dev/null 2>&1 &&
        out+="  pacotes .deb: sim (o Tandem confere as dependências antes de pedir a senha)\n" ||
        out+="  pacotes .deb: NÃO (sem apt nesta máquina)\n"
    command -v flatpak >/dev/null 2>&1 &&
        out+="  flatpak: $(flatpak --version 2>/dev/null)\n" ||
        out+="  flatpak: não instalado (o Tandem oferece instalar se precisar)\n"
    command -v snap >/dev/null 2>&1 &&
        out+="  snap: sim\n" || out+="  snap: não instalado\n"
    local arqs_estrangeiras
    arqs_estrangeiras="$(dpkg --print-foreign-architectures 2>/dev/null | tr '\n' ' ')"
    [ -n "$arqs_estrangeiras" ] &&
        out+="  arquiteturas extras: $arqs_estrangeiras\n"

    # The counter's hardware. Wine already reaches all of it and the two ways
    # it goes wrong - a number above COM4, and the dialout group - are silent,
    # so they belong in the diagnosis and not in a forum thread.
    out+="\nAPARELHOS DA LOJA\n"
    local n_ser n_par
    n_ser="$(t_portas_seriais | awk 'END { print NR + 0 }')"
    n_par="$(t_portas_paralelas | awk 'END { print NR + 0 }')"
    out+="  portas seriais: $n_ser (pinpad, balança, leitor)   paralelas: $n_par\n"
    t_no_grupo dialout &&
        out+="  grupo dialout: sim\n" ||
        out+="  grupo dialout: NÃO (o aparelho aparece e não abre) — tandem portas\n"
    if [ -f "$TANDEM_PREFIXO_PADRAO/system.reg" ]; then
        local id_serial
        id_serial="$(cat "$TANDEM_PREFIXO_PADRAO/drive_c/.windows-serial" 2>/dev/null)"
        [ -n "$id_serial" ] &&
            out+="  identidade da máquina: presa (licenças sobrevivem a refazer o ambiente)\n" ||
            out+="  identidade da máquina: solta (ambiente antigo) — veja: tandem identidade\n"
    fi

    # Only shown when there is something to show. A shop with no hardware key
    # does not need a line about hardware keys in its diagnosis, and a
    # diagnosis nobody reads to the end diagnoses nothing.
    local fam
    for fam in sentinel codemeter; do
        case "$(t_chave_estado "$fam" | tr '\n' ' ')" in
            *SERVICO=sim*|*PORTA=sim*)
                out+="  chave de proteção ($fam): serviço rodando nesta máquina\n" ;;
        esac
    done

    # Where Wine ends, a real Windows in a virtual machine begins - and it is
    # the only route to a kernel driver or a legacy dongle. Tandem does not
    # install one; it says whether this machine could carry one, because
    # "buy a Windows Pro licence" is bad advice on a machine whose BIOS has
    # virtualisation switched off.
    case "$(t_vm_possivel)" in
        sim*)      out+="  Windows em máquina virtual: cabe aqui (é a saída para driver e chave antiga)\n" ;;
        apertado*) out+="  Windows em máquina virtual: cabe apertado (pouca memória ou disco)\n" ;;
        bios*)     out+="  Windows em máquina virtual: o processador aceita, mas está desligado na BIOS\n" ;;
        *)         out+="  Windows em máquina virtual: este processador não faz\n" ;;
    esac

    out+="\nPERFIS PROTEGIDOS\n"
    if [ -s "$TANDEM_PROTEGIDOS" ]; then
        while read -r l; do [ -n "$l" ] && out+="  $l\n"; done < "$TANDEM_PROTEGIDOS"
    else
        out+="  (nenhum listado; perfis de terceiros são protegidos automaticamente)\n"
    fi

    # %b (and not raw "$out") because the text has \n to expand but may
    # contain % coming from paths and versions, which would break the format.
    printf '%b' "$out" | t_texto "Tandem - Diagnóstico"
}

# ---------------------------------------------------------------- dados
#
# "If you give up on Linux, your data comes back with you." That sentence is
# what makes a shop owner willing to try - and up to version 3.4 Tandem had no
# way to keep it, because nothing here told the environment (rebuildable)
# apart from the files the person typed in (not).
acao_dados() {
    local sub="${1:-listar}"
    case "$sub" in
        salvar|save|copiar)   acao_dados_salvar "${2:-}" ;;
        restaurar|restore)    acao_dados_restaurar "${2:-}" ;;
        listar|lista|"")      acao_dados_listar ;;
        *) t_erro "Não conheço \"tandem dados $sub\".

Use:  tandem dados | tandem dados salvar | tandem dados restaurar"; return 1 ;;
    esac
}

acao_dados_listar() {
    local p="$TANDEM_PREFIXO_PADRAO" total linhas
    [ -d "$p/drive_c" ] || { t_erro "Ainda não há um ambiente Windows aqui."; return 1; }
    linhas="$(t_dados_lista "$p" 2>/dev/null)"
    total="$(printf '%s\n' "$linhas" | awk -F'\t' '{s += $3} END {print s + 0}')"
    if [ -z "$linhas" ]; then
        printf '%s\n' "Seus arquivos dentro do Windows

Não encontrei nenhum arquivo seu ainda - só o ambiente, que o Tandem
sabe refazer sozinho em alguns minutos.

Isso é normal se você ainda não usou nenhum programa para valer." | t_texto "Tandem - Seus arquivos"
        return 0
    fi
    printf '%s\n' "Seus arquivos dentro do Windows

Estes são os arquivos que VOCÊ criou. O resto (o Windows de mentira, os
componentes, os programas) o Tandem refaz sozinho; isto aqui, não:

$(printf '%s\n' "$linhas" | sort -t"$(printf '\t')" -k3 -rn | head -40 |
  while IFS="$(printf '\t')" read -r _ caminho bytes; do
      printf -- '- %-52s %s\n' "$caminho" "$(t_tamanho_amigavel "$bytes")"
  done)

Total: $(t_tamanho_amigavel "$total") em $(printf '%s\n' "$linhas" | grep -c .) itens.

Para guardar uma cópia só disso:   tandem dados salvar" | t_texto "Tandem - Seus arquivos"
}

acao_dados_salvar() {
    local p="$TANDEM_PREFIXO_PADRAO" destino="${1:-}" total
    [ -d "$p/drive_c" ] || { t_erro "Ainda não há um ambiente Windows aqui."; return 1; }
    total="$(t_dados_total "$p")"
    if [ "${total:-0}" -eq 0 ]; then
        t_aviso "Não há arquivos seus para copiar ainda."
        return 0
    fi
    [ -n "$destino" ] || destino="$HOME/tandem-dados-$(date +%F-%H%M).tar.gz"
    t_progresso_abre "Copiando os seus arquivos ($(t_tamanho_amigavel "$total"))..."
    t_dados_salva "$p" "$destino"; local c=$?
    t_progresso_fecha
    if [ $c -eq 0 ]; then
        t_ok "Seus arquivos foram copiados para:

$destino

Este arquivo é seu. Guarde num pendrive ou mande para você mesmo por
e-mail: com ele, seus dados voltam em qualquer computador."
    else
        t_erro "Não consegui copiar os seus arquivos."
    fi
    return $c
}

acao_dados_restaurar() {
    local p="$TANDEM_PREFIXO_PADRAO" arq="${1:-}"
    [ -n "$arq" ] || arq="$(ls -1t "$HOME"/tandem-dados-*.tar.gz 2>/dev/null | head -1)"
    [ -n "$arq" ] && [ -f "$arq" ] || {
        t_erro "Não encontrei nenhuma cópia dos seus arquivos.

Se você tem o arquivo, diga onde ele está:
tandem dados restaurar /caminho/da/copia.tar.gz"; return 1; }
    [ -d "$p/drive_c" ] || { t_erro "Ainda não há um ambiente Windows para devolver os arquivos."; return 1; }
    # Giving data back DELETES nothing: a file that already exists stays as it
    # is. A restore that overwrites today's work with last week's copy is
    # exactly the damage this command exists to prevent.
    t_pergunta "Devolver os seus arquivos a partir de:

$(basename -- "$arq")

Nada do que já existe será apagado - só entram os arquivos que faltam." \
        "Devolver" "Cancelar" || return 1
    t_progresso_abre "Devolvendo os seus arquivos..."
    tar -C "$p/drive_c" -xzf "$arq" --skip-old-files 2>>"$LOG"; local c=$?
    t_progresso_fecha
    [ $c -eq 0 ] && t_ok "Seus arquivos foram devolvidos." || t_erro "Não consegui devolver os arquivos."
    return $c
}

acao_backup() {
    local p="$TANDEM_PREFIXO_PADRAO"
    [ -f "$p/system.reg" ] || { t_erro "Não há ambiente Windows para salvar ainda."; return 1; }
    local dest
    dest="$HOME/tandem-backup-$(date +%F-%H%M).tar.gz"
    t_progresso_abre "Salvando o ambiente Windows. Pode demorar."
    tar -C "$(dirname -- "$p")" -czf "$dest" "$(basename -- "$p")" 2>>"$LOG"
    local c=$?
    t_progresso_fecha
    local so_dados; so_dados="$(t_dados_total "$p")"
    [ $c -eq 0 ] && t_ok "Backup salvo em:
$dest

Isto é o ambiente INTEIRO. Os seus arquivos são $(t_tamanho_amigavel "${so_dados:-0}")
desse total - para levar só eles, que é rápido e cabe num e-mail:
tandem dados salvar" || t_erro "Não consegui salvar o backup."
    return $c
}

acao_restore() {
    local arq
    arq="$(ls -1t "$HOME"/tandem-backup-*.tar.gz 2>/dev/null | head -1)"
    [ -n "$arq" ] || { t_erro "Nenhum backup encontrado na sua pasta pessoal."; return 1; }
    t_pergunta "Restaurar o ambiente Windows a partir de:

$(basename -- "$arq")

O ambiente atual será substituído. Se algum programa daqui foi ativado com
licença amarrada a este computador, ele volta a ser o de quando a cópia foi
feita — e pode pedir ativação de novo." "Restaurar" "Cancelar" || return 1
    # Before swapping the whole environment, save what cannot be remade.
    # Without this the command gave back last week's environment and took the
    # month's sales along with it - silently, and with no chance to undo.
    local resgate
    local c_resgate
    resgate="$(t_dados_resgate "$TANDEM_PREFIXO_PADRAO" antes-de-restaurar)"; c_resgate=$?
    case $c_resgate in
        0) t_aviso "Guardei uma cópia dos seus arquivos em:
$resgate" ;;
        1) t_pergunta "$(t_texto_resgate_falhou)

Restaurar mesmo assim?" "Restaurar assim mesmo" "Parar" || return 1 ;;
    esac
    t_progresso_abre "Restaurando..."
    rm -rf -- "$TANDEM_PREFIXO_PADRAO"
    mkdir -p "$(dirname -- "$TANDEM_PREFIXO_PADRAO")"
    tar -C "$(dirname -- "$TANDEM_PREFIXO_PADRAO")" -xzf "$arq" 2>>"$LOG"
    local c=$?
    t_progresso_fecha
    [ $c -eq 0 ] && t_ok "Ambiente restaurado." || t_erro "Não consegui restaurar."
    return $c
}

acao_protect() {
    local p; p="$(readlink -f -- "${1:-}" 2>/dev/null)"
    [ -n "$p" ] && [ -d "$p" ] || { t_erro "Caminho inválido."; return 1; }
    t_protege "$p" || { t_erro "Não consegui gravar a lista de perfis protegidos."; return 1; }
    t_ok "Perfil protegido:
$p

O Tandem nunca vai instalar nem alterar nada aí dentro."
}

# ----------------------------------------------------------------- preparar
#
# "When you install Tandem it should also install Wine and Waydroid and
# everything it needs" - the user's request, and the honest technical answer:
# during the .deb installation that is impossible (dpkg's lock), but one
# command afterwards settles everything at once. And clicking a .exe with no
# Wine offers it too.
acao_preparar() {
    local faltas linha codigos=() descricoes=() plano="" script c

    faltas="$(t_pecas_faltando)"
    if [ -z "$faltas" ]; then
        t_ok "Nada falta: esta máquina já tem tudo que o Tandem usa."
        return 0
    fi

    while IFS='|' read -r c linha; do
        [ -n "$c" ] || continue
        codigos+=("$c"); descricoes+=("$linha")
        plano="$plano
• $linha"
    done <<< "$faltas"

    if ! t_pergunta "O Tandem pode instalar o que está faltando:
$plano

Precisa de internet e da sua senha. Posso continuar?" "Instalar tudo" "Agora não"; then
        if [ -t 0 ]; then
            printf 'O Tandem pode instalar o que está faltando:\n%s\n\nPrecisa de internet e da sua senha. Continuar? [s/N] ' "$plano"
            read -r r
            case "$r" in s|S|sim|SIM) ;; *) echo "Cancelado."; return 1 ;; esac
        else
            t_erro "Não instalei nada: preciso de uma confirmação e não há janela nem terminal para perguntar."
            return 1
        fi
    fi

    script="$(t_script_instalacao "${codigos[@]}")"
    t_diz "preparar: instalando ${codigos[*]}"
    t_progresso_abre "Instalando o que falta. Pode demorar bastante - não desligue o computador."
    t_como_root "$script" >>"$LOG" 2>&1
    c=$?
    t_progresso_fecha

    if [ "$c" -eq 127 ]; then
        t_erro "Não consegui pedir a sua senha para instalar.

Abra o Terminal e execute:  sudo tandem preparar"
        return 1
    fi
    if [ "$c" -ne 0 ]; then
        t_erro "A instalação não terminou bem. Veja o que faltou com:

tandem doctor"
        return 1
    fi
    # The install-time question, asked at the only moment where a dialog is
    # possible. It cannot be asked from the postinst: dpkg holds a lock while
    # that runs, and a window waiting for a click there would hang apt until
    # somebody noticed and clicked - the same reason "preparar" exists as a
    # separate command at all.
    #
    # Asked here without a concrete line to show, so it describes rather than
    # displays. If the owner skips it, the question comes back once with the
    # real line, the first time a program of his actually works.
    if ! t_envio_decidido; then
        if t_pergunta "Uma última coisa, e é a única que sai desta máquina.

Quando você confirma que um programa funcionou, o Tandem aprende o que ele
precisava. Posso mandar essa lição para a lista da comunidade?

Vai UMA LINHA por programa: uma impressão digital do arquivo do programa, 32 ou
64 bits, e quais componentes resolveram. Nada mais.

NÃO vai: nome de arquivo, pasta, seu nome de usuário, o nome do computador,
endereço de rede, nem uma linha de registro.

Para que serve: quem instalar o mesmo programa depois já encontra a resposta
pronta, em vez de esperar o Tandem descobrir de novo.

Você pode mudar quando quiser:  tandem enviar sim   /   tandem enviar nao" \
                       "Pode mandar" "Não mandar"; then
            t_envio_define sim
            t_ok "Obrigado. Você pode ver o que sai com:  tandem enviar"
        else
            t_envio_define nao
            t_diz "envio recusado no preparar"
        fi
    fi

    t_ok "Tudo pronto. Confira com: tandem doctor"
    return 0
}

# Picks one item from a list of names. Returns the chosen name.
# One column only, on purpose: the hidden-column options changed between
# zenity versions, and it is not worth depending on them.
escolher() {
    local titulo="$1" pergunta="$2"; shift 2
    if t_tem_gui && command -v zenity >/dev/null 2>&1; then
        zenity --list --title="$titulo" --text="$pergunta" \
               --width=520 --height=400 --column="Programa" "$@" 2>/dev/null
        return $?
    fi
    return 1
}

# ---------------------------------------------------------------- programas
#
# The system menu is not a reliable way back to the installed program: under
# Wayland, GNOME only re-reads the application list after you log out and log
# back in, and until then the installed program simply does not exist for the
# user. Tandem knows what it installed, so it shows and opens them itself.
acao_programas() {
    local filtro="${1:-}" d nome escolha achou="" nomes=()
    # Windows shortcuts and AppImage entries in the same list. For the owner
    # they are the same thing - a program he installed with Tandem - and the
    # reason this command exists applies to both: on Wayland, GNOME does not
    # re-read the application list, so a program he cannot find again is a
    # program he has not installed.
    local lista; lista="$(t_atalhos_nossos; t_atalhos_appimage)"
    lista="$(printf '%s\n' "$lista" | grep -v '^$')"
    if [ -z "$lista" ]; then
        t_erro "Nenhum programa instalado pelo Tandem por enquanto.

Programas do Windows que não criam atalho no Menu Iniciar não aparecem aqui."
        return 1
    fi

    if [ -n "$filtro" ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            nome="$(t_nome_do_atalho "$d")"
            case "${nome,,}" in *"${filtro,,}"*) achou="$d"; break ;; esac
        done <<< "$lista"
        [ -n "$achou" ] || { t_erro "Não achei nenhum programa com \"$filtro\" no nome."; return 1; }
        setsid gio launch "$achou" >/dev/null 2>&1 &
        t_ok "Abrindo $(t_nome_do_atalho "$achou")..."
        return 0
    fi

    while IFS= read -r d; do
        [ -n "$d" ] || continue
        nomes+=("$(t_nome_do_atalho "$d")")
    done <<< "$lista"

    # With no window (terminal, SSH), the list comes out as text. "escolher"
    # returns empty both on Cancel and when zenity is missing; in the first
    # case the listing is harmless, in the second it is the only path left.
    escolha="$(escolher "Tandem - Programas instalados" \
                        "Qual programa você quer abrir?" "${nomes[@]}")"
    if [ -z "$escolha" ]; then
        printf 'Programas instalados pelo Tandem:\n\n'
        printf '  %s\n' "${nomes[@]}"
        printf '\nPara abrir um deles:  tandem programas "<parte do nome>"\n'
        return 0
    fi
    acao_programas "$escolha"
}

# ------------------------------------------------------------- desinstalar
#
# The target user does not know how to use Wine, and has no reason to. Without
# this the only path was "WINEPREFIX=... wine uninstaller", which is exactly
# the kind of thing this project exists so as not to demand of anyone.
acao_uninstall() {
    local filtro="${1:-}" pref="$TANDEM_PREFIXO_PADRAO" lista linha nome
    local escolha achou="" nomes=() silencioso normal

    [ -f "$pref/system.reg" ] || {
        t_erro "Nenhum programa do Windows foi instalado pelo Tandem ainda."; return 1; }

    # Uninstalling changes the prefix, so it only holds for ours. A
    # third-party prefix - the point-of-sale system's, for example - is
    # untouchable.
    export WINEPREFIX="$pref"
    lista="$(t_uninstall_dump "$pref")"
    if [ -z "$lista" ]; then
        t_erro "Não encontrei nenhum programa do Windows para remover.

Programas que não trazem desinstalador próprio não aparecem nesta lista."
        return 1
    fi

    while IFS= read -r linha; do
        [ -n "$linha" ] || continue
        nome="${linha#*|||}"; nomes+=("${nome%%|||*}")
    done <<< "$lista"

    if [ -z "$filtro" ]; then
        escolha="$(escolher "Tandem - Remover programa" \
                            "Qual programa você quer remover?" "${nomes[@]}")"
        if [ -z "$escolha" ]; then
            printf 'Programas do Windows que podem ser removidos:\n\n'
            printf '  %s\n' "${nomes[@]}"
            printf '\nPara remover:  tandem desinstalar "<parte do nome>"\n'
            return 0
        fi
        filtro="$escolha"
    fi

    while IFS= read -r linha; do
        [ -n "$linha" ] || continue
        nome="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $2}')"
        case "${nome,,}" in
            *"${filtro,,}"*)
                achou="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $1}')"
                silencioso="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $3}')"
                normal="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $4}')"
                break ;;
        esac
    done <<< "$lista"
    [ -n "$achou" ] || { t_erro "Não achei nenhum programa com \"$filtro\" no nome."; return 1; }
    command -v wine >/dev/null 2>&1 || { t_erro "O Wine não está instalado."; return 1; }

    # Confirmation: a window; failing that, the terminal; with neither, it
    # refuses SAYING why - removing a program with nobody confirming is a
    # risk, and giving up silently is a defect.
    if ! t_pergunta "Remover este programa do Windows?

$nome

Os arquivos dele serão apagados." "Remover" "Cancelar"; then
        if [ -t 0 ]; then
            printf 'Remover "%s"? Os arquivos dele serão apagados. [s/N] ' "$nome"
            read -r r
            case "$r" in s|S|sim|SIM) ;; *) echo "Cancelado."; return 1 ;; esac
        else
            t_erro "Não removi $nome: preciso de uma confirmação e não há janela nem terminal para perguntar."
            return 1
        fi
    fi

    # The program's uninstaller wipes its whole folder - and in Brazilian
    # commercial software the database usually lives right in there, next to
    # the executable. The owner confirmed removing the PROGRAM; nobody asked
    # whether he wanted to lose the records. The copy is made first, always.
    local resgate
    local c_resgate
    resgate="$(t_dados_resgate "$TANDEM_PREFIXO_PADRAO" antes-de-remover)"; c_resgate=$?
    case $c_resgate in
        0) t_aviso "Antes de remover, guardei uma cópia dos seus arquivos em:
$resgate" ;;
        1) t_pergunta "$(t_texto_resgate_falhou)

Remover mesmo assim?" "Remover assim mesmo" "Parar" || return 1 ;;
    esac

    # We prefer the silent uninstaller, which the program itself declares in
    # the registry. Without it, we run the normal uninstaller: it opens the
    # program's own window and the user confirms there - honest, even if in
    # English.
    local c
    if [ -n "$silencioso" ]; then
        t_progresso_abre "Removendo $nome..."
        t_diz ">>> $silencioso"
        t_executa_comando_windows "$silencioso" >>"$LOG" 2>&1
        c=$?
        wineserver -w 2>/dev/null
        t_progresso_fecha
    else
        t_aviso "Vai abrir a janela de remoção do próprio $nome. Confirme por lá."
        t_diz ">>> $normal"
        t_executa_comando_windows "$normal" >>"$LOG" 2>&1
        c=$?
        wineserver -w 2>/dev/null
    fi

    local orfaos; orfaos="$(t_limpa_atalhos_orfaos)"
    t_diz "desinstalar $nome: codigo $c, $orfaos atalho(s) orfao(s) removido(s)"

    # The acid test is the registry: did the key disappear?
    if t_uninstall_dump "$pref" | grep -qF -- "$achou|||"; then
        t_erro "Não consegui remover $nome.

O desinstalador do programa não completou. Tente de novo, ou remova pela janela do próprio programa."
        return 1
    fi
    t_ok "$nome foi removido."
    return 0
}

# ------------------------------------------------------------- alternativas
#
# The owner asks; Tandem answers with what it knows, and says plainly when it
# does not know. It never swaps anything, never insists, and never suggests
# replacing a program that is working.
acao_alternativas() {
    local nome="${1:-}" texto
    if [ -z "$nome" ]; then
        t_erro "Diga o nome do programa.

Exemplo:  tandem alternativas photoshop"
        return 1
    fi
    # Accepts both "photoshop" and the path to a .exe.
    [ -f "$nome" ] && nome="$(basename -- "${nome%.*}")"

    if texto="$(t_texto_alternativas "$nome")"; then
        printf 'Programas de Linux que fazem o trabalho de "%s":\n%s\n' "$nome" "$texto" |
            t_texto "Tandem - Alternativas para $nome"
        return 0
    fi

    t_erro "Não conheço alternativa de Linux para \"$nome\".

Isso não quer dizer que não exista — quer dizer que ainda não está na minha lista.
Se você encontrar uma, ela pode ser acrescentada em uma linha."
    return 1
}

# -------------------------------------------------------------- autoteste
#
# The "doctor" LISTS: it says zenity is installed, that the locale exists,
# that Wine answers. That is weak evidence - it proves the part is there, not
# that it works.
#
# Five defects found in the field were invisible to a listing and visible to
# an exercise:
#   - zenity installed, but refusing every accented text (missing locale)
#   - the progress pipe existing, but killing the process when written to
#   - the lock configured, but impossible to create
#   - the doctor working in the terminal, but writing zero bytes to a file
#   - the error being "shown" in a window that never opened
#
# The self-test EXERCISES. Each check runs the real thing and looks at the
# result. Where the exercise is not possible without the owner watching, it
# asks.
acao_autoteste() {
    local ok=0 falhou=0 saida="" tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf -- "$tmp"' RETURN

    passa() { ok=$((ok+1));     saida="$saida  PASSA   $1"$'\n'; }
    falha() { falhou=$((falhou+1)); saida="$saida  FALHA   $1"$'\n         '"$2"$'\n'; }

    # 1. Does the error message reach SOMEWHERE? Without this, all the rest of
    #    the diagnosis is useless: the owner would never learn of the problem.
    if [ -n "$(t_erro "autoteste: ignore esta mensagem" 2>&1 1>/dev/null)" ] || t_tem_gui; then
        passa "as mensagens de erro têm para onde ir"
    else
        falha "as mensagens de erro somem" "sem janela e sem terminal, um erro daqui não chega a ninguém"
    fi

    # 2. Does accented text survive? This is the defect that wiped out the
    #    whole interface on a real machine, and no listing would catch it.
    if [ "$(locale charmap 2>/dev/null)" = "UTF-8" ]; then
        passa "o sistema aceita texto com acento (charmap UTF-8)"
    else
        falha "o texto com acento não passa" "o locale em vigor não é UTF-8; as janelas do Tandem não vão abrir"
    fi

    # 3. Can the diagnosis be written to a file? If not, the owner has no way
    #    to send it to anyone.
    if ( "$0" version > "$tmp/redir.txt" 2>/dev/null ) && [ -s "$tmp/redir.txt" ]; then
        passa "o diagnóstico pode ser gravado e enviado"
    else
        falha "o diagnóstico não pode ser enviado" "gravar em arquivo produziu zero byte"
    fi

    # 4. Can the double-click lock be created? If not, the double click stops
    #    working - and silently, which is what happened.
    if ( exec 7> "$TANDEM_TRAVAS/autoteste.lock" ) 2>/dev/null &&
       rm -f "$TANDEM_TRAVAS/autoteste.lock" 2>/dev/null; then
        passa "a trava do duplo clique pode ser criada ($TANDEM_TRAVAS)"
    else
        falha "a trava não pode ser criada" "em $TANDEM_TRAVAS — disco cheio, sem permissão, ou pasta em rede"
    fi

    # 5. Does the progress bar survive the window vanishing? Really exercised:
    #    open it, kill the reader, write. This used to kill Tandem with 141.
    if t_tem_gui && command -v zenity >/dev/null 2>&1; then
        ( t_progresso_abre "autoteste"; kill "${TANDEM_PROG_PID:-0}" 2>/dev/null
          sleep 0.3; t_progresso_texto "depois de fechada"; t_progresso_fecha ) >/dev/null 2>&1
        if [ $? -lt 128 ]; then
            passa "fechar a janela de progresso não derruba o Tandem"
        else
            falha "fechar a janela de progresso derruba o Tandem" "o processo recebeu um sinal em vez de continuar"
        fi
    else
        saida="$saida  --      barra de progresso (sem sessão gráfica para exercitar)"$'\n'
    fi

    # 6. Does the PE reader work on this machine? Exercised against a real
    #    Windows binary, if there is one at hand in the prefix.
    local umexe
    umexe="$(find "$TANDEM_PREFIXO_PADRAO/drive_c" -name '*.exe' -size -20M 2>/dev/null | head -1)"
    if [ -n "$umexe" ]; then
        if [ -n "$(python3 "$TANDEM_LIB/peinfo.py" "$umexe" 2>/dev/null | sed -n 's/^ARQUITETURA=//p')" ]; then
            passa "o pré-voo lê um programa Windows de verdade"
        else
            falha "o pré-voo não conseguiu ler um programa" "$umexe"
        fi
    else
        saida="$saida  --      pré-voo do PE (nenhum programa Windows instalado ainda)"$'\n'
    fi

    # 7. Do the associations point at Tandem? That is what makes the double
    #    click arrive here; without it the rest does not matter.
    if command -v xdg-mime >/dev/null 2>&1; then
        local dono par
        # One line per format, because they are disputed by different rivals:
        # Zorin's "Windows App Support" wants the .exe, Waydroid wants the .apk,
        # the system's own Java launcher wants the .jar, and an AppImage usually
        # has no owner at all - which is precisely why it does nothing when
        # clicked.
        for par in "application/x-ms-dos-executable|.exe|tandem-exe.desktop" \
                   "application/vnd.android.package-archive|.apk|tandem-apk.desktop" \
                   "application/vnd.appimage|.AppImage|tandem-appimage.desktop" \
                   "application/java-archive|.jar|tandem-jar.desktop" \
                   "application/vnd.debian.binary-package|.deb|tandem-deb.desktop" \
                   "application/x-rpm|.rpm|tandem-rpm.desktop" \
                   "application/vnd.flatpak.ref|.flatpakref|tandem-flatpak.desktop" \
                   "application/vnd.snap|.snap|tandem-snap.desktop"; do
            dono="$(xdg-mime query default "${par%%|*}" 2>/dev/null)"
            if [ "$dono" = "${par##*|}" ]; then
                passa "o duplo clique num $(printf '%s' "$par" | cut -d'|' -f2) vem para o Tandem"
            else
                falha "o duplo clique num $(printf '%s' "$par" | cut -d'|' -f2) não vem para o Tandem" \
                      "quem responde é: ${dono:-ninguém} — rode: tandem repair"
            fi
        done
    fi

    # 8. Does the AppImage reader work on this machine? Exercised against a
    #    header written here and now, so it needs no file and no network: the
    #    twenty bytes that decide everything are the ones being read.
    {
        printf '\177ELF\002\001\001\000AI\002\000\000\000\000\000\003\000>\000'
        head -c 44 /dev/zero
    } > "$tmp/falso.AppImage" 2>/dev/null
    local lido; lido="$(t_appimage_info "$tmp/falso.AppImage" 2>/dev/null)"
    if [ "$(t_campo "$lido" TIPO)" = 2 ] &&
       [ "$(t_campo "$lido" ARQUITETURA)" = x86_64 ]; then
        passa "o pré-voo do AppImage lê tipo e processador"
    else
        falha "o pré-voo do AppImage não leu o cabeçalho" "${lido:-nenhuma resposta} — o python3 desta máquina pode estar quebrado"
    fi

    # 9. Does the jar reader work? Against a real .jar, if this machine has one
    #    - the Java packages of the distribution all ship them.
    local umjar
    umjar="$(find "$TANDEM_PREFIXO_PADRAO" /usr/share/java /usr/lib/jvm \
                  "$HOME/Downloads" -maxdepth 4 -name '*.jar' -size -50M \
                  2>/dev/null | head -1)"
    if [ -n "$umjar" ]; then
        if [ -n "$(t_campo "$(t_jar_info "$umjar")" MAIOR)" ]; then
            passa "o pré-voo do Java lê um .jar de verdade"
        else
            falha "o pré-voo do Java não conseguiu ler um .jar" "$umjar"
        fi
    else
        saida="$saida  --      pré-voo do Java (nenhum .jar nesta máquina para exercitar)"$'\n'
    fi

    # 10. The .deb reader, on a package written here and now. Every current
    #     Ubuntu package uses control.tar.zst, which Python cannot read on its
    #     own - it goes through libzstd by hand - so this is the check that would
    #     notice a machine where that route is unavailable.
    if [ -f "$TANDEM_LIB/../../tests/mkdeb.py" ] || command -v dpkg-deb >/dev/null 2>&1; then
        local umdeb
        umdeb="$(find /var/cache/apt/archives "$HOME/Downloads" -maxdepth 1 \
                      -name '*.deb' -size -80M 2>/dev/null | head -1)"
        if [ -n "$umdeb" ]; then
            local lido_deb; lido_deb="$(t_deb_info "$umdeb")"
            if [ -n "$(t_campo "$lido_deb" PACOTE)" ]; then
                passa "o pré-voo lê um pacote .deb de verdade ($(t_campo "$lido_deb" PACOTE))"
            else
                falha "o pré-voo não conseguiu ler um .deb" \
                      "$umdeb: $(t_campo "$lido_deb" ERRO)"
            fi
        else
            saida="$saida  --      pré-voo do .deb (nenhum pacote nesta máquina para exercitar)"$'\n'
        fi
    fi

    # 11. Can apt answer WITHOUT root? The whole .deb diagnosis rests on it:
    #     if this fails, the owner gets asked for a password only to be told no.
    if command -v apt-get >/dev/null 2>&1; then
        if t_apt_simula /bin/true 2>&1 | grep -qiE 'Reading package lists|E: |Unable'; then
            passa "o apt responde sem senha (o diagnóstico vem antes de pedi-la)"
        else
            falha "o apt não respondeu sem senha" \
                  "sem isso o dono digita a senha só para ouvir não"
        fi
    fi

    # 12. Java is not required for Tandem to work, but if it IS here its version
    #     has to be readable - the whole "needs a newer Java" diagnosis hangs on
    #     that one number, and Java writes it two different ways.
    if command -v java >/dev/null 2>&1; then
        local jv; jv="$(t_java_versao)"
        case "$jv" in
            ''|*[!0-9]*) falha "não consegui ler a versão do Java" "java -version respondeu: $(java -version 2>&1 | head -1)" ;;
            *)           passa "a versão do Java foi reconhecida ($jv)" ;;
        esac
    else
        saida="$saida  --      versão do Java (Java não instalado)"$'\n'
    fi

    # 13. Is the protection of other people's prefixes in force? It exercises
    #    the decision, not the list: it asks the code what it would do.
    local alheio protegidos=0 desprotegidos=""
    while IFS= read -r alheio; do
        [ -n "$alheio" ] || continue
        if t_prefixo_protegido "$alheio"; then protegidos=$((protegidos+1))
        else desprotegidos="$desprotegidos $alheio"; fi
    done <<< "$(t_atalhos_wine >/dev/null 2>&1; grep -v '^$' "$TANDEM_PROTEGIDOS" 2>/dev/null)"
    if [ -n "$desprotegidos" ]; then
        falha "um perfil da lista não está sendo protegido" "$desprotegidos"
    elif [ "$protegidos" -gt 0 ]; then
        passa "os $protegidos perfil(is) da sua lista são recusados pela automação"
    else
        saida="$saida  --      proteção de perfis (nenhum perfil de terceiro nesta máquina)"$'\n'
    fi

    printf 'Tandem %s — autoteste nesta máquina\n\n%s\n%d passaram, %d falharam.\n%s\n' \
        "$VERSAO" "$saida" "$ok" "$falhou" \
        "$([ "$falhou" -gt 0 ] && printf 'Cada FALHA acima é uma coisa que não vai funcionar quando você precisar.' \
                                || printf 'O Tandem exercitou o que dava para exercitar aqui, e tudo respondeu.')" |
        t_texto "Tandem - Autoteste"
    [ "$falhou" -eq 0 ]
}

# -------------------------------------------------------------- receitas
#
# Collective knowledge with no server: a program's memory becomes a text file
# that the owner sends to another person. Pull only, never push - Tandem reads
# recipes and never sends anything anywhere.
acao_receita() {
    if [ "${1:-}" = "--importar" ]; then
        local rec="${2:-}" prog="${3:-}"
        [ -n "$rec" ] && [ -n "$prog" ] || {
            t_erro "Uso:  tandem receita --importar <receita.txt> <programa.exe>"; return 1; }
        [ -f "$prog" ] || { t_erro "Não achei o programa: $prog"; return 1; }
        t_receita_importa "$rec" "$prog"
        case $? in
            0) t_ok "Receita aplicada.

O Tandem agora sabe o que este programa pediu na máquina de quem mandou.
Ele vai PERGUNTAR antes de instalar qualquer coisa — receita não é ordem."
               return 0 ;;
            2) t_erro "Este arquivo não é uma receita do Tandem." ;;
            3) t_erro "Esta receita é de outro programa, ou de outra versão dele.

Aplicar ensinaria a lição errada, então não apliquei." ;;
            4) t_erro "Recusei a receita: ela traz um nome de componente suspeito.

Receita vinda de fora não pode mandar o Tandem executar nada." ;;
            *) t_erro "Não consegui ler esta receita." ;;
        esac
        return 1
    fi

    local prog="${1:-}"
    [ -n "$prog" ] || { t_erro "Diga qual programa.

Exemplo:  tandem receita ~/Downloads/sistema.exe"; return 1; }
    [ -f "$prog" ] || { t_erro "Não achei o programa: $prog"; return 1; }
    # Warn BEFOREHAND, on the error output, so as not to dirty the recipe that
    # goes out on stdout and is usually redirected into a file.
    case "$(t_confianca_da_licao "$prog")" in
        reprovado)
            t_aviso "Atenção: você disse que este programa NÃO funcionou direito aqui.
A receita vai sair marcada assim. Pense duas vezes antes de mandar para alguém." ;;
        so-abriu)
            t_aviso "Esta receita vale o que vale: o programa abriu sem erro, mas ninguém
confirmou que funcionou de verdade. Ela sai marcada como \"so-abriu\"." ;;
    esac
    if ! t_receita_exporta "$prog"; then
        t_erro "Ainda não aprendi nada sobre este programa.

Abra ele uma vez pelo Tandem e a receita se forma sozinha."
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------ memoria
#
# What Tandem has learned, in text the owner can read. There is no secret
# memory: if he cannot SEE what was stored, he has no way to trust it and no
# way to correct it.
acao_memoria() {
    local filtro="${1:-}" arq prog saida="" n=0
    if [ ! -d "$TANDEM_MEMORIA" ] || [ -z "$(ls -A "$TANDEM_MEMORIA" 2>/dev/null)" ]; then
        t_erro "O Tandem ainda não aprendeu nada.

A memória se forma sozinha conforme você usa os programas."
        return 1
    fi
    for arq in "$TANDEM_MEMORIA"/*.txt; do
        [ -f "$arq" ] || continue
        prog="$(sed -n 's/^PROGRAMA=//p' "$arq" | head -1)"
        [ -n "$filtro" ] && case "${prog,,}" in *"${filtro,,}"*) ;; *) continue ;; esac
        n=$((n+1))
        saida="$saida$prog"$'\n'
        saida="$saida$(sed -n 's/^RESULTADO=/  resultado:  /p;
                              s/^ARQUITETURA=/  arquitetura: /p;
                              s/^RESOLVERAM=/  resolveram: /p;
                              s/^NAO_RESOLVERAM=/  não resolveram: /p;
                              s/^SEGUNDOS=/  levou (s): /p;
                              s/^VISTO_EM=/  visto em:   /p;
                              s/^LIMITE=/  limite:     /p' "$arq")"$'\n\n'
    done
    [ "$n" -gt 0 ] || { t_erro "Não achei nada aprendido sobre \"$filtro\"."; return 1; }
    printf '%s' "$saida" | t_texto "Tandem - O que eu aprendi"
}

acao_esquecer() {
    local filtro="${1:-}" arq prog n=0
    [ -n "$filtro" ] || { t_erro "Diga o nome do programa a esquecer."; return 1; }
    for arq in "$TANDEM_MEMORIA"/*.txt; do
        [ -f "$arq" ] || continue
        prog="$(sed -n 's/^PROGRAMA=//p' "$arq" | head -1)"
        case "${prog,,}" in *"${filtro,,}"*) rm -f -- "$arq"; n=$((n+1)) ;; esac
    done
    [ "$n" -gt 0 ] || { t_erro "Não achei nada aprendido sobre \"$filtro\"."; return 1; }
    t_ok "Esqueci o que sabia sobre $n programa(s). Da próxima vez ele descobre de novo."
}

# ------------------------------------------------------ identity and ports
#
# Both are pure diagnosis: they read /sys, /proc and system.reg, start no
# Wine, ask for no password and change nothing unless asked to in so many
# words. They exist because the two questions they answer - "which of my
# machine's numbers did the program see?" and "which COM did my pinpad get?" -
# had no answer at all before, and the owner met them as "activate again" and
# "the printer is not there".
acao_identidade() {
    t_texto_identidade "$TANDEM_PREFIXO_PADRAO" | t_texto "Tandem - identidade da máquina"
}

acao_portas() {
    local p="$TANDEM_PREFIXO_PADRAO"
    case "${1:-}" in
        fixar|prender)
            local porta="${2:-}" caminho="${3:-}"
            case "$porta" in
                COM[0-9]|COM[0-9][0-9]|LPT[0-9]) ;;
                *) t_erro "Diga qual porta, assim:

tandem portas fixar COM2 /dev/ttyACM0"; return 1 ;;
            esac
            [ -e "$caminho" ] || { t_erro "Não existe nenhum aparelho em:
$caminho"; return 1; }
            [ -f "$p/system.reg" ] || { t_erro "Ainda não há um ambiente Windows aqui.

Abra um programa .exe uma vez e ele é criado."; return 1; }
            # Rule number 1: this writes into a prefix, so it may only ever be
            # one of ours.
            if t_prefixo_protegido "$p"; then
                t_erro "Este ambiente Windows não foi criado pelo Tandem, então ele não mexe aqui."
                return 1
            fi
            if WINEPREFIX="$p" WINEDEBUG=-all wine reg add 'HKLM\Software\Wine\Ports' \
                 /v "$porta" /t REG_SZ /d "$caminho" /f >>"$LOG" 2>&1; then
                t_ok "Pronto: $caminho agora é a $porta para os programas Windows.

Abra o programa de novo e escolha a $porta na configuração dele."
            else
                t_erro "Não consegui prender a porta. Veja: tandem logs"
                return 1
            fi ;;
        soltar|liberar)
            local porta="${2:-}"
            [ -n "$porta" ] || { t_erro "Diga qual porta soltar. Exemplo: tandem portas soltar COM2"; return 1; }
            WINEPREFIX="$p" WINEDEBUG=-all wine reg delete 'HKLM\Software\Wine\Ports' \
                /v "$porta" /f >>"$LOG" 2>&1
            t_ok "A $porta voltou a ser escolhida sozinha pelo Wine." ;;
        ""|ver|listar)
            t_texto_portas "$p" | t_texto "Tandem - portas dos aparelhos" ;;
        *)
            t_erro "Não conheço \"$1\".

tandem portas                        mostra as portas
tandem portas fixar COM2 /dev/ttyACM0   prende um aparelho numa porta
tandem portas soltar COM2               desfaz"
            return 1 ;;
    esac
}

acao_logs() {
    local l; l="$(ls -1t "$TANDEM_ESTADO"/*.log 2>/dev/null | head -1)"
    [ -n "$l" ] || { t_erro "Ainda não há registros."; return 1; }
    tail -n 400 "$l" | t_texto "Tandem - $(basename "$l")"
}

# ----------------------------------------------------------------- lista
#
# The owner's idea, and it is a good one: instead of a bridge server between
# all the Tandems, a FILE that each installation downloads - the ad-blocker
# filter-list model. See docs/LIST-FORMAT.md.
acao_lista() {
    case "${1:-ver}" in
        atualizar|baixar|sincronizar)
            t_progresso_abre "Baixando a lista da comunidade..."
            t_lista_atualiza; local c=$?
            t_progresso_fecha
            case $c in
                0) t_ok "Lista atualizada: $(grep -vc '^#' "$TANDEM_LISTA" 2>/dev/null) programas conhecidos.

Isso não instala nada. Quando você abrir um programa que está na lista,
o Tandem vai PERGUNTAR se quer usar o que já funcionou para outras pessoas." ;;
                1) t_erro "Não consegui baixar a lista. Verifique a internet." ;;
                3) t_erro "O arquivo baixado não é uma lista do Tandem. Não usei." ;;
                4) t_erro "A lista ainda não foi publicada.

Isso não é problema da sua internet nem da sua máquina: o arquivo ainda
não existe no endereço onde o Tandem procura. O resto continua
funcionando normalmente." ;;
                *) t_erro "Falta o curl ou o wget para baixar a lista." ;;
            esac
            return $c ;;
        ver|"")
            if [ ! -f "$TANDEM_LISTA" ]; then
                printf '%s\n' "Lista da comunidade

Você ainda não baixou a lista.

Ela é um arquivo de texto público com o que já deu certo na máquina de
outras pessoas: quais componentes do Windows cada programa precisou.
Baixar não manda nada seu para lugar nenhum.

Para baixar:   tandem lista atualizar" | t_texto "Tandem - Lista da comunidade"
                return 1
            fi
            printf '%s\n' "Lista da comunidade

$(grep -vc '^#' "$TANDEM_LISTA") programas conhecidos.
Arquivo: $TANDEM_LISTA

$(head -1 "$TANDEM_LISTA")" | t_texto "Tandem - Lista da comunidade"
            return 0 ;;
        *) t_erro "Use:  tandem lista  |  tandem lista atualizar"; return 1 ;;
    esac
}

# Assembles the record for the owner to check and send. It sends NOTHING: a
# shop's machine does not talk to any server by decision of an automation.
acao_contribuir() {
    local prog="${1:-}" reg
    [ -n "$prog" ] || { t_erro "Diga qual programa.

Exemplo:  tandem contribuir ~/Downloads/sistema.exe"; return 1; }
    [ -f "$prog" ] || { t_erro "Não achei o programa: $prog"; return 1; }
    reg="$(t_lista_registro "$prog")" || {
        t_erro "Ainda não aprendi nada útil sobre este programa.

Abra ele pelo Tandem primeiro. Se ele já abriu, responda a pergunta
\"funcionou como você esperava?\" - é ela que dá valor à lição."
        return 1; }

    printf '%s\n' "Contribuir com a lista da comunidade

Esta é a linha inteira que sai daqui. Não tem mais nada:

$reg

O que cada pedaço quer dizer:
  1. uma impressão digital DO ARQUIVO (tamanho + começo + fim). A mesma
     em qualquer máquina do mundo que tenha esse mesmo arquivo. Não dá
     para voltar dela para o arquivo, nem para você.
  2. 32 ou 64 bits, lido do próprio programa.
  3. os componentes do Windows que resolveram.
  4. os que foram instalados e não resolveram.
  5. se você confirmou que funcionou, ou só que abriu sem erro.
  6. contagem de máquinas (aqui é sempre 1; quem junta é a lista).
  7. ano e mês. Sem o dia, porque dia identifica.

NÃO vai daqui: nome de arquivo, pasta, seu nome de usuário, o nome do
computador, endereço de rede, nem uma linha de log.

Copie a linha acima e mande para:
https://github.com/ChrnX0/Tandem/issues" | t_texto "Tandem - Contribuir"

    # Copying a line off a screen, opening a browser, creating an account and
    # pasting it into an issue form is five steps, and lista/lista.tsv being
    # empty is the measurement of how many people take them. These two shortcuts
    # need no server: the clipboard, and a form that arrives already filled in.
    if t_tem_gui; then
        if command -v xclip >/dev/null 2>&1; then
            printf '%s' "$reg" | xclip -selection clipboard 2>/dev/null &&
                t_ok "A linha já está copiada. Basta colar."
        elif command -v wl-copy >/dev/null 2>&1; then
            printf '%s' "$reg" | wl-copy 2>/dev/null &&
                t_ok "A linha já está copiada. Basta colar."
        fi
        if command -v xdg-open >/dev/null 2>&1 &&
           t_pergunta "Quer que eu abra o formulário já preenchido com esta linha?

Você ainda confere e envia - o Tandem não manda nada sozinho por aqui.

Se preferir que ele mande sozinho de agora em diante, é outra coisa:
tandem enviar sim" "Abrir o formulário" "Não, obrigado"; then
            setsid xdg-open "https://github.com/ChrnX0/Tandem/issues/new?template=list.yml&linha=$(t_url_escapa "$reg")" \
                >/dev/null 2>&1 &
        fi
    fi

    # And the offer that removes the five steps for good.
    if ! t_envio_decidido && t_tem_gui; then
        t_aviso "Se quiser, o Tandem pode mandar isso sozinho da próxima vez:
tandem enviar sim"
    fi
    return 0
}

# ----------------------------------------------------------------- enviar
#
# The switch the owner controls. It exists as its own command and not only as a
# dialog because a decision he cannot find again is not a decision he made - and
# because the honest place to tell him the queue is not going anywhere yet is
# here, in plain sight, rather than in a comment in the source.
acao_enviar() {
    local sub="${1:-}" fila
    case "$sub" in
        sim|ligar|on)
            t_envio_define sim
            t_ok "Ligado. O Tandem vai mandar a linha padronizada quando você confirmar
que um programa funcionou.

Para desligar:  tandem enviar nao"
            acao_enviar agora >/dev/null 2>&1
            return 0 ;;
        nao|não|desligar|off)
            t_envio_define nao
            t_ok "Desligado. Nada sai desta máquina.

O que já estava na fila continua guardado e não é enviado. Para apagar a fila:
rm \"$TANDEM_FILA\""
            return 0 ;;
        agora|flush)
            if ! t_envio_ligado; then
                t_erro "O envio está desligado. Para ligar:  tandem enviar sim"
                return 1
            fi
            if [ -z "$TANDEM_LISTA_ENVIO" ]; then
                t_erro "Não há endereço para onde mandar nesta versão do Tandem.

As linhas ficam guardadas na fila e vão junto quando existir um endereço.
Nada é perdido, e nada é enviado."
                return 1
            fi
            local n; n="$(t_envio_envia)"
            t_ok "${n:-0} linha(s) enviada(s). Restam $(t_envio_pendentes) na fila."
            return 0 ;;
        ''|status|ver) ;;
        *) t_erro "Não conheço \"tandem enviar $sub\".

Use:  tandem enviar | tandem enviar sim | tandem enviar nao | tandem enviar agora"
           return 1 ;;
    esac

    fila="$(t_envio_pendentes)"
    {
        printf 'Mandar o que o Tandem aprende para a lista da comunidade\n\n'
        if t_envio_ligado; then
            printf 'Agora está: LIGADO   (desde %s)\n' "$(t_config_le ENVIAR_DESDE 2>/dev/null || echo '?')"
        elif t_envio_decidido; then
            printf 'Agora está: DESLIGADO   (você escolheu em %s)\n' \
                   "$(t_config_le ENVIAR_DESDE 2>/dev/null || echo '?')"
        else
            printf 'Agora está: DESLIGADO   (ninguém decidiu ainda)\n'
        fi
        printf 'Linhas guardadas na fila: %s\n' "$fila"
        if [ -n "$TANDEM_LISTA_ENVIO" ]; then
            printf 'Endereço de envio: %s\n' "$TANDEM_LISTA_ENVIO"
        else
            printf 'Endereço de envio: NÃO EXISTE nesta versão.\n'
            printf '  As linhas ficam na fila e vão junto quando existir um. Enquanto isso,\n'
            printf '  nada sai desta máquina - nem se estiver ligado.\n'
        fi
        printf '\nO que sai, quando sai: uma linha de oito pedaços por programa, e só depois\n'
        printf 'que VOCÊ confirmar que o programa funcionou. Veja a linha de um programa\n'
        printf 'com:  tandem contribuir <arquivo>\n\n'
        printf 'O que nunca sai: nome de arquivo, pasta, seu nome de usuário, o nome do\n'
        printf 'computador, endereço de rede, nem uma linha de registro. O filtro que\n'
        printf 'garante isso roda duas vezes: quando a linha é montada e outra vez na hora\n'
        printf 'de mandar.\n\n'
        printf 'Ligar:     tandem enviar sim\n'
        printf 'Desligar:  tandem enviar nao\n'
        printf 'Ver a fila inteira:  cat %s\n' "$TANDEM_FILA"
    } | t_texto "Tandem - Enviar para a lista"
    return 0
}

# ---------------------------------------------------------------- socorro
#
# Remote support today is someone dictating commands over the phone to a
# person who does not know where the Terminal is. This gathers everything
# whoever understands the thing is going to ask for into a single file, which
# the owner sends over WhatsApp and that is it.
#
# The file says on its first line what is inside it. It contains the owner's
# file paths, and a file path sometimes carries a customer's name - he is the
# one who decides to send it, but he only really decides if he knows what he
# is sending.
acao_socorro() {
    local arq l
    arq="$HOME/tandem-socorro-$(date +%F-%H%M).txt"
    {
        printf 'RELATÓRIO DO TANDEM\n'
        printf 'Gerado em %s\n\n' "$(date '+%d/%m/%Y às %H:%M')"
        printf 'O que tem aqui dentro: a versão do Tandem, o que está instalado\n'
        printf 'nesta máquina, os últimos registros técnicos e o que o Tandem\n'
        printf 'aprendeu sobre os programas. Os registros mostram CAMINHOS DE\n'
        printf 'ARQUIVO seus. Dê uma olhada antes de mandar para alguém.\n'
        printf '\n========================= DIAGNÓSTICO =========================\n\n'
        acao_doctor 2>&1
        printf '\n========================= AUTOTESTE ===========================\n\n'
        acao_autoteste 2>&1
        printf '\n===================== TRADUÇÕES SUSPEITAS =====================\n\n'
        if [ -s "$TANDEM_ESTADO/traducao-suspeita.tsv" ]; then
            cat "$TANDEM_ESTADO/traducao-suspeita.tsv"
        else
            printf '(nenhuma)\n'
        fi
        printf '\n======================== O QUE APRENDI ========================\n\n'
        acao_memoria 2>&1
        printf '\n====================== REGISTROS TÉCNICOS =====================\n'
        for l in "$TANDEM_ESTADO"/*.log; do
            [ -f "$l" ] || continue
            printf '\n--- %s (últimas 200 linhas) ---\n' "$(basename -- "$l")"
            tail -n 200 "$l"
        done
    } > "$arq" 2>/dev/null

    if [ -s "$arq" ]; then
        t_ok "Relatório pronto:

$arq

Mande este arquivo para quem estiver ajudando você. Ele tem tudo o que
essa pessoa vai perguntar - não precisa digitar nenhum comando.

Antes de mandar, dê uma olhada: ele mostra nomes e caminhos de arquivos
que estão nesta máquina."
        return 0
    fi
    t_erro "Não consegui gerar o relatório."
    return 1
}

acao_painel() {
    # With no graphical session the panel has no way to show up: display the
    # help instead of opening and closing an invisible window saying nothing.
    if ! t_tem_gui || ! command -v zenity >/dev/null 2>&1; then uso; return 0; fi
    local esc
    while :; do
        esc="$(zenity --list --title="Tandem" --width=520 --height=400 \
            --text="O que você quer fazer?" \
            --column="Ação" --column="Descrição" --hide-header \
            "instalar"  "Instalar ou abrir um arquivo (.exe .apk .AppImage .jar .deb)" \
            "preparar"  "Instalar o que falta (Wine, Java, Android...)" \
            "programas" "Abrir um programa já instalado" \
            "remover"   "Desinstalar um programa do Windows" \
            "android"   "Abrir a tela do Android" \
            "doctor"    "Ver o diagnóstico do ambiente" \
            "autoteste" "Testar de verdade se tudo funciona aqui" \
            "dados"     "Ver e copiar os SEUS arquivos" \
            "portas"    "Pinpad, balança, impressora: em que porta ficaram" \
            "identidade" "O que o programa vê da sua máquina (licença)" \
            "backup"    "Salvar o ambiente Windows" \
            "restore"   "Restaurar o ambiente Windows" \
            "repair"    "Consertar a abertura de arquivos com dois cliques" \
            "memoria"   "Ver o que o Tandem aprendeu sobre os programas" \
            "lista"     "Baixar o que a comunidade já descobriu" \
            "enviar"    "Mandar o que eu aprendo para a comunidade (liga/desliga)" \
            "socorro"   "Gerar um relatório para pedir ajuda" \
            "logs"      "Ver o registro técnico" \
            2>/dev/null)" || return 0
        case "$esc" in
            instalar)
                local f
                f="$(zenity --file-selection --title="Escolha o arquivo" \
                     --file-filter="Programas e apps | *.exe *.msi *.apk *.xapk *.apks *.apkm *.AppImage *.appimage *.jar *.deb *.rpm *.flatpakref *.snap *.sh *.run" \
                     --file-filter="Todos | *" 2>/dev/null)" || continue
                acao_install "$f" ;;
            preparar)  acao_preparar ;;
            programas) acao_programas ;;
            remover)   acao_uninstall ;;
            android)  setsid "$TANDEM_BIN"/tandem-android >/dev/null 2>&1 & ;;
            doctor)   acao_doctor ;;
            autoteste) acao_autoteste ;;
            dados)    acao_dados ;;
            portas)   acao_portas ;;
            identidade) acao_identidade ;;
            backup)   acao_backup ;;
            restore)  acao_restore ;;
            repair)   "$TANDEM_BIN"/tandem-repair ;;
            memoria)  acao_memoria ;;
            lista)    acao_lista atualizar ;;
            enviar)   acao_enviar ;;
            socorro)  acao_socorro ;;
            logs)     acao_logs ;;
            *)        return 0 ;;
        esac
    done
}

# ------------------------------------------------------------------ main
case "${1:-}" in
    ""|painel|panel)      acao_painel ;;
    install|instalar|abrir) shift; acao_install "$@" ;;
    preparar|setup)       acao_preparar ;;
    programas|apps)       shift; acao_programas "$@" ;;
    desinstalar|uninstall|remover) shift; acao_uninstall "$@" ;;
    android)              exec "$TANDEM_BIN"/tandem-android ;;
    doctor|diagnostico)   acao_doctor ;;
    autoteste|autotest)   acao_autoteste ;;
    repair|consertar)     exec "$TANDEM_BIN"/tandem-repair ;;
    dados|meus-dados)     shift; acao_dados "$@" ;;
    backup)               acao_backup ;;
    restore|restaurar)    acao_restore ;;
    protect|proteger)     shift; acao_protect "$@" ;;
    identidade|fingerprint) acao_identidade ;;
    portas|ports)         shift; acao_portas "$@" ;;
    alternativas|alternativa) shift; acao_alternativas "$@" ;;
    receita|receitas)     shift; acao_receita "$@" ;;
    memoria|memória)      shift; acao_memoria "$@" ;;
    esquecer|esqueca)     shift; acao_esquecer "$@" ;;
    lista)                shift; acao_lista "$@" ;;
    enviar|envio)         shift; acao_enviar "$@" ;;
    contribuir|contribuicao) shift; acao_contribuir "$@" ;;
    socorro|ajuda-tecnica) acao_socorro ;;
    logs|log)             acao_logs ;;
    # Internal use by postinst: already done in the t_primeira_vez call up
    # top. Kept out of the help on purpose.
    --primeira-vez)       : ;;
    version|--version|-v) echo "Tandem $VERSAO" ;;
    help|--help|-h)       uso ;;
    *)                    acao_install "$1" ;;
esac
