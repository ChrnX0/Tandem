#!/bin/bash
# Tandem - comando principal e painel.
. /usr/lib/tandem/common.sh
t_log_init tandem "$*"
t_primeira_vez

VERSAO="3.1"

uso() {
    cat <<'AJUDA'
Tandem - roda programas Windows e apps Android no Linux.

  tandem                      abre o painel
  tandem install <arquivo>    instala/executa (.exe .msi .apk .xapk .apks)
  tandem preparar             instala o que falta (Wine, Android, ...)
  tandem programas [nome]     lista e abre os programas Windows instalados
  tandem desinstalar [nome]   remove um programa Windows instalado
  tandem android              abre a tela do Android
  tandem doctor               diagnostico do ambiente
  tandem repair               reaplica as associacoes de arquivo
  tandem backup               salva o ambiente Windows
  tandem restore              restaura o ambiente Windows
  tandem protect <caminho>    protege um perfil Wine contra alteracoes
  tandem alternativas <nome>  procura um programa de Linux que faca o mesmo
  tandem receita <arquivo>    exporta o que aprendeu, para mandar a alguem
  tandem receita --importar <r> <arquivo>   usa a receita de outra pessoa
  tandem memoria [nome]       o que o Tandem aprendeu sobre os programas
  tandem esquecer <nome>      apaga o que ele aprendeu sobre um programa
  tandem logs                 mostra o log mais recente
  tandem version
AJUDA
}

# ------------------------------------------------------------------ acoes

acao_install() {
    local f="$1"
    [ -n "$f" ] || { t_erro "Informe o arquivo."; return 1; }
    case "${f,,}" in
        *.apk|*.xapk|*.apks|*.apkm) exec /usr/bin/tandem-apk "$f" ;;
        *.exe|*.msi|*.msp|*.lnk|*.bat|*.cmd|*.url) exec /usr/bin/tandem-exe "$f" ;;
        *)
            if head -c2 -- "$f" 2>/dev/null | grep -q MZ; then exec /usr/bin/tandem-exe "$f"
            elif head -c2 -- "$f" 2>/dev/null | grep -q PK; then exec /usr/bin/tandem-apk "$f"
            else t_erro "Não reconheci o tipo deste arquivo."; return 1
            fi ;;
    esac
}

acao_doctor() {
    local out="" ip sdk
    out+="Tandem $VERSAO\n\n"
    out+="SISTEMA\n"
    out+="  $( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-desconhecido}" )\n"
    out+="  kernel $(uname -r)   sessão: ${XDG_SESSION_TYPE:-?}\n\n"

    out+="PROGRAMAS WINDOWS\n"
    if command -v wine >/dev/null 2>&1; then
        out+="  wine: $(wine --version 2>/dev/null)\n"
        t_tem_wine64 && out+="  programas de 64 bits: sim\n" ||
            out+="  programas de 64 bits: NÃO (o Wine desta máquina é só de 32 bits)\n"
        t_tem_wine32 && out+="  programas de 32 bits: sim\n" ||
            out+="  programas de 32 bits: NÃO (programas antigos não abrem)\n"
        command -v winetricks >/dev/null 2>&1 &&
            out+="  winetricks: sim\n" || out+="  winetricks: NÃO (não instala dependências)\n"
        [ -f "$TANDEM_PREFIXO_PADRAO/system.reg" ] &&
            out+="  ambiente: pronto\n" || out+="  ambiente: será criado no primeiro uso\n"
    else
        out+="  wine: NÃO INSTALADO\n"
    fi
    out+="\nAPPS ANDROID\n"
    if command -v waydroid >/dev/null 2>&1; then
        out+="  waydroid: instalado\n"
        out+="  serviço: $(systemctl is-active waydroid-container 2>/dev/null)\n"
        t_wd_sessao_ok && out+="  sessão: ativa\n" || out+="  sessão: parada\n"
        if t_wd_pronto; then
            sdk="$(t_wd_sdk)"; ip="$(t_wd_ip)"
            out+="  Android: pronto (API ${sdk:-?}, IP ${ip:-?})\n"
            t_wd_tem_arm && out+="  tradutor ARM: sim\n" || out+="  tradutor ARM: NÃO (apps de celular não instalam)\n"
        else
            out+="  Android: não iniciado\n"
        fi
        command -v adb >/dev/null 2>&1 &&
            out+="  adb: sim\n" || out+="  adb: NÃO (pacotes .xapk não instalam)\n"
    else
        out+="  waydroid: NÃO INSTALADO\n"
    fi
    out+="\nPERFIS PROTEGIDOS\n"
    if [ -s "$TANDEM_PROTEGIDOS" ]; then
        while read -r l; do [ -n "$l" ] && out+="  $l\n"; done < "$TANDEM_PROTEGIDOS"
    else
        out+="  (nenhum listado; perfis de terceiros são protegidos automaticamente)\n"
    fi

    # %b (e nao "$out" cru) porque o texto tem \n para expandir mas pode
    # conter % vindo de caminhos e versoes, que quebrariam o formato.
    printf '%b' "$out" | t_texto "Tandem - Diagnóstico"
}

acao_backup() {
    local p="$TANDEM_PREFIXO_PADRAO"
    [ -f "$p/system.reg" ] || { t_erro "Não há ambiente Windows para salvar ainda."; return 1; }
    local dest
    dest="$HOME/tandem-backup-$(date +%F-%H%M).tar.gz"
    t_progresso_abre "Salvando o ambiente Windows. Pode demorar."
    tar -C "$(dirname -- "$p")" -czf "$dest" "$(basename -- "$p")" 2>>"$LOG"
    local c=$?
    t_progresso_fecha
    [ $c -eq 0 ] && t_ok "Backup salvo em:
$dest" || t_erro "Não consegui salvar o backup."
    return $c
}

acao_restore() {
    local arq
    arq="$(ls -1t "$HOME"/tandem-backup-*.tar.gz 2>/dev/null | head -1)"
    [ -n "$arq" ] || { t_erro "Nenhum backup encontrado na sua pasta pessoal."; return 1; }
    t_pergunta "Restaurar o ambiente Windows a partir de:

$(basename -- "$arq")

O ambiente atual será substituído." "Restaurar" "Cancelar" || return 1
    t_progresso_abre "Restaurando..."
    rm -rf -- "$TANDEM_PREFIXO_PADRAO"
    mkdir -p "$(dirname -- "$TANDEM_PREFIXO_PADRAO")"
    tar -C "$(dirname -- "$TANDEM_PREFIXO_PADRAO")" -xzf "$arq" 2>>"$LOG"
    local c=$?
    t_progresso_fecha
    [ $c -eq 0 ] && t_ok "Ambiente restaurado." || t_erro "Não consegui restaurar."
    return $c
}

acao_protect() {
    local p; p="$(readlink -f -- "${1:-}" 2>/dev/null)"
    [ -n "$p" ] && [ -d "$p" ] || { t_erro "Caminho inválido."; return 1; }
    t_protege "$p" || { t_erro "Não consegui gravar a lista de perfis protegidos."; return 1; }
    t_ok "Perfil protegido:
$p

O Tandem nunca vai instalar nem alterar nada aí dentro."
}

# ----------------------------------------------------------------- preparar
#
# "Ao instalar o Tandem ele tambem instala o Wine e o Waydroid e tudo o que
# precisa" - pedido do usuario, e a resposta tecnica honesta: durante a
# instalacao do .deb e impossivel (trava do dpkg), mas um comando depois
# resolve tudo de uma vez. E o clique num .exe sem Wine tambem oferece.
acao_preparar() {
    local faltas linha codigos=() descricoes=() plano="" script c

    faltas="$(t_pecas_faltando)"
    if [ -z "$faltas" ]; then
        t_ok "Nada falta: esta máquina já tem tudo que o Tandem usa."
        return 0
    fi

    while IFS='|' read -r c linha; do
        [ -n "$c" ] || continue
        codigos+=("$c"); descricoes+=("$linha")
        plano="$plano
• $linha"
    done <<< "$faltas"

    if ! t_pergunta "O Tandem pode instalar o que está faltando:
$plano

Precisa de internet e da sua senha. Posso continuar?" "Instalar tudo" "Agora não"; then
        if [ -t 0 ]; then
            printf 'O Tandem pode instalar o que está faltando:\n%s\n\nPrecisa de internet e da sua senha. Continuar? [s/N] ' "$plano"
            read -r r
            case "$r" in s|S|sim|SIM) ;; *) echo "Cancelado."; return 1 ;; esac
        else
            t_erro "Não instalei nada: preciso de uma confirmação e não há janela nem terminal para perguntar."
            return 1
        fi
    fi

    script="$(t_script_instalacao "${codigos[@]}")"
    t_diz "preparar: instalando ${codigos[*]}"
    t_progresso_abre "Instalando o que falta. Pode demorar bastante - não desligue o computador."
    t_como_root "$script" >>"$LOG" 2>&1
    c=$?
    t_progresso_fecha

    if [ "$c" -eq 127 ]; then
        t_erro "Não consegui pedir a sua senha para instalar.

Abra o Terminal e execute:  sudo tandem preparar"
        return 1
    fi
    if [ "$c" -ne 0 ]; then
        t_erro "A instalação não terminou bem. Veja o que faltou com:

tandem doctor"
        return 1
    fi
    t_ok "Tudo pronto. Confira com: tandem doctor"
    return 0
}

# Escolhe um item de uma lista de nomes. Devolve o nome escolhido.
# Uma coluna so, de proposito: as opcoes de coluna escondida mudaram entre
# as versoes do zenity, e nao vale a pena depender delas.
escolher() {
    local titulo="$1" pergunta="$2"; shift 2
    if t_tem_gui && command -v zenity >/dev/null 2>&1; then
        zenity --list --title="$titulo" --text="$pergunta" \
               --width=520 --height=400 --column="Programa" "$@" 2>/dev/null
        return $?
    fi
    return 1
}

# ---------------------------------------------------------------- programas
#
# O menu do sistema nao e caminho confiavel de volta ao programa instalado:
# sob Wayland o GNOME so relê a lista de aplicativos depois de sair e entrar
# na conta, e ate la o programa instalado simplesmente nao existe para o
# usuario. O Tandem sabe o que instalou, entao ele mesmo mostra e abre.
acao_programas() {
    local filtro="${1:-}" d nome escolha achou="" nomes=()
    local lista; lista="$(t_atalhos_nossos)"
    if [ -z "$lista" ]; then
        t_erro "Nenhum programa do Windows instalado pelo Tandem por enquanto.

Programas que não criam atalho no Menu Iniciar não aparecem aqui."
        return 1
    fi

    if [ -n "$filtro" ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            nome="$(t_nome_do_atalho "$d")"
            case "${nome,,}" in *"${filtro,,}"*) achou="$d"; break ;; esac
        done <<< "$lista"
        [ -n "$achou" ] || { t_erro "Não achei nenhum programa com \"$filtro\" no nome."; return 1; }
        setsid gio launch "$achou" >/dev/null 2>&1 &
        t_ok "Abrindo $(t_nome_do_atalho "$achou")..."
        return 0
    fi

    while IFS= read -r d; do
        [ -n "$d" ] || continue
        nomes+=("$(t_nome_do_atalho "$d")")
    done <<< "$lista"

    # Sem janela (terminal, SSH), a lista sai em texto. O "escolher" devolve
    # vazio tanto no Cancelar quanto na ausencia de zenity; no primeiro caso
    # a listagem e inofensiva, no segundo e o unico caminho que resta.
    escolha="$(escolher "Tandem - Programas do Windows" \
                        "Qual programa você quer abrir?" "${nomes[@]}")"
    if [ -z "$escolha" ]; then
        printf 'Programas do Windows instalados pelo Tandem:\n\n'
        printf '  %s\n' "${nomes[@]}"
        printf '\nPara abrir um deles:  tandem programas "<parte do nome>"\n'
        return 0
    fi
    acao_programas "$escolha"
}

# ------------------------------------------------------------- desinstalar
#
# O usuario-alvo nao sabe usar o Wine, e nao tem por que saber. Sem isto o
# unico caminho era "WINEPREFIX=... wine uninstaller", que e exatamente o
# tipo de coisa que este projeto existe para nao exigir de ninguem.
acao_uninstall() {
    local filtro="${1:-}" pref="$TANDEM_PREFIXO_PADRAO" lista linha nome
    local escolha achou="" nomes=() silencioso normal

    [ -f "$pref/system.reg" ] || {
        t_erro "Nenhum programa do Windows foi instalado pelo Tandem ainda."; return 1; }

    # Desinstalar altera o prefixo, entao so vale para o nosso. Prefixo de
    # terceiro - o do sistema de frente de caixa, por exemplo - e intocavel.
    export WINEPREFIX="$pref"
    lista="$(t_uninstall_dump "$pref")"
    if [ -z "$lista" ]; then
        t_erro "Não encontrei nenhum programa do Windows para remover.

Programas que não trazem desinstalador próprio não aparecem nesta lista."
        return 1
    fi

    while IFS= read -r linha; do
        [ -n "$linha" ] || continue
        nome="${linha#*|||}"; nomes+=("${nome%%|||*}")
    done <<< "$lista"

    if [ -z "$filtro" ]; then
        escolha="$(escolher "Tandem - Remover programa" \
                            "Qual programa você quer remover?" "${nomes[@]}")"
        if [ -z "$escolha" ]; then
            printf 'Programas do Windows que podem ser removidos:\n\n'
            printf '  %s\n' "${nomes[@]}"
            printf '\nPara remover:  tandem desinstalar "<parte do nome>"\n'
            return 0
        fi
        filtro="$escolha"
    fi

    while IFS= read -r linha; do
        [ -n "$linha" ] || continue
        nome="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $2}')"
        case "${nome,,}" in
            *"${filtro,,}"*)
                achou="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $1}')"
                silencioso="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $3}')"
                normal="$(printf '%s' "$linha" | awk -F'\\|\\|\\|' '{print $4}')"
                break ;;
        esac
    done <<< "$lista"
    [ -n "$achou" ] || { t_erro "Não achei nenhum programa com \"$filtro\" no nome."; return 1; }
    command -v wine >/dev/null 2>&1 || { t_erro "O Wine não está instalado."; return 1; }

    # Confirmacao: janela; senao o terminal; sem nenhum dos dois, recusa
    # DIZENDO por que - remover programa sem ninguem confirmando e risco,
    # e desistir calado e defeito.
    if ! t_pergunta "Remover este programa do Windows?

$nome

Os arquivos dele serão apagados." "Remover" "Cancelar"; then
        if [ -t 0 ]; then
            printf 'Remover "%s"? Os arquivos dele serão apagados. [s/N] ' "$nome"
            read -r r
            case "$r" in s|S|sim|SIM) ;; *) echo "Cancelado."; return 1 ;; esac
        else
            t_erro "Não removi $nome: preciso de uma confirmação e não há janela nem terminal para perguntar."
            return 1
        fi
    fi

    # Preferimos o desinstalador silencioso, que o proprio programa declara
    # no registro. Sem ele, rodamos o desinstalador normal: abre a janela do
    # proprio programa e o usuario confirma la - honesto, ainda que em ingles.
    local c
    if [ -n "$silencioso" ]; then
        t_progresso_abre "Removendo $nome..."
        t_diz ">>> $silencioso"
        t_executa_comando_windows "$silencioso" >>"$LOG" 2>&1
        c=$?
        wineserver -w 2>/dev/null
        t_progresso_fecha
    else
        t_aviso "Vai abrir a janela de remoção do próprio $nome. Confirme por lá."
        t_diz ">>> $normal"
        t_executa_comando_windows "$normal" >>"$LOG" 2>&1
        c=$?
        wineserver -w 2>/dev/null
    fi

    local orfaos; orfaos="$(t_limpa_atalhos_orfaos)"
    t_diz "desinstalar $nome: codigo $c, $orfaos atalho(s) orfao(s) removido(s)"

    # A prova dos nove e o registro: a chave sumiu?
    if t_uninstall_dump "$pref" | grep -qF -- "$achou|||"; then
        t_erro "Não consegui remover $nome.

O desinstalador do programa não completou. Tente de novo, ou remova pela janela do próprio programa."
        return 1
    fi
    t_ok "$nome foi removido."
    return 0
}

# ------------------------------------------------------------- alternativas
#
# O dono pergunta; o Tandem responde com o que sabe, e diz claramente quando
# nao sabe. Nunca troca nada, nunca insiste, e nunca sugere trocar programa
# que esta funcionando.
acao_alternativas() {
    local nome="${1:-}" texto
    if [ -z "$nome" ]; then
        t_erro "Diga o nome do programa.

Exemplo:  tandem alternativas photoshop"
        return 1
    fi
    # Aceita tanto "photoshop" quanto o caminho de um .exe.
    [ -f "$nome" ] && nome="$(basename -- "${nome%.*}")"

    if texto="$(t_texto_alternativas "$nome")"; then
        printf 'Programas de Linux que fazem o trabalho de "%s":\n%s\n' "$nome" "$texto" |
            t_texto "Tandem - Alternativas para $nome"
        return 0
    fi

    t_erro "Não conheço alternativa de Linux para \"$nome\".

Isso não quer dizer que não exista — quer dizer que ainda não está na minha lista.
Se você encontrar uma, ela pode ser acrescentada em uma linha."
    return 1
}

# -------------------------------------------------------------- receitas
#
# O conhecimento coletivo sem servidor: a memoria de um programa vira um
# arquivo de texto que o dono manda para outra pessoa. So puxa, nunca
# empurra - o Tandem le receitas e nunca envia nada para lugar nenhum.
acao_receita() {
    if [ "${1:-}" = "--importar" ]; then
        local rec="${2:-}" prog="${3:-}"
        [ -n "$rec" ] && [ -n "$prog" ] || {
            t_erro "Uso:  tandem receita --importar <receita.txt> <programa.exe>"; return 1; }
        [ -f "$prog" ] || { t_erro "Não achei o programa: $prog"; return 1; }
        t_receita_importa "$rec" "$prog"
        case $? in
            0) t_ok "Receita aplicada.

O Tandem agora sabe o que este programa pediu na máquina de quem mandou.
Ele vai PERGUNTAR antes de instalar qualquer coisa — receita não é ordem."
               return 0 ;;
            2) t_erro "Este arquivo não é uma receita do Tandem." ;;
            3) t_erro "Esta receita é de outro programa, ou de outra versão dele.

Aplicar ensinaria a lição errada, então não apliquei." ;;
            4) t_erro "Recusei a receita: ela traz um nome de componente suspeito.

Receita vinda de fora não pode mandar o Tandem executar nada." ;;
            *) t_erro "Não consegui ler esta receita." ;;
        esac
        return 1
    fi

    local prog="${1:-}"
    [ -n "$prog" ] || { t_erro "Diga qual programa.

Exemplo:  tandem receita ~/Downloads/sistema.exe"; return 1; }
    [ -f "$prog" ] || { t_erro "Não achei o programa: $prog"; return 1; }
    if ! t_receita_exporta "$prog"; then
        t_erro "Ainda não aprendi nada sobre este programa.

Abra ele uma vez pelo Tandem e a receita se forma sozinha."
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------ memoria
#
# O que o Tandem aprendeu, em texto que o dono consegue ler. Nao existe
# memoria secreta: se ele nao conseguir VER o que foi guardado, nao tem como
# confiar nem como corrigir.
acao_memoria() {
    local filtro="${1:-}" arq prog saida="" n=0
    if [ ! -d "$TANDEM_MEMORIA" ] || [ -z "$(ls -A "$TANDEM_MEMORIA" 2>/dev/null)" ]; then
        t_erro "O Tandem ainda não aprendeu nada.

A memória se forma sozinha conforme você usa os programas."
        return 1
    fi
    for arq in "$TANDEM_MEMORIA"/*.txt; do
        [ -f "$arq" ] || continue
        prog="$(sed -n 's/^PROGRAMA=//p' "$arq" | head -1)"
        [ -n "$filtro" ] && case "${prog,,}" in *"${filtro,,}"*) ;; *) continue ;; esac
        n=$((n+1))
        saida="$saida$prog"$'\n'
        saida="$saida$(sed -n 's/^RESULTADO=/  resultado:  /p;
                              s/^ARQUITETURA=/  arquitetura: /p;
                              s/^RESOLVERAM=/  resolveram: /p;
                              s/^NAO_RESOLVERAM=/  não resolveram: /p;
                              s/^SEGUNDOS=/  levou (s): /p;
                              s/^VISTO_EM=/  visto em:   /p;
                              s/^LIMITE=/  limite:     /p' "$arq")"$'\n\n'
    done
    [ "$n" -gt 0 ] || { t_erro "Não achei nada aprendido sobre \"$filtro\"."; return 1; }
    printf '%s' "$saida" | t_texto "Tandem - O que eu aprendi"
}

acao_esquecer() {
    local filtro="${1:-}" arq prog n=0
    [ -n "$filtro" ] || { t_erro "Diga o nome do programa a esquecer."; return 1; }
    for arq in "$TANDEM_MEMORIA"/*.txt; do
        [ -f "$arq" ] || continue
        prog="$(sed -n 's/^PROGRAMA=//p' "$arq" | head -1)"
        case "${prog,,}" in *"${filtro,,}"*) rm -f -- "$arq"; n=$((n+1)) ;; esac
    done
    [ "$n" -gt 0 ] || { t_erro "Não achei nada aprendido sobre \"$filtro\"."; return 1; }
    t_ok "Esqueci o que sabia sobre $n programa(s). Da próxima vez ele descobre de novo."
}

acao_logs() {
    local l; l="$(ls -1t "$TANDEM_ESTADO"/*.log 2>/dev/null | head -1)"
    [ -n "$l" ] || { t_erro "Ainda não há registros."; return 1; }
    tail -n 400 "$l" | t_texto "Tandem - $(basename "$l")"
}

acao_painel() {
    # Sem sessao grafica o painel nao tem como aparecer: mostre a ajuda em
    # vez de abrir e fechar uma janela invisivel sem dizer nada.
    if ! t_tem_gui || ! command -v zenity >/dev/null 2>&1; then uso; return 0; fi
    local esc
    while :; do
        esc="$(zenity --list --title="Tandem" --width=520 --height=400 \
            --text="O que você quer fazer?" \
            --column="Ação" --column="Descrição" --hide-header \
            "instalar"  "Instalar ou abrir um arquivo (.exe .msi .apk .xapk)" \
            "preparar"  "Instalar o que falta (Wine, Android...)" \
            "programas" "Abrir um programa do Windows já instalado" \
            "remover"   "Desinstalar um programa do Windows" \
            "android"   "Abrir a tela do Android" \
            "doctor"    "Ver o diagnóstico do ambiente" \
            "backup"    "Salvar o ambiente Windows" \
            "restore"   "Restaurar o ambiente Windows" \
            "repair"    "Consertar a abertura de arquivos com dois cliques" \
            "memoria"   "Ver o que o Tandem aprendeu sobre os programas" \
            "logs"      "Ver o registro técnico" \
            2>/dev/null)" || return 0
        case "$esc" in
            instalar)
                local f
                f="$(zenity --file-selection --title="Escolha o arquivo" \
                     --file-filter="Programas e apps | *.exe *.msi *.apk *.xapk *.apks *.apkm" \
                     --file-filter="Todos | *" 2>/dev/null)" || continue
                acao_install "$f" ;;
            preparar)  acao_preparar ;;
            programas) acao_programas ;;
            remover)   acao_uninstall ;;
            android)  setsid /usr/bin/tandem-android >/dev/null 2>&1 & ;;
            doctor)   acao_doctor ;;
            backup)   acao_backup ;;
            restore)  acao_restore ;;
            repair)   /usr/bin/tandem-repair ;;
            memoria)  acao_memoria ;;
            logs)     acao_logs ;;
            *)        return 0 ;;
        esac
    done
}

# ------------------------------------------------------------------ main
case "${1:-}" in
    ""|painel|panel)      acao_painel ;;
    install|instalar|abrir) shift; acao_install "$@" ;;
    preparar|setup)       acao_preparar ;;
    programas|apps)       shift; acao_programas "$@" ;;
    desinstalar|uninstall|remover) shift; acao_uninstall "$@" ;;
    android)              exec /usr/bin/tandem-android ;;
    doctor|diagnostico)   acao_doctor ;;
    repair|consertar)     exec /usr/bin/tandem-repair ;;
    backup)               acao_backup ;;
    restore|restaurar)    acao_restore ;;
    protect|proteger)     shift; acao_protect "$@" ;;
    alternativas|alternativa) shift; acao_alternativas "$@" ;;
    receita|receitas)     shift; acao_receita "$@" ;;
    memoria|memória)      shift; acao_memoria "$@" ;;
    esquecer|esqueca)     shift; acao_esquecer "$@" ;;
    logs|log)             acao_logs ;;
    # Uso interno do postinst: ja foi feito na chamada a t_primeira_vez
    # la em cima. Fica fora da ajuda de proposito.
    --primeira-vez)       : ;;
    version|--version|-v) echo "Tandem $VERSAO" ;;
    help|--help|-h)       uso ;;
    *)                    acao_install "$1" ;;
esac
