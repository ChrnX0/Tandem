#!/bin/bash
# Tandem - runs a Windows program, resolving dependencies on its own.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"
. "${TANDEM_LIB:-/usr/lib/tandem}/winedeps.sh"

t_log_init exe "$*"
# Before any decision about a prefix: make sure the prefixes that already
# existed are registered as untouchable.
t_primeira_vez

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "$(t_msg sem_arquivo)"; exit 1; }
PROG="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$PROG" ] && [ -f "$PROG" ] || { t_erro "$(t_msg arquivo_sumiu "$BRUTO")"; exit 1; }

# A saved web page named .exe, BEFORE building a Wine prefix and running HTML
# through Wine. The other eight handlers ask this; tandem-exe did not, so a
# 404/login page downloaded under a program's name fell all the way through to
# the bare "closed with an error (code 1)" - the outcome this project exists to
# abolish - and the owner went back to the same broken link forever. The
# .desktop runs "tandem-exe %f" directly, so the CLI content sniff never sees
# it; the check has to live here.
if t_parece_pagina_web "$PROG"; then
    t_erro "$(t_msg baixou_pagina_web "$(basename -- "$PROG")")"; exit 1
fi

# Without Wine, the click cannot die on a warning: we offer to install it now.
if ! command -v wine >/dev/null 2>&1; then
    if t_pergunta "$(t_msg wine_faltando_pergunta)" "$(t_msg botao_instalar)" "$(t_msg botao_agora_nao)"; then
        t_progresso_abre "$(t_msg wine_instalando)"
        t_como_root "$(t_script_instalacao wine)" >>"$LOG" 2>&1
        t_progresso_fecha
    fi
    command -v wine >/dev/null 2>&1 || {
        t_erro "$(t_msg wine_faltando_erro)"; exit 1; }
    t_ok "$(t_msg wine_instalado)"
fi

# Two quick clicks fire off two processes. Without this, two concurrent
# dependency installs corrupt the prefix. Lock per file, so as not to prevent
# opening two different programs at the same time.
CHAVE="$(printf '%s' "$PROG" | cksum | tr -d ' ')"
TRAVA="$TANDEM_TRAVAS/exe-$CHAVE.lock"
# Two situations that looked like one. If ANOTHER process already holds the
# lock, bailing out is right. But if the lock cannot even be created - home
# folder full, read-only, on a network share - the "exec" fails, bash stays
# alive, flock answers "Bad file descriptor" and the old code exited with 0
# saying "this program is already opening". A lie, and invisible on a double
# click: the result was the double click doing nothing, forever. Without a
# lock the protection against a double click is lost, which is bad; refusing
# to open the program is worse.
# The braces are not decoration. "exec" WITH NO COMMAND applies the
# redirections to the whole shell, and permanently: written as
# "exec 7> file 2>/dev/null", the 2>/dev/null does not silence the exec - it
# silences stderr for ALL the rest of the program. Measured effect on an
# Ubuntu 24.04 with no graphical session: the loop detected the right DLL,
# translated it right, assembled the right message with the right command...
# and returned code 53 with zero bytes of output. The most complete silent
# failure this project has ever produced, hidden precisely inside the code
# written to fix a silent failure. With the braces, fd 7 persists and the
# stderr redirection dies at the end of the group.
if { exec 7> "$TRAVA"; } 2>/dev/null; then
    flock -n 7 || { t_aviso "$(t_msg ja_abrindo)"; exit 0; }
else
    t_diz "nao consegui criar a trava em $TRAVA; seguindo sem ela"
fi

# ------------------------------------------------- 1. Which prefix to use
# If the file lives inside an existing prefix, respect it.
# This is what keeps Tandem from running the updater of a production system
# in an empty environment, without the dependencies that system installed.
if PREF="$(t_prefixo_do_arquivo "$PROG")"; then
    export WINEPREFIX="$PREF"
    NOSSO=0
    t_diz "prefixo detectado pelo caminho do arquivo: $PREF"
else
    export WINEPREFIX="$TANDEM_PREFIXO_PADRAO"
    NOSSO=1
fi
t_prefixo_protegido "$WINEPREFIX" && PROTEGIDO=1 || PROTEGIDO=0

# fixme-all silences Wine's noisiest class, which is what makes the log
# readable. The two exceptions are re-enabled on purpose: ntoskrnl and hal are
# where a Windows driver finds out the hardware underneath is hollow, and
# those two lines are the only evidence that the program was let in and then
# handed zeros. Without them t_limite_do_log has nothing to read and the
# owner gets "the program closed with error (code N)" for a cause Wine
# actually printed. Wine reads the list left to right, so -all then +channel.
export WINEDEBUG=fixme-all,fixme+ntoskrnl,fixme+hal
# Wine uses the locale to choose the language of the Windows program. Setting
# pt_BR.UTF-8 without checking was dangerous: on a system where that locale
# was not generated (a Zorin installed in English, for instance) glib falls
# back to ASCII and zenity starts refusing every accented text - that is, all
# the error windows of this program stopped appearing, silently.
TANDEM_LOCALE="$(t_locale_utf8 "${LC_ALL:-}" pt_BR.UTF-8 "${LANG:-}")"
export LC_ALL="$TANDEM_LOCALE"
# winemenubuilder ON: it is the one that creates the Linux menu shortcut when
# a Windows installer creates a shortcut in the Start Menu.
unset WINEDLLOVERRIDES

# ------------------------------------------------ 2. Create default prefix
if [ "$NOSSO" = 1 ] && [ ! -f "$WINEPREFIX/system.reg" ]; then
    if [ -d "$WINEPREFIX" ]; then
        # "Incomplete" means without system.reg. It does not mean empty:
        # there may be an interrupted wineboot with the Documents folder
        # already full. Deleting it outright was the most silent destructive
        # path in the project - it happened inside a double click, with
        # nobody asking for anything.
        RESGATE="$(t_dados_resgate "$WINEPREFIX" ambiente-incompleto)"; C_RESGATE=$?
        case $C_RESGATE in
            0) t_aviso "$(t_msg ambiente_pela_metade "$RESGATE")" ;;
            1) # There is data here and the copy failed. This runs inside a
               # double click, so there is nobody watching a terminal: refusing
               # is the only honest move. Deleting anyway would be the exact
               # loss this whole mechanism exists to prevent.
               t_erro "$(t_texto_resgate_falhou)"
               exit 1 ;;
        esac
        t_diz "prefixo incompleto, refazendo"
        rm -rf -- "$WINEPREFIX"
    fi
    mkdir -p "$(dirname -- "$WINEPREFIX")"
    t_progresso_abre "$(t_msg primeira_vez_ambiente)"
    (
      flock -w 1200 9 || exit 1
      # Without the Mono/Gecko dialogs in English, which stall a lay user.
      WINEARCH=win64 WINEDLLOVERRIDES="mscoree=d;mshtml=d;winemenubuilder.exe=d" \
          wineboot -u >>"$LOG" 2>&1
      wineserver -w
    ) 9> "$TANDEM_TRAVAS/prefixo.lock"
    t_progresso_fecha
    if [ ! -f "$WINEPREFIX/system.reg" ]; then
        t_erro "$(t_msg ambiente_falhou)"; exit 1
    fi
    : > "$WINEPREFIX/.tandem-prefixo"
    PROTEGIDO=0
    # Before anything is installed: freeze the two identifiers Wine would
    # otherwise invent at random, so that a program which ties its licence to
    # this machine sees the same machine after the environment is remade. It
    # has to happen here, at creation - doing it later, when something has
    # already activated, would change the identity instead of holding it.
    t_identidade_fixa "$WINEPREFIX"
    t_ok "$(t_msg ambiente_pronto)"
fi
# On an already existing prefix, setting WINEARCH makes Wine refuse to start.
unset WINEARCH

# winemenubuilder does two things: it creates Linux menu shortcuts for the
# installed Windows programs (we want that) and it hijacks the system's file
# associations, stealing .txt, .jpg and .pdf (we do not want that). Turning
# off the whole binary kills both. This key turns off only the hijacking - it
# is what sits behind winecfg's "Manage File Associations" option.
# Only in a prefix of ours: in a third party's prefix nothing is changed.
if [ "$PROTEGIDO" = 0 ] && [ ! -f "$WINEPREFIX/.tandem-assoc" ]; then
    wine reg add 'HKCU\Software\Wine\FileOpenAssociations' /v Enable /t REG_SZ /d N /f \
        >>"$LOG" 2>&1 && : > "$WINEPREFIX/.tandem-assoc"
    # Cleans up whatever Wine may have already spread before this guard.
    rm -f "$HOME/.local/share/applications/wine-extension-"*.desktop 2>/dev/null
    rm -f "$HOME/.local/share/mime/packages/x-wine"* 2>/dev/null
    # BOTH streams, and the reason is measured rather than defensive:
    # update-mime-database writes "Directory '...' does not exist!" to STDOUT,
    # not stderr, so `2>/dev/null` silenced the wrong one and that sentence was
    # the FIRST LINE the owner read on any machine where
    # ~/.local/share/mime/packages is absent - a fresh account, a minimal
    # desktop. English jargon from somebody else's tool, at the top of the
    # screen, in a program whose whole rule is that nothing the owner reads is
    # jargon. It showed up in five of five scenarios while testing something
    # else entirely.
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1
    update-mime-database "$HOME/.local/share/mime" >/dev/null 2>&1
fi

# ------------------------------------------------------- 3. 32-bit check
ARCH="$(t_pe_arch "$PROG" 2>/dev/null || true)"
t_diz "arquitetura do PE: ${ARCH:-nao identificada}"
if [ "$ARCH" = 32 ] && ! t_tem_wine32; then
    if t_pergunta "$(t_msg bits32_pergunta)" "$(t_msg botao_instalar)" "$(t_msg botao_agora_nao)"; then
        t_progresso_abre "$(t_msg bits32_instalando)"
        t_como_root "$(t_script_instalacao wine32)" >>"$LOG" 2>&1
        t_progresso_fecha
    fi
    if ! t_tem_wine32; then
        t_erro "$(t_msg bits32_erro)"
        exit 1
    fi
    t_ok "$(t_msg bits32_instalado)"
fi
if [ "$ARCH" = arm64 ]; then
    t_erro "$(t_msg arm_nao_roda)"
    exit 1
fi

# Decidable before running anything, and until now it was not decided at all:
# a 32-bit environment cannot run a 64-bit program, no matter what is installed
# in it. Wine writes the answer on the fourth line of system.reg, and a
# prefix's bitness cannot be changed after creation - so there is nothing to
# try here, only something to say. Tandem's own prefixes are win64; the 32-bit
# one that turns up is somebody else's, made years ago, and rule number 1 keeps
# us out of it anyway.
#
# Only a prefix that DECLARES win32 is refused. The folder layout can be read
# the same way, but a deduction is not a fact, and refusing to open a program on
# a guess would be a worse defect than the one this fixes.
if [ "$ARCH" = 64 ]; then
    ARQ_PREFIXO="$(t_prefixo_arquitetura "$WINEPREFIX" 2>/dev/null)"; C_ARQ=$?
    case $C_ARQ in
        0) t_diz "arquitetura do prefixo: $ARQ_PREFIXO (declarada em system.reg)" ;;
        2) t_diz "arquitetura do prefixo: $ARQ_PREFIXO (deduzida das pastas)" ;;
        *) t_diz "arquitetura do prefixo: nao identificada" ;;
    esac
    if [ "$ARQ_PREFIXO" = win32 ] && [ "$C_ARQ" = 0 ]; then
        t_erro "$(t_msg ambiente_32_bits "$(basename -- "$PROG")" "$WINEPREFIX")"
        exit 1
    fi
fi

# Pre-flight: reads the import table of the file itself, without running
# anything. It does not block and does not install - it keeps the explanation
# around in case things fail.
LIMITE="$(t_limite_do_programa "$PROG" 2>/dev/null)"
[ -n "$LIMITE" ] && t_diz "pre-voo: limite reconhecido -> $LIMITE"

# ------------------------------------------------- memory of this program
# What Tandem has already learned about THIS file, here or on another machine.
SABIDOS="$(t_memoria_le "$PROG" RESOLVERAM 2>/dev/null)"
# If this machine still knows nothing about this program, the community list
# may know. It decides nothing: it becomes exactly the same kind of suggestion
# as the local memory, and goes through the same question.
if [ -z "$SABIDOS" ]; then
    # Keep the copy fresh, in the background, at most once a day. Before 4.11
    # nothing here ever fetched it: the list only existed on a machine whose
    # owner had typed `tandem lista atualizar`, so for everybody else this
    # consultation asked a file that was never going to be there.
    t_lista_talvez_atualiza 2>/dev/null
    DA_LISTA="$(t_lista_consulta "$PROG" 2>/dev/null)"; RC_LISTA=$?
    if [ -z "$DA_LISTA" ]; then
        # It said nothing, and WHY it said nothing is the useful half. Without
        # this line a machine that never downloaded the list and a program the
        # world has never seen look identical in the log.
        t_diz "$(t_lista_porque_calou "$RC_LISTA")"
    fi
    if [ -n "$DA_LISTA" ]; then
        SABIDOS="$DA_LISTA"
        # The machine count is the one thing the list knows and no forum
        # knows. Keeping that in a file and not telling the owner would be
        # throwing away the best reason he has to trust the suggestion.
        DE_QUANTAS="$(t_lista_maquinas "$(t_memoria_id "$PROG" 2>/dev/null)" 2>/dev/null)"
        t_diz "lista da comunidade conhece este programa ->$DA_LISTA (${DE_QUANTAS:-?} maquinas)"
    fi
fi
LIMITE_LEMBRADO="$(t_memoria_le "$PROG" LIMITE 2>/dev/null)"
[ -z "$LIMITE" ] && [ -n "$LIMITE_LEMBRADO" ] && LIMITE="$LIMITE_LEMBRADO"
INICIO=$SECONDS
t_memoria_grava "$PROG" ARQUITETURA "${ARCH:-?}" 2>/dev/null
[ -n "$LIMITE" ] && t_memoria_grava "$PROG" LIMITE "$LIMITE" 2>/dev/null

# The memory SUGGESTS, it never decides. Installing on its own based on a past
# lesson would be repeating a mistake forever - and in a shop owner's prefix
# that costs dearly. So it only shortens the path if he says so.
# Declared HERE, above the memory shortcut, and not further down where it used
# to live: the shortcut installs BEFORE the detector loop, so an initialisation
# below it silently wiped whatever the shortcut had recorded. That is the bug
# this very change introduced on its first attempt, caught by reading the order
# rather than by any test - the shortcut path has no test that reaches it.
INSTALADOS_AGORA=""
# Declared HERE, above the retry loop, for the reason written beside
# INSTALADOS_AGORA: it is FILLED during the install round and READ on a
# later round, when the receipt says everything is installed and the
# program still fails. Initialised inside the loop - which is where it
# was first written - each round wiped the cause the round before had
# found, and the owner got "it closed with an error" for a full disk.
AMBIENTE_FALHOU=""
# Which components the machine stopped, so the final message can NAME them
# instead of claiming they were installed. Same scope, same reason.
AMBIENTE_VERBOS=""
APLICOU_LICAO=0
if [ -n "$SABIDOS" ] && [ "$PROTEGIDO" = 0 ] && command -v winetricks >/dev/null 2>&1; then
    PENDENTES=""
    for v in $SABIDOS; do
        # The lesson may come from the community list, which is THIRD PARTY
        # content. The same care taken with recipes applies here: a verb name
        # with an unexpected character does not become an argument to any
        # command - and a verb that changes a SETTING instead of installing a
        # dependency is refused outright, whatever it is called. Checked at the
        # point of use rather than only at import, because this list also holds
        # what a recipe wrote into the local memory on some earlier day.
        t_verbo_de_fora_ok "$v" || { t_diz "verbo recusado (nao instala dependencia, ou nome suspeito): $v"; continue; }
        v="$(t_verbo_para_arquitetura "$v" "$ARCH")"
        grep -qxF -- "$v" "$WINEPREFIX/.tandem-verbos" 2>/dev/null || PENDENTES="$PENDENTES $v"
    done
    if [ -n "$PENDENTES" ]; then
        t_diz "memoria: ja resolveram este programa ->$PENDENTES"
        # Does the list already know one of these was tried and did not help?
        #
        # Field 4 of the record - the components installed that did NOT fix it
        # - has been written by every client, accepted by the intake, published
        # by the rebuild and downloaded to every machine since 3.4, and read by
        # NOBODY: t_lista_linha's awk touches fields 1, 3, 5, 6 and 7. So a
        # shop could be one click from half an hour of dotnet48 that sixty
        # other shops had already burned on this exact installer, with that
        # fact sitting on its own disk.
        #
        # It is said, not acted on. A component that failed elsewhere can be
        # exactly right here, so this adds a sentence to the question and
        # changes no default: he is the one deciding whether to spend the
        # afternoon.
        AVISO_INUTEIS=""
        if ID_LISTA="$(t_memoria_id "$PROG" 2>/dev/null)"; then
            while IFS="$(printf '\t')" read -r v_mau n_mau; do
                [ -n "$v_mau" ] || continue
                case " $PENDENTES " in
                    *" $v_mau "*)
                        AVISO_INUTEIS="${AVISO_INUTEIS}
$(t_msg_n lista_ja_nao_ajudou "$n_mau" "$(t_verbo_amigavel "$v_mau")" "$n_mau")" ;;
                esac
            done <<FIMAVISO
$(t_lista_inuteis "$ID_LISTA" 2>/dev/null)
FIMAVISO
            [ -n "$AVISO_INUTEIS" ] && t_diz "lista: ja tentaram sem sucesso ->$AVISO_INUTEIS"
        fi
        ORIGEM_LICAO="$(t_msg licao_origem_local)"
        if [ -n "${DE_QUANTAS:-}" ] && [ "${DE_QUANTAS:-0}" -gt 1 ] 2>/dev/null; then
            ORIGEM_LICAO="$(t_msg licao_origem_lista "$DE_QUANTAS")"
        fi
        if t_pergunta "$(t_msg licao_pergunta "$ORIGEM_LICAO" \
             "$(for v in $PENDENTES; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)")${AVISO_INUTEIS}" \
             "$(t_msg botao_instalar)" "$(t_msg botao_tentar_sem_instalar)"; then
            # This shortcut can also run dotnet48, which takes half an hour:
            # suspending in the middle corrupts the prefix just the same.
            INIBIR_MEM="$(t_inibidor)"
            # Only one dependency install per prefix at a time. Two programs
            # opened at once land in the same prefix by default, and the lock
            # at the top of this file is keyed to the FILE - on purpose, so
            # that opening two different programs keeps working.
            t_trava_prefixo_pega "$WINEPREFIX"
            t_progresso_abre "$(t_msg licao_instalando)"
            for v in $PENDENTES; do
                t_progresso_texto "$(t_msg instalando_componente "$(t_verbo_amigavel "$v")")"
                t_diz ">>> winetricks -q $v (da memoria)"
                # Through t_progresso_longo, so the bar SAYS SOMETHING while
                # this runs. dotnet48 is half an hour, and behind a counter
                # "downloading slowly" and "stuck on a dead mirror" were the
                # same unchanging picture.
                if t_progresso_longo \
                       "$(t_msg instalando_componente "$(t_verbo_amigavel "$v")")" \
                       $INIBIR_MEM winetricks -q "$v" >>"$LOG" 2>&1; then
                    # The proof of delivery applies here too. This path used
                    # to write a receipt based on the exit code alone - that
                    # is, it bypassed the whole thesis of 3.3, and precisely
                    # where the lesson came from outside and deserves MORE
                    # distrust, not less. With no known DLL to check there is
                    # nothing to prove: absence of proof does not condemn,
                    # the usual rule.
                    ALVO="$(t_dll_do_verbo "$v")"
                    # THREE outcomes, and this branch used to keep a boolean -
                    # the shape CLAUDE.md says to hunt for, found here by
                    # driving the path its own comment says no test reaches.
                    # t_dll_no_prefixo answers 0 delivered, 2 delivered in a
                    # width this program cannot load, 1 absent; an `if` makes
                    # the last two the same, and both were reported as "did not
                    # deliver" AND filed as a suspicious table row.
                    #
                    # Wrong width is not a wrong table row. vcrun2003 really
                    # does provide mfc71.dll - the verb simply ships a 32-bit
                    # payload, which half of them do, and it says so in English
                    # in the middle of the log. Filing that in
                    # traducao-suspeita.tsv poisons the one work list that has
                    # already found six genuinely wrong mappings, and it is the
                    # dead end retrying cannot fix, so it is also the thing
                    # most worth saying out loud.
                    if [ -n "$ALVO" ]; then
                        t_dll_no_prefixo "$ALVO" "$ARCH"; C_ENTREGA=$?
                    else
                        C_ENTREGA=0        # nothing to check: absence of proof does not condemn
                    fi
                    if [ "$C_ENTREGA" = 0 ]; then
                        printf '%s\n' "$v" >> "$WINEPREFIX/.tandem-verbos"
                        # RECORDED. Until now this branch installed the verb and
                        # told nobody: INSTALADOS_AGORA was only ever appended to
                        # inside the detector loop far below, so a lesson APPLIED
                        # from the list or from a recipe left RESOLVERAM empty,
                        # t_lista_registro refused to build a record, and the
                        # count on that lesson could never rise above the shops
                        # that had rediscovered it from scratch - which is
                        # precisely what this shortcut exists to stop happening.
                        INSTALADOS_AGORA="$INSTALADOS_AGORA $v"
                        # And WHERE it came from, because the two are not the
                        # same evidence. A shop that worked the lesson out for
                        # itself is an independent discovery; a shop that
                        # applied somebody else's and found it worked is
                        # corroboration. Summing them would let the list
                        # manufacture confidence out of its own output.
                        APLICOU_LICAO=1
                    elif [ "$C_ENTREGA" = 2 ]; then
                        # Delivered, in the wrong width. The table is RIGHT, so
                        # this must not reach traducao-suspeita.tsv - and the
                        # loop below reaches the same conclusion from the same
                        # function, which is where the owner's sentence about
                        # it comes from.
                        t_diz "!!! $v (da memoria) entregou $ALVO na bitola errada para um programa de $ARCH bits"
                    else
                        t_diz "!!! $v (da memoria) saiu 0 e nao entregou $ALVO"
                        t_anota_suspeita "$ALVO" "$v"
                    fi
                fi
            done
            wineserver -w
            t_progresso_fecha
            # Released before the program runs: holding it through the run
            # would block another program for no reason.
            t_trava_prefixo_solta
        fi
    fi
fi

# ---------------------------------------------------------- 4. How to run
executar() {
    cd -- "$(dirname -- "$PROG")" || return 1
    case "${PROG,,}" in
        *.msi|*.msp)
            local wp; wp="$(wine winepath -w -- "$PROG" 2>/dev/null || printf '%s' "$PROG")"
            wine msiexec /i "$wp" >>"$LOG" 2>&1 ;;
        *.lnk|*.url|*.bat|*.cmd)
            wine start /unix -- "$PROG" >>"$LOG" 2>&1 ;;
        *)
            wine "$PROG" >>"$LOG" 2>&1 ;;
    esac
}

# ---------------------------------------------- 5. Run, detect, install, repeat
MAX=3
tentativa=1
ATALHOS_ANTES="$(t_atalhos_wine)"
# "dll<TAB>verb" pairs that this run has already proven undelivered.
SUSPEITAS=""
# Pairs that did arrive, in the bitness this program cannot use.
BITOLA=""
while :; do
    # A marker, not a line count: background writers (the community-list
    # fetch, the version check) share this log and shift the numbers
    # between the count and the slice. That made two runs of an IDENTICAL
    # commit in CI go green once and red once, on a detector that suddenly
    # could not see a DLL sitting plainly in the log.
    MARCA="$(t_log_marca "$tentativa")"
    t_aviso "$(t_msg abrindo "$(basename -- "$PROG")")"
    # The clock that decides "it opened and closed by itself" has to time THE
    # RUN, not everything that led up to it. INICIO is set once, near the top,
    # above the memory shortcut and above this loop - so DUROU below carried
    # every winetricks download with it, and after a dotnet48 that is half an
    # hour. The guard compares against a few seconds, so on exactly the runs
    # where Tandem did the most work it was arithmetically incapable of firing,
    # and a program that flashed and vanished was reported as having worked.
    # The same inflated number goes into memory as SEGUNDOS and travels on
    # inside recipes. tandem-appimage, tandem-jar and tandem-script all reset
    # theirs in the right place; this was the one that did not.
    INICIO=$SECONDS
    executar
    CODIGO=$?
    if [ "$CODIGO" -eq 0 ]; then
        # Learned: the verbs installed IN THIS RUN were the ones that solved
        # it. Keeping only the ones that came now avoids crediting the recipe
        # with something that was already in the prefix for another reason.
        for v in $INSTALADOS_AGORA; do t_memoria_junta "$PROG" RESOLVERAM "$v"; done
        # WHERE the lesson came from, which is not the same evidence as WHAT it
        # was. A shop that worked the components out for itself is an
        # independent discovery; a shop that applied somebody else's lesson and
        # found it worked is corroboration. Summing the two would let the list
        # manufacture confidence out of its own output - four hundred machines
        # applying one suggestion would read as eight hundred discovering it.
        #
        # On disk, and in the record, so the far end can keep them apart. The
        # value is the on-disk vocabulary, never translated.
        [ "$APLICOU_LICAO" = 1 ] &&
            t_memoria_grava "$PROG" ORIGEM_LICAO aplicado 2>/dev/null
        DUROU=$((SECONDS-INICIO))
        t_memoria_grava "$PROG" RESULTADO abriu
        t_memoria_grava "$PROG" SEGUNDOS "$DUROU"
        t_memoria_grava "$PROG" VISTO_EM "$(date +%F)"
        # If it was an installer, shortcuts showed up: say where the program
        # ended up. If it was just a program running, nothing shows up and
        # nothing is said.
        t_anuncia_atalhos "$ATALHOS_ANTES"

        # ------------------------------------------------ silent success
        #
        # Code 0 says the process finished without an error. It does not say
        # the program worked. Wine's characteristic failure mode with
        # commercial software is not closing with an error - it is opening
        # and being subtly wrong: a receipt with broken accents, a blank
        # report, an inverted date, a window that never appeared. All of that
        # exits 0. A project whose yardstick is "no silent failures" had a
        # silent success at its center, and the recipe exported the wrong
        # lesson with the same confidence as a right one.
        #
        # The only witness to what happened on screen is the owner. We ask
        # ONCE per program - repeating it on every launch would become a
        # nuisance, and a nuisance is something the user learns to close
        # without reading.
        t_confirma_funcionou "$PROG" "$DUROU"
        exit 0
    fi

    # Looks only at the stretch of the log generated in this attempt.
    PARCIAL="$TANDEM_TRAVAS/parcial.$$"
    t_apaga_ao_sair "$PARCIAL"
    t_log_desde "$MARCA" > "$PARCIAL" 2>/dev/null || : > "$PARCIAL"

    VERBOS="$(t_verbos_do_log "$PARCIAL")"
    ORFAS="$(t_dlls_sem_traducao "$PARCIAL")"
    # The same pairs, kept: they are what lets us check afterwards whether the
    # missing file actually arrived.
    PARES="$(t_pares_do_log "$PARCIAL")"
    # A verdict PROVEN by this run outranks the one guessed from the import
    # table, and it reaches a case the table cannot: the driver that loads
    # into user space, reads zeros off hollow hardware APIs and makes the
    # program look merely buggy. Wine says so in the log and nowhere else.
    PROVADO="$(t_limite_do_log "$PARCIAL" 2>/dev/null)"
    if [ -n "$PROVADO" ]; then
        LIMITE="$PROVADO"
        t_diz "limite provado pelo log -> $LIMITE"
        t_memoria_grava "$PROG" LIMITE "$LIMITE" 2>/dev/null
    fi
    rm -f "$PARCIAL"

    # A single verb has a 64-bit sibling (xact -> xact_x64), and it is only
    # useful if the program is 64-bit. Swapping here, before any install,
    # avoids paying for the download of the wrong payload only to find out
    # later.
    if [ -n "$VERBOS" ]; then
        VERBOS="$(for v in $VERBOS; do t_verbo_para_arquitetura "$v" "$ARCH"; echo; done)"
        PARES="$(printf '%s\n' "$PARES" | while IFS="$(printf '\t')" read -r _d _v; do
            [ -n "$_d" ] || continue
            printf '%s\t%s\n' "$_d" "$(t_verbo_para_arquitetura "$_v" "$ARCH")"
        done)"
    fi

    # Checked against the DISK on every round, and not accumulated from the
    # install: that way the explanation still holds the second time the owner
    # opens the program, when the receipt already exists and nothing more gets
    # installed.
    BITOLA=""
    while IFS="$(printf '\t')" read -r _d _v; do
        [ -n "$_d" ] && [ -n "$_v" ] || continue
        t_dll_no_prefixo "$_d" "$ARCH"
        [ $? = 2 ] && BITOLA="${BITOLA:+$BITOLA
}$_d$(printf '\t')$_v"
    done <<PARES_FIM
$PARES
PARES_FIM

    # Receipt: never repeat an install already paid for. dotnet48 takes half
    # an hour; reinstalling it by mistake is the worst possible waste of the
    # user's time.
    RECIBO="$WINEPREFIX/.tandem-verbos"
    NOVOS=""; REPETIDOS=""; REINCIDENTES=""
    for v in $VERBOS; do
        if printf '%s\n' "$SUSPEITAS" | grep -q "$(printf '\t')$v\$"; then
            # I already tried this verb in this run and the DLL did not
            # arrive. Trying again would spend the owner's time on the same
            # mistake - half an hour, in the case of .NET.
            REINCIDENTES="$REINCIDENTES $v"
        elif [ -f "$RECIBO" ] && grep -qxF -- "$v" "$RECIBO" 2>/dev/null; then
            REPETIDOS="$REPETIDOS $v"
        else
            NOVOS="$NOVOS $v"
        fi
    done
    VERBOS="$(printf '%s\n' $NOVOS)"

    if [ -z "$VERBOS" ] && [ -n "$BITOLA" ]; then
        t_memoria_grava "$PROG" RESULTADO "bitola errada"
        t_memoria_grava "$PROG" LIMITE "bitola|$(t_texto_bitola "$BITOLA" "${ARCH:-64}")"
        t_erro "$(t_texto_bitola "$BITOLA" "${ARCH:-64}")"
        exit "$CODIGO"
    fi

    if [ -z "$VERBOS" ] && [ -n "$REINCIDENTES" ]; then
        t_memoria_grava "$PROG" RESULTADO "nao abriu"
        t_erro "$(t_texto_suspeitas "$SUSPEITAS")"
        exit "$CODIGO"
    fi

    if [ -z "$VERBOS" ] && [ -n "$REPETIDOS" ]; then
        # Negative lesson: these were installed and the program still does not
        # open. Recording it avoids promising next time that they solve it.
        for v in $REPETIDOS; do t_memoria_junta "$PROG" NAO_RESOLVERAM "$v"; done
        t_memoria_grava "$PROG" RESULTADO "nao abriu"
        # THE STRONGEST EVIDENCE THIS PROJECT EVER GETS, and it used to be
        # thrown away here. A verb reaches REPETIDOS when Wine's own loader has
        # just asked for its DLL again while the prefix carries a PERMANENT
        # receipt saying that verb was installed. That is the loader
        # contradicting the receipt, in writing, in the same log - and
        # traducao-suspeita.tsv is the work list that has already found six
        # wrong entries in the table. t_anota_suspeita was called only at
        # install time (two sites), and SUSPEITAS starts empty on every
        # process, so this moment reached nothing at all.
        #
        # The receipt is KEPT: rule 4 is about not paying twice, and the verb
        # may well have installed exactly what it promised while the program
        # wants something else entirely. This records and reports; it does not
        # retry and it does not undo.
        PEDIDAS=""
        for v in $REPETIDOS; do
            while IFS="$(printf '\t')" read -r dll verbo; do
                [ "$verbo" = "$v" ] || continue
                [ -n "$dll" ] || continue
                t_anota_suspeita "$dll" "$v" uma_vez
                case " $PEDIDAS " in *" $dll "*) ;; *) PEDIDAS="$PEDIDAS $dll" ;; esac
            done <<FIMPARES
$PARES
FIMPARES
        done
        # With no pair in hand there is nothing to name, and a sentence reading
        # "the program is still asking for:" followed by nothing is worse than
        # not saying it.
        if [ -n "$PEDIDAS" ]; then
            t_erro "$(t_msg ja_instalei_e_nao_abre "$REPETIDOS")

$(t_msg ainda_pedindo "${PEDIDAS# }")"
        else
            t_erro "$(t_msg ja_instalei_e_nao_abre "$REPETIDOS")"
        fi
        exit "$CODIGO"
    fi

    if [ -z "$VERBOS" ]; then
        if [ -n "$ORFAS" ]; then
            # WHERE it was opened from, when the place itself is the cause.
            # Every other pre-flight reads the file's contents; this reads its
            # situation, which no reader can see. Commercial software reaches a
            # Brazilian shop as a zip over WhatsApp, and double-clicking the
            # .exe inside the archive-manager window extracts that ONE file
            # without the .msi, the data folder and the DLLs beside it. "Files
            # are missing next to it" is true and gives him nothing to do.
            ONDE=""
            case "$(t_origem_do_arquivo "$PROG" 2>/dev/null)" in
                zip)       ONDE="

$(t_msg origem_zip)" ;;
                portal)    ONDE="

$(t_msg origem_portal)" ;;
                removivel) ONDE="

$(t_msg origem_removivel)" ;;
            esac
            t_erro "$(t_msg faltam_arquivos_junto "$(printf '%s\n' "$ORFAS" | tr '\n' ' ')")$ONDE"
        elif grep -qi 'Bad EXE format\|not a valid Win32' "$LOG" 2>/dev/null; then
            t_erro "$(t_msg nao_e_programa_windows)"
        elif grep -qi '32-bit installation\|64-bit installation\|WINEARCH' "$LOG" 2>/dev/null; then
            t_erro "$(t_msg conflito_bits)"
        elif [ -n "$LIMITE" ]; then
            # The pre-flight had recognized the signature before running:
            # instead of a number, the owner gets the cause and knows there
            # is no point insisting nor looking for a defect in his machine.
            #
            # Or he gets the opposite, which until 4.0 he never did. Half the
            # signatures in limites.tsv have a documented way out, and telling
            # a shop owner with a Sentinel key that his case is hopeless -
            # when the key's own manufacturer publishes the recipe for the
            # very Wine version on his machine - is the same failure as
            # showing him an exit code, only more convincing.
            if t_limite_sem_saida "${LIMITE%%|*}"; then
                # Here, and only here, Tandem offers a different program. It
                # is not suggesting a switch: it is the one moment where
                # keeping quiet would leave the owner with no way out at all.
                ALTERNATIVA="$(t_texto_alternativas "$(basename -- "${PROG%.*}")" 2>/dev/null)"
                # A real Windows in a virtual machine reaches exactly what
                # Wine cannot: a kernel driver loads, and a USB dongle can be
                # handed straight to the guest. It costs a Windows Pro licence
                # and a third of a disk, so it is said LAST and only when this
                # machine could actually carry one. Anti-cheat is excluded on
                # purpose: it refuses virtual machines by design, and sending
                # somebody down that road would waste an afternoon.
                MAQUINA=""
                [ "${LIMITE%%|*}" != anticheat ] &&
                    MAQUINA="$(t_texto_maquina_virtual 2>/dev/null)"
                t_erro "$(t_msg limite_sem_saida_txt "${LIMITE#*|}")${ALTERNATIVA:+

$(t_msg limite_no_lugar)
$ALTERNATIVA}${MAQUINA:+

$MAQUINA}"
            else
                # For a hardware key the route is only half the answer. The
                # other half is checkable right here, without downloading
                # anything: is the key's Linux daemon even running? Without
                # it the program looks for a licence and finds nothing, which
                # to the owner is indistinguishable from a broken program.
                CHAVE=""
                case "${LIMITE%%|*}" in
                    dongle-sentinel)  CHAVE="$(t_texto_chave sentinel 2>/dev/null)" ;;
                    dongle-codemeter) CHAVE="$(t_texto_chave codemeter 2>/dev/null)" ;;
                esac
                t_erro "$(t_msg limite_com_caminho "${LIMITE#*|}${CHAVE:+

  $CHAVE}")"
            fi
        else
            # Before falling back to the bare exit code, ask whether Wine said
            # outright that it does not have a function the program called. It
            # says so in the log and nowhere else, and no component install
            # will ever fix it. Tandem names the Wine version and STOPS there:
            # it does not manage Wine, and telling a shopkeeper to upgrade one
            # by hand is not an instruction he can follow safely.
            SEM_WINE="$(t_falta_no_wine "$PARCIAL" 2>/dev/null)"
            if [ -n "$SEM_WINE" ]; then
                t_memoria_grava "$PROG" RESULTADO "falta no wine" 2>/dev/null
                t_erro "$(t_msg falta_no_wine "$SEM_WINE" \
                          "$(wine --version 2>/dev/null || printf 'Wine')")"
            elif [ -n "${AMBIENTE_FALHOU:-}" ]; then
                t_erro "$(t_msg fechou_com_erro "$CODIGO")

$(t_causa_por_token "$AMBIENTE_FALHOU")"
            else
                # THE BARE EXIT CODE, which is the one outcome this project
                # exists to abolish. Reaching it can mean Tandem looked and
                # found nothing - or that it could not look at all, because
                # every check above reads the log and the log could not be
                # written. Those are different sentences and the owner was
                # getting the same one: a full disk turned "Visual C++ 2003 is
                # missing, install it with winetricks -q vcrun2003" into
                # "the program closed with an error (code 53)" and said
                # nothing about why the answer got worse.
                SEM_ANOTA="$(t_aviso_sem_log)" || SEM_ANOTA=""
                t_erro "$(t_msg fechou_com_erro "$CODIGO")${SEM_ANOTA:+

$SEM_ANOTA}"
            fi
        fi
        exit "$CODIGO"
    fi

    if [ "$PROTEGIDO" = 1 ]; then
        t_erro "$(t_msg faltam_componentes_protegido "$(for v in $VERBOS; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)")"
        exit "$CODIGO"
    fi

    if [ "$tentativa" -gt "$MAX" ]; then
        # "I installed the dependencies and it still does not open" is a LIE
        # when the machine is what failed, and it sends the owner looking at
        # the program. winetricks exiting 0 with a full disk reaches exactly
        # here: measured on a 3 MB filesystem, "No space left on device" was
        # in the log and its sentence was in the catalogue, and the two never
        # met - the cause table was only reachable when winetricks itself
        # exited non-zero, and a full disk does not make it exit non-zero.
        #
        # Appending the cause under the old sentence was the first attempt and
        # it was half a fix: "I installed the dependencies... The disk is full"
        # still opens by claiming the install happened. The message that says
        # the true thing already exists and is already translated seven times -
        # it is the one used when winetricks fails outright, which is what a
        # full disk amounts to. Reuse beats a new key: a new key is six
        # unreviewed translations, and the count of those is the project's
        # oldest open item.
        if [ -n "${AMBIENTE_FALHOU:-}" ]; then
            t_erro "$(t_msg nao_consegui_instalar "$(for v in $AMBIENTE_VERBOS; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)")

$(t_causa_por_token "$AMBIENTE_FALHOU")"
        else
            t_erro "$(t_msg instalei_e_nao_abre)"
        fi
        exit "$CODIGO"
    fi

    # "Why this component?" - each line names the runtime AND the file the
    # program actually asked for. Tandem has known the pair since 3.3
    # (t_pares_do_log keeps it so delivery can be proved afterwards) and was
    # throwing the useful half away: the owner was asked to agree to a
    # half-hour download on the strength of a product name alone. This explains
    # more and executes exactly the same, which is the criterion this project
    # holds itself to. A verb with no pair - one that came from the community
    # list rather than from this run's log - keeps the bare name, because
    # inventing a reason would be worse than not giving one.
    LISTA="$(for v in $VERBOS; do
        dlls="$(printf '%s\n' "$PARES" |
                awk -F'\t' -v alvo="$v" '$2 == alvo { print $1 }' |
                sort -u | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
        if [ -n "$dlls" ]; then
            printf -- '- %s\n' "$(t_msg componente_porque "$(t_verbo_amigavel "$v")" "$dlls")"
        else
            printf -- '- %s\n' "$(t_verbo_amigavel "$v")"
        fi
    done)"

    # If the program is 64-bit and the component only exists in 32, the
    # install is almost certainly not going to solve it. We do not block - the
    # owner decides, as with the limits - but he decides knowing, instead of
    # waiting half an hour of downloading to hear the same thing afterwards.
    SO32=""
    if [ "$ARCH" = 64 ]; then
        for v in $VERBOS; do
            t_verbo_so_32 "$v" && SO32="$SO32
- $(t_verbo_amigavel "$v")"
        done
    fi
    RESSALVA=""
    [ -n "$SO32" ] && RESSALVA="$(t_msg ressalva_so32 "$SO32")"

    if ! t_pergunta "$(t_msg componentes_pergunta "$LISTA" "$RESSALVA")" "$(t_msg botao_instalar)" "$(t_msg botao_cancelar)"; then
        # With no graphical session t_pergunta returns "no" without having
        # asked anything. Exiting quietly here was a silent failure path:
        # whoever runs it from the terminal did not even find out what was
        # missing.
        if ! t_tem_gui; then
            t_erro "$(t_msg componentes_sem_janela "$LISTA" "$(for v in $VERBOS; do printf 'winetricks -q %s\n' "$v"; done)")"
        fi
        exit "$CODIGO"
    fi

    command -v winetricks >/dev/null 2>&1 || {
        t_erro "$(t_msg falta_winetricks)"; exit 1; }

    # systemd-inhibit keeps the machine from suspending in the middle: a .NET
    # install can take 30 minutes, and suspending in the middle corrupts the
    # prefix. t_inibidor EXERCISES it instead of just checking whether the
    # binary exists - the lesson from the self-test applied here, after the
    # shortcut cost an installation.
    INIBIR="$(t_inibidor)"
    # How well this run's delivery was PROVEN, as opposed to whether the owner
    # answered. The loop only COLLECTS outcomes here; t_prova_do_run decides
    # which of them speaks for the run, and it lives in the library so the
    # ordering can be exercised without making a real winetricks fail.
    PROVA_VISTAS=""
    t_trava_prefixo_pega "$WINEPREFIX"

    t_progresso_abre "$(t_msg instalando_componentes)"
    FALHARAM=""
    # The output of the verbs that FAILED, captured as each one fails.
    #
    # MARCA_WT below is reassigned on every iteration, successes included, so
    # after the loop it marked the last verb ATTEMPTED rather than the last one
    # that failed. The whole cause table - internet, D-Bus, full disk, clock,
    # checksum, cabextract - then ran over that slice. When a program needs two
    # components and the first fails, the owner was told his internet had
    # failed, about a component whose real problem was something else entirely,
    # because a LATER component downloaded normally. He goes and looks at his
    # router. Every existing test installs a single verb, so nothing could see
    # it.
    RESTO="$TANDEM_TRAVAS/wt.$$"
    t_apaga_ao_sair "$RESTO"
    : > "$RESTO"
    for v in $VERBOS; do
        t_progresso_texto "$(t_msg instalando_componente "$(t_verbo_amigavel "$v")")"
        t_diz ">>> winetricks -q $v"
        MARCA_WT="$(t_log_marca "wt-$v")"
        if t_progresso_longo \
               "$(t_msg instalando_componente "$(t_verbo_amigavel "$v")")" \
               $INIBIR winetricks -q "$v" >>"$LOG" 2>&1; then
            # ------------------------------------ proof of delivery
            # winetricks exiting 0 says that IT finished, not that the file
            # that was missing arrived. Without this check, a wrong
            # translation wrote a receipt just like a right one - and the
            # receipt is permanent: on the next attempt Tandem said "I
            # already installed what this program asked for" and gave up,
            # with the real cause untouched. That was exactly the damage of
            # the atl*.dll pointing at Adobe Type Manager.
            #
            # Absence of proof does not condemn: only the proven
            # contradiction - the requested DLL still being absent - holds
            # back the receipt.
            FALTOU=""
            for dll in $(printf '%s\n' "$PARES" |
                         awk -F'\t' -v alvo="$v" '$2 == alvo { print $1 }'); do
                t_dll_no_prefixo "$dll" "$ARCH"
                case $? in
                    0) # PROVEN: the file that was missing is now there, in the
                       # bitness this program can use. Until 4.11 this outcome
                       # was computed and thrown away - the memory recorded only
                       # whether the OWNER answered, so "I verified the file
                       # arrived and he never clicked" and "there was nothing to
                       # verify and he never clicked" both became "so-abriu" and
                       # travelled to another machine, in a recipe and in a list
                       # record, as the same word. Absence of proof and proof
                       # are not the same evidence.
                       PROVA_VISTAS="$PROVA_VISTAS entregue" ;;
                    2) # It arrived, in the wrong bitness. This is not a wrong
                       # translation - the verb did what it promised - so the
                       # receipt holds: reinstalling is pointless. The next
                       # round recognizes the case by reading the disk and
                       # explains it to the owner.
                       t_diz "!!! $v entregou $dll na bitola errada para um programa de ${ARCH:-?} bits"
                       PROVA_VISTAS="$PROVA_VISTAS bitola-errada" ;;
                    *) FALTOU="$FALTOU $dll"
                       PROVA_VISTAS="$PROVA_VISTAS nao-chegou" ;;
                esac
            done
            if [ -n "$FALTOU" ]; then
                # WHY it did not deliver, before deciding whose fault it is.
                # winetricks exiting 0 with a full disk is not a wrong table
                # row - and this branch used to file one anyway, because the
                # cause table was only ever consulted when winetricks FAILED
                # (line 850 deletes $RESTO when nothing failed). Measured on a
                # 3 MB filesystem: "No space left on device" sat in the log
                # while the owner read "the program closed with an error
                # (code 53)" and a perfectly good mapping was filed as
                # suspicious - the same downstream harm 4.17 fixed, arriving
                # by a different road.
                FATIA_V="$(mktemp -t tandem-fatia-XXXXXX 2>/dev/null)"
                t_log_desde "$MARCA_WT" > "$FATIA_V" 2>/dev/null || :
                CAUSA_V="$(t_causa_token "$FATIA_V")"
                rm -f "$FATIA_V"
                if t_causa_e_do_ambiente "$CAUSA_V"; then
                    t_diz "!!! $v saiu 0 e nao entregou:$FALTOU - causa: $CAUSA_V (nao e a tabela)"
                    AMBIENTE_FALHOU="$CAUSA_V"
                    # Once per verb, not once per ROUND. The retry loop runs
                    # three times and this list survives all three by design,
                    # so appending unconditionally printed "- Visual C++ 2003"
                    # three times in the final message. Found by reading the
                    # output of the installed package, which is the only method
                    # that has ever caught anything here - the suite was green.
                    # The list is space-separated, which is what makes this
                    # pattern safe; on a newline-separated one it matches
                    # nothing, and that trap is written down in CLAUDE.md.
                    case " $AMBIENTE_VERBOS " in
                        *" $v "*) : ;;
                        *) AMBIENTE_VERBOS="$AMBIENTE_VERBOS $v" ;;
                    esac
                else
                    t_diz "!!! $v saiu 0 mas nao entregou:$FALTOU"
                    for dll in $FALTOU; do
                        SUSPEITAS="${SUSPEITAS:+$SUSPEITAS
}$dll$(printf '\t')$v"
                        t_anota_suspeita "$dll" "$v"
                    done
                fi
            else
                printf '%s\n' "$v" >> "$RECIBO"
            fi
            # It goes on the list either way: if the program DOES OPEN after
            # that, opening is stronger evidence than my file check, and the
            # lesson deserves to be kept.
            INSTALADOS_AGORA="$INSTALADOS_AGORA $v"
        else
            t_diz "!!! winetricks falhou em $v"
            FALHARAM="$FALHARAM $v"
            # Taken HERE, while the mark still belongs to this verb.
            t_log_desde "$MARCA_WT" >> "$RESTO" 2>/dev/null || :
        fi
    done
    wineserver -w
    t_progresso_fecha
    t_trava_prefixo_solta
    # The run's verdict on its own delivery, written where the lesson lives so
    # it travels with the recipe and with the list record.
    t_memoria_grava "$PROG" PROVA "$(t_prova_do_run "$PROVA_VISTAS")" 2>/dev/null

    # If winetricks could not download, saying "I installed the dependencies
    # and it still does not open" would be a lie - and would send the owner
    # looking for the defect in the wrong place. We read winetricks' own words
    # to explain the likely cause instead of dumping the log in his face.
    [ -n "$FALHARAM" ] || rm -f "$RESTO"
    if [ -n "$FALHARAM" ]; then
        # $RESTO already holds exactly the output of the verbs that failed,
        # accumulated inside the loop. Nothing a successful verb printed can
        # reach the cause table any more.
        PORQUE="$(t_causa_do_winetricks "$RESTO" "$LOG")"
        rm -f "$RESTO"
        t_erro "$(t_msg nao_consegui_instalar "$(for v in $FALHARAM; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)")

$PORQUE"
        exit "$CODIGO"
    fi

    tentativa=$((tentativa+1))
done
