#!/bin/bash
# Tandem - runs a Windows program, resolving dependencies on its own.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"
. "${TANDEM_LIB:-/usr/lib/tandem}/winedeps.sh"

t_log_init exe "$*"
# Before any decision about a prefix: make sure the prefixes that already
# existed are registered as untouchable.
t_primeira_vez

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "Nenhum arquivo foi informado."; exit 1; }
PROG="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$PROG" ] && [ -f "$PROG" ] || { t_erro "Arquivo não encontrado:
$BRUTO"; exit 1; }

# Without Wine, the click cannot die on a warning: we offer to install it now.
if ! command -v wine >/dev/null 2>&1; then
    if t_pergunta "O Wine, que roda os programas do Windows, não está instalado.

Posso instalar agora? Precisa de internet e da sua senha." "Instalar" "Agora não"; then
        t_progresso_abre "Instalando o Wine. Pode demorar alguns minutos..."
        t_como_root "$(t_script_instalacao wine)" >>"$LOG" 2>&1
        t_progresso_fecha
    fi
    command -v wine >/dev/null 2>&1 || {
        t_erro "O Wine não está instalado.

Instale pela Central de Programas, ou com:
sudo apt install wine

Ou deixe o Tandem instalar tudo:  tandem preparar"; exit 1; }
    t_ok "Wine instalado."
fi

# Two quick clicks fire off two processes. Without this, two concurrent
# dependency installs corrupt the prefix. Lock per file, so as not to prevent
# opening two different programs at the same time.
CHAVE="$(printf '%s' "$PROG" | cksum | tr -d ' ')"
TRAVA="$TANDEM_TRAVAS/exe-$CHAVE.lock"
# Two situations that looked like one. If ANOTHER process already holds the
# lock, bailing out is right. But if the lock cannot even be created - home
# folder full, read-only, on a network share - the "exec" fails, bash stays
# alive, flock answers "Bad file descriptor" and the old code exited with 0
# saying "this program is already opening". A lie, and invisible on a double
# click: the result was the double click doing nothing, forever. Without a
# lock the protection against a double click is lost, which is bad; refusing
# to open the program is worse.
# The braces are not decoration. "exec" WITH NO COMMAND applies the
# redirections to the whole shell, and permanently: written as
# "exec 7> file 2>/dev/null", the 2>/dev/null does not silence the exec - it
# silences stderr for ALL the rest of the program. Measured effect on an
# Ubuntu 24.04 with no graphical session: the loop detected the right DLL,
# translated it right, assembled the right message with the right command...
# and returned code 53 with zero bytes of output. The most complete silent
# failure this project has ever produced, hidden precisely inside the code
# written to fix a silent failure. With the braces, fd 7 persists and the
# stderr redirection dies at the end of the group.
if { exec 7> "$TRAVA"; } 2>/dev/null; then
    flock -n 7 || { t_aviso "Este programa já está abrindo..."; exit 0; }
else
    t_diz "nao consegui criar a trava em $TRAVA; seguindo sem ela"
fi

# ------------------------------------------------- 1. Which prefix to use
# If the file lives inside an existing prefix, respect it.
# This is what keeps Tandem from running the updater of a production system
# in an empty environment, without the dependencies that system installed.
if PREF="$(t_prefixo_do_arquivo "$PROG")"; then
    export WINEPREFIX="$PREF"
    NOSSO=0
    t_diz "prefixo detectado pelo caminho do arquivo: $PREF"
else
    export WINEPREFIX="$TANDEM_PREFIXO_PADRAO"
    NOSSO=1
fi
t_prefixo_protegido "$WINEPREFIX" && PROTEGIDO=1 || PROTEGIDO=0

export WINEDEBUG=fixme-all
# Wine uses the locale to choose the language of the Windows program. Setting
# pt_BR.UTF-8 without checking was dangerous: on a system where that locale
# was not generated (a Zorin installed in English, for instance) glib falls
# back to ASCII and zenity starts refusing every accented text - that is, all
# the error windows of this program stopped appearing, silently.
TANDEM_LOCALE="$(t_locale_utf8 "${LC_ALL:-}" pt_BR.UTF-8 "${LANG:-}")"
export LC_ALL="$TANDEM_LOCALE"
# winemenubuilder ON: it is the one that creates the Linux menu shortcut when
# a Windows installer creates a shortcut in the Start Menu.
unset WINEDLLOVERRIDES

# ------------------------------------------------ 2. Create default prefix
if [ "$NOSSO" = 1 ] && [ ! -f "$WINEPREFIX/system.reg" ]; then
    if [ -d "$WINEPREFIX" ]; then
        # "Incomplete" means without system.reg. It does not mean empty:
        # there may be an interrupted wineboot with the Documents folder
        # already full. Deleting it outright was the most silent destructive
        # path in the project - it happened inside a double click, with
        # nobody asking for anything.
        RESGATE="$(t_dados_resgate "$WINEPREFIX" ambiente-incompleto)"; C_RESGATE=$?
        case $C_RESGATE in
            0) t_aviso "O ambiente Windows estava pela metade e vai ser refeito.
Guardei os seus arquivos em:
$RESGATE" ;;
            1) # There is data here and the copy failed. This runs inside a
               # double click, so there is nobody watching a terminal: refusing
               # is the only honest move. Deleting anyway would be the exact
               # loss this whole mechanism exists to prevent.
               t_erro "$(t_texto_resgate_falhou)"
               exit 1 ;;
        esac
        t_diz "prefixo incompleto, refazendo"
        rm -rf -- "$WINEPREFIX"
    fi
    mkdir -p "$(dirname -- "$WINEPREFIX")"
    t_progresso_abre "Primeira vez: preparando o ambiente Windows..."
    (
      flock -w 1200 9 || exit 1
      # Without the Mono/Gecko dialogs in English, which stall a lay user.
      WINEARCH=win64 WINEDLLOVERRIDES="mscoree=d;mshtml=d;winemenubuilder.exe=d" \
          wineboot -u >>"$LOG" 2>&1
      wineserver -w
    ) 9> "$TANDEM_TRAVAS/prefixo.lock"
    t_progresso_fecha
    if [ ! -f "$WINEPREFIX/system.reg" ]; then
        t_erro "Não consegui preparar o ambiente Windows."; exit 1
    fi
    : > "$WINEPREFIX/.tandem-prefixo"
    PROTEGIDO=0
    t_ok "Ambiente Windows pronto."
fi
# On an already existing prefix, setting WINEARCH makes Wine refuse to start.
unset WINEARCH

# winemenubuilder does two things: it creates Linux menu shortcuts for the
# installed Windows programs (we want that) and it hijacks the system's file
# associations, stealing .txt, .jpg and .pdf (we do not want that). Turning
# off the whole binary kills both. This key turns off only the hijacking - it
# is what sits behind winecfg's "Manage File Associations" option.
# Only in a prefix of ours: in a third party's prefix nothing is changed.
if [ "$PROTEGIDO" = 0 ] && [ ! -f "$WINEPREFIX/.tandem-assoc" ]; then
    wine reg add 'HKCU\Software\Wine\FileOpenAssociations' /v Enable /t REG_SZ /d N /f \
        >>"$LOG" 2>&1 && : > "$WINEPREFIX/.tandem-assoc"
    # Cleans up whatever Wine may have already spread before this guard.
    rm -f "$HOME/.local/share/applications/wine-extension-"*.desktop 2>/dev/null
    rm -f "$HOME/.local/share/mime/packages/x-wine"* 2>/dev/null
    update-desktop-database "$HOME/.local/share/applications" 2>/dev/null
    update-mime-database "$HOME/.local/share/mime" 2>/dev/null
fi

# ------------------------------------------------------- 3. 32-bit check
ARCH="$(t_pe_arch "$PROG" 2>/dev/null || true)"
t_diz "arquitetura do PE: ${ARCH:-nao identificada}"
if [ "$ARCH" = 32 ] && ! t_tem_wine32; then
    if t_pergunta "Este programa é de 32 bits e falta esse suporte no Wine.

Posso instalar agora? Precisa de internet e da sua senha." "Instalar" "Agora não"; then
        t_progresso_abre "Instalando o suporte a 32 bits..."
        t_como_root "$(t_script_instalacao wine32)" >>"$LOG" 2>&1
        t_progresso_fecha
    fi
    if ! t_tem_wine32; then
        t_erro "Este programa é de 32 bits e falta esse suporte no Wine.

Abra o Terminal e execute:

sudo dpkg --add-architecture i386
sudo apt update
sudo apt install wine32

Ou deixe o Tandem instalar:  tandem preparar"
        exit 1
    fi
    t_ok "Suporte a 32 bits instalado."
fi
if [ "$ARCH" = arm64 ]; then
    t_erro "Este programa é para Windows ARM e não roda neste computador."
    exit 1
fi

# Pre-flight: reads the import table of the file itself, without running
# anything. It does not block and does not install - it keeps the explanation
# around in case things fail.
LIMITE="$(t_limite_do_programa "$PROG" 2>/dev/null)"
[ -n "$LIMITE" ] && t_diz "pre-voo: limite reconhecido -> $LIMITE"

# ------------------------------------------------- memory of this program
# What Tandem has already learned about THIS file, here or on another machine.
SABIDOS="$(t_memoria_le "$PROG" RESOLVERAM 2>/dev/null)"
# If this machine still knows nothing about this program, the community list
# may know. It decides nothing: it becomes exactly the same kind of suggestion
# as the local memory, and goes through the same question.
if [ -z "$SABIDOS" ]; then
    DA_LISTA="$(t_lista_consulta "$PROG" 2>/dev/null)"
    if [ -n "$DA_LISTA" ]; then
        SABIDOS="$DA_LISTA"
        # The machine count is the one thing the list knows and no forum
        # knows. Keeping that in a file and not telling the owner would be
        # throwing away the best reason he has to trust the suggestion.
        DE_QUANTAS="$(t_lista_maquinas "$(t_memoria_id "$PROG" 2>/dev/null)" 2>/dev/null)"
        t_diz "lista da comunidade conhece este programa ->$DA_LISTA (${DE_QUANTAS:-?} maquinas)"
    fi
fi
LIMITE_LEMBRADO="$(t_memoria_le "$PROG" LIMITE 2>/dev/null)"
[ -z "$LIMITE" ] && [ -n "$LIMITE_LEMBRADO" ] && LIMITE="$LIMITE_LEMBRADO"
INICIO=$SECONDS
t_memoria_grava "$PROG" ARQUITETURA "${ARCH:-?}" 2>/dev/null
[ -n "$LIMITE" ] && t_memoria_grava "$PROG" LIMITE "$LIMITE" 2>/dev/null

# The memory SUGGESTS, it never decides. Installing on its own based on a past
# lesson would be repeating a mistake forever - and in a shop owner's prefix
# that costs dearly. So it only shortens the path if he says so.
if [ -n "$SABIDOS" ] && [ "$PROTEGIDO" = 0 ] && command -v winetricks >/dev/null 2>&1; then
    PENDENTES=""
    for v in $SABIDOS; do
        # The lesson may come from the community list, which is THIRD PARTY
        # content. The same care taken with recipes applies here: a verb name
        # with an unexpected character does not become an argument to any
        # command.
        t_verbo_valido "$v" || { t_diz "verbo recusado (nome suspeito): $v"; continue; }
        v="$(t_verbo_para_arquitetura "$v" "$ARCH")"
        grep -qxF -- "$v" "$WINEPREFIX/.tandem-verbos" 2>/dev/null || PENDENTES="$PENDENTES $v"
    done
    if [ -n "$PENDENTES" ]; then
        t_diz "memoria: ja resolveram este programa ->$PENDENTES"
        ORIGEM_LICAO="Da última vez, este programa precisou"
        if [ -n "${DE_QUANTAS:-}" ] && [ "${DE_QUANTAS:-0}" -gt 1 ] 2>/dev/null; then
            ORIGEM_LICAO="Em $DE_QUANTAS máquinas este programa precisou"
        fi
        if t_pergunta "$ORIGEM_LICAO destes componentes do Windows:

$(for v in $PENDENTES; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)

Instalar agora e pular a etapa de descobrir?" "Instalar" "Tentar sem instalar"; then
            # This shortcut can also run dotnet48, which takes half an hour:
            # suspending in the middle corrupts the prefix just the same.
            INIBIR_MEM="$(t_inibidor)"
            t_progresso_abre "Instalando o que este programa já pediu antes..."
            for v in $PENDENTES; do
                t_progresso_texto "Instalando $(t_verbo_amigavel "$v")..."
                t_diz ">>> winetricks -q $v (da memoria)"
                if $INIBIR_MEM winetricks -q "$v" >>"$LOG" 2>&1; then
                    # The proof of delivery applies here too. This path used
                    # to write a receipt based on the exit code alone - that
                    # is, it bypassed the whole thesis of 3.3, and precisely
                    # where the lesson came from outside and deserves MORE
                    # distrust, not less. With no known DLL to check there is
                    # nothing to prove: absence of proof does not condemn,
                    # the usual rule.
                    ALVO="$(t_dll_do_verbo "$v")"
                    if [ -z "$ALVO" ] || t_dll_no_prefixo "$ALVO" "$ARCH"; then
                        printf '%s\n' "$v" >> "$WINEPREFIX/.tandem-verbos"
                    else
                        t_diz "!!! $v (da memoria) saiu 0 e nao entregou $ALVO"
                        t_anota_suspeita "$ALVO" "$v"
                    fi
                fi
            done
            wineserver -w
            t_progresso_fecha
        fi
    fi
fi

# ---------------------------------------------------------- 4. How to run
executar() {
    cd -- "$(dirname -- "$PROG")" || return 1
    case "${PROG,,}" in
        *.msi|*.msp)
            local wp; wp="$(wine winepath -w -- "$PROG" 2>/dev/null || printf '%s' "$PROG")"
            wine msiexec /i "$wp" >>"$LOG" 2>&1 ;;
        *.lnk|*.url|*.bat|*.cmd)
            wine start /unix -- "$PROG" >>"$LOG" 2>&1 ;;
        *)
            wine "$PROG" >>"$LOG" 2>&1 ;;
    esac
}

# ---------------------------------------------- 5. Run, detect, install, repeat
MAX=3
tentativa=1
ATALHOS_ANTES="$(t_atalhos_wine)"
INSTALADOS_AGORA=""
# "dll<TAB>verb" pairs that this run has already proven undelivered.
SUSPEITAS=""
# Pairs that did arrive, in the bitness this program cannot use.
BITOLA=""
while :; do
    MARCA=$(wc -l < "$LOG" 2>/dev/null || echo 0)
    t_aviso "Abrindo $(basename -- "$PROG")..."
    executar
    CODIGO=$?
    if [ "$CODIGO" -eq 0 ]; then
        # Learned: the verbs installed IN THIS RUN were the ones that solved
        # it. Keeping only the ones that came now avoids crediting the recipe
        # with something that was already in the prefix for another reason.
        for v in $INSTALADOS_AGORA; do t_memoria_junta "$PROG" RESOLVERAM "$v"; done
        DUROU=$((SECONDS-INICIO))
        t_memoria_grava "$PROG" RESULTADO abriu
        t_memoria_grava "$PROG" SEGUNDOS "$DUROU"
        t_memoria_grava "$PROG" VISTO_EM "$(date +%F)"
        # If it was an installer, shortcuts showed up: say where the program
        # ended up. If it was just a program running, nothing shows up and
        # nothing is said.
        t_anuncia_atalhos "$ATALHOS_ANTES"

        # ------------------------------------------------ silent success
        #
        # Code 0 says the process finished without an error. It does not say
        # the program worked. Wine's characteristic failure mode with
        # commercial software is not closing with an error - it is opening
        # and being subtly wrong: a receipt with broken accents, a blank
        # report, an inverted date, a window that never appeared. All of that
        # exits 0. A project whose yardstick is "no silent failures" had a
        # silent success at its center, and the recipe exported the wrong
        # lesson with the same confidence as a right one.
        #
        # The only witness to what happened on screen is the owner. We ask
        # ONCE per program - repeating it on every launch would become a
        # nuisance, and a nuisance is something the user learns to close
        # without reading.
        t_confirma_funcionou "$PROG" "$DUROU"
        exit 0
    fi

    # Looks only at the stretch of the log generated in this attempt.
    PARCIAL="$TANDEM_TRAVAS/parcial.$$"
    tail -n +"$((MARCA+1))" "$LOG" > "$PARCIAL" 2>/dev/null || : > "$PARCIAL"

    VERBOS="$(t_verbos_do_log "$PARCIAL")"
    ORFAS="$(t_dlls_sem_traducao "$PARCIAL")"
    # The same pairs, kept: they are what lets us check afterwards whether the
    # missing file actually arrived.
    PARES="$(t_pares_do_log "$PARCIAL")"
    rm -f "$PARCIAL"

    # A single verb has a 64-bit sibling (xact -> xact_x64), and it is only
    # useful if the program is 64-bit. Swapping here, before any install,
    # avoids paying for the download of the wrong payload only to find out
    # later.
    if [ -n "$VERBOS" ]; then
        VERBOS="$(for v in $VERBOS; do t_verbo_para_arquitetura "$v" "$ARCH"; echo; done)"
        PARES="$(printf '%s\n' "$PARES" | while IFS="$(printf '\t')" read -r _d _v; do
            [ -n "$_d" ] || continue
            printf '%s\t%s\n' "$_d" "$(t_verbo_para_arquitetura "$_v" "$ARCH")"
        done)"
    fi

    # Checked against the DISK on every round, and not accumulated from the
    # install: that way the explanation still holds the second time the owner
    # opens the program, when the receipt already exists and nothing more gets
    # installed.
    BITOLA=""
    while IFS="$(printf '\t')" read -r _d _v; do
        [ -n "$_d" ] && [ -n "$_v" ] || continue
        t_dll_no_prefixo "$_d" "$ARCH"
        [ $? = 2 ] && BITOLA="${BITOLA:+$BITOLA
}$_d$(printf '\t')$_v"
    done <<PARES_FIM
$PARES
PARES_FIM

    # Receipt: never repeat an install already paid for. dotnet48 takes half
    # an hour; reinstalling it by mistake is the worst possible waste of the
    # user's time.
    RECIBO="$WINEPREFIX/.tandem-verbos"
    NOVOS=""; REPETIDOS=""; REINCIDENTES=""
    for v in $VERBOS; do
        if printf '%s\n' "$SUSPEITAS" | grep -q "$(printf '\t')$v\$"; then
            # I already tried this verb in this run and the DLL did not
            # arrive. Trying again would spend the owner's time on the same
            # mistake - half an hour, in the case of .NET.
            REINCIDENTES="$REINCIDENTES $v"
        elif [ -f "$RECIBO" ] && grep -qxF -- "$v" "$RECIBO" 2>/dev/null; then
            REPETIDOS="$REPETIDOS $v"
        else
            NOVOS="$NOVOS $v"
        fi
    done
    VERBOS="$(printf '%s\n' $NOVOS)"

    if [ -z "$VERBOS" ] && [ -n "$BITOLA" ]; then
        t_memoria_grava "$PROG" RESULTADO "bitola errada"
        t_memoria_grava "$PROG" LIMITE "bitola|$(t_texto_bitola "$BITOLA" "${ARCH:-64}")"
        t_erro "$(t_texto_bitola "$BITOLA" "${ARCH:-64}")"
        exit "$CODIGO"
    fi

    if [ -z "$VERBOS" ] && [ -n "$REINCIDENTES" ]; then
        t_memoria_grava "$PROG" RESULTADO "nao abriu"
        t_erro "$(t_texto_suspeitas "$SUSPEITAS")"
        exit "$CODIGO"
    fi

    if [ -z "$VERBOS" ] && [ -n "$REPETIDOS" ]; then
        # Negative lesson: these were installed and the program still does not
        # open. Recording it avoids promising next time that they solve it.
        for v in $REPETIDOS; do t_memoria_junta "$PROG" NAO_RESOLVERAM "$v"; done
        t_memoria_grava "$PROG" RESULTADO "nao abriu"
        t_erro "Já instalei o que este programa pedia:$REPETIDOS

E ele continua não abrindo. Provavelmente depende de algo que o Wine ainda não suporta, ou de um arquivo que deveria vir junto com ele."
        exit "$CODIGO"
    fi

    if [ -z "$VERBOS" ]; then
        if [ -n "$ORFAS" ]; then
            t_erro "O programa não abriu porque faltam arquivos que ele deveria trazer junto:

$(printf '%s\n' "$ORFAS" | tr '\n' ' ')

Isso costuma acontecer quando só o executável foi copiado, sem a pasta completa do programa."
        elif grep -qi 'Bad EXE format\|not a valid Win32' "$LOG" 2>/dev/null; then
            t_erro "Este arquivo não é um programa do Windows compatível."
        elif grep -qi '32-bit installation\|64-bit installation\|WINEARCH' "$LOG" 2>/dev/null; then
            t_erro "Conflito de ambiente Windows (32 x 64 bits) neste perfil."
        elif [ -n "$LIMITE" ]; then
            # The pre-flight had recognized the signature before running:
            # instead of a number, the owner gets the cause and knows there
            # is no point insisting nor looking for a defect in his machine.
            #
            # And here, only here, Tandem offers an alternative path. It is
            # not suggesting a switch: it is the one moment where keeping
            # quiet would leave the owner with no way out at all, because
            # this program is not going to work no matter how hard he tries.
            ALTERNATIVA="$(t_texto_alternativas "$(basename -- "${PROG%.*}")" 2>/dev/null)"
            t_erro "Este programa não abriu, e provavelmente não tem conserto:

${LIMITE#*|}

Isso é limite do Wine, não defeito da sua máquina nem do Tandem.${ALTERNATIVA:+

O que dá para fazer no lugar:
$ALTERNATIVA}"
        else
            t_erro "O programa fechou com erro (código $CODIGO)."
        fi
        exit "$CODIGO"
    fi

    if [ "$PROTEGIDO" = 1 ]; then
        t_erro "Faltam componentes do Windows para este programa:

$(for v in $VERBOS; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)

O Tandem não instala nada automaticamente neste perfil, porque ele pertence a outro sistema e a alteração poderia quebrá-lo."
        exit "$CODIGO"
    fi

    if [ "$tentativa" -gt "$MAX" ]; then
        t_erro "Instalei as dependências mas o programa continua não abrindo."
        exit "$CODIGO"
    fi

    LISTA="$(for v in $VERBOS; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)"

    # If the program is 64-bit and the component only exists in 32, the
    # install is almost certainly not going to solve it. We do not block - the
    # owner decides, as with the limits - but he decides knowing, instead of
    # waiting half an hour of downloading to hear the same thing afterwards.
    SO32=""
    if [ "$ARCH" = 64 ]; then
        for v in $VERBOS; do
            t_verbo_so_32 "$v" && SO32="$SO32
- $(t_verbo_amigavel "$v")"
        done
    fi
    RESSALVA=""
    [ -n "$SO32" ] && RESSALVA="

Aviso: este programa é de 64 bits, e isto aqui só existe em 32:$SO32

Instalar provavelmente não vai resolver. Não é defeito da sua máquina: quem distribui esse componente nunca publicou a versão de 64 bits."

    if ! t_pergunta "O programa precisa destes componentes do Windows:

$LISTA$RESSALVA

Posso instalar agora?" "Instalar" "Cancelar"; then
        # With no graphical session t_pergunta returns "no" without having
        # asked anything. Exiting quietly here was a silent failure path:
        # whoever runs it from the terminal did not even find out what was
        # missing.
        if ! t_tem_gui; then
            t_erro "O programa precisa destes componentes do Windows:

$LISTA

Não há como perguntar sem uma janela. Instale com:
$(for v in $VERBOS; do printf 'winetricks -q %s\n' "$v"; done)"
        fi
        exit "$CODIGO"
    fi

    command -v winetricks >/dev/null 2>&1 || {
        t_erro "Falta o winetricks para instalar as dependências.

sudo apt install winetricks"; exit 1; }

    # systemd-inhibit keeps the machine from suspending in the middle: a .NET
    # install can take 30 minutes, and suspending in the middle corrupts the
    # prefix. t_inibidor EXERCISES it instead of just checking whether the
    # binary exists - the lesson from the self-test applied here, after the
    # shortcut cost an installation.
    INIBIR="$(t_inibidor)"

    t_progresso_abre "Instalando componentes do Windows. Pode demorar. Não feche esta janela."
    FALHARAM=""
    for v in $VERBOS; do
        t_progresso_texto "Instalando $(t_verbo_amigavel "$v")..."
        t_diz ">>> winetricks -q $v"
        MARCA_WT=$(wc -l < "$LOG" 2>/dev/null || echo 0)
        if $INIBIR winetricks -q "$v" >>"$LOG" 2>&1; then
            # ------------------------------------ proof of delivery
            # winetricks exiting 0 says that IT finished, not that the file
            # that was missing arrived. Without this check, a wrong
            # translation wrote a receipt just like a right one - and the
            # receipt is permanent: on the next attempt Tandem said "I
            # already installed what this program asked for" and gave up,
            # with the real cause untouched. That was exactly the damage of
            # the atl*.dll pointing at Adobe Type Manager.
            #
            # Absence of proof does not condemn: only the proven
            # contradiction - the requested DLL still being absent - holds
            # back the receipt.
            FALTOU=""
            for dll in $(printf '%s\n' "$PARES" |
                         awk -F'\t' -v alvo="$v" '$2 == alvo { print $1 }'); do
                t_dll_no_prefixo "$dll" "$ARCH"
                case $? in
                    0) ;;
                    2) # It arrived, in the wrong bitness. This is not a wrong
                       # translation - the verb did what it promised - so the
                       # receipt holds: reinstalling is pointless. The next
                       # round recognizes the case by reading the disk and
                       # explains it to the owner.
                       t_diz "!!! $v entregou $dll na bitola errada para um programa de ${ARCH:-?} bits" ;;
                    *) FALTOU="$FALTOU $dll" ;;
                esac
            done
            if [ -n "$FALTOU" ]; then
                t_diz "!!! $v saiu 0 mas nao entregou:$FALTOU"
                for dll in $FALTOU; do
                    SUSPEITAS="${SUSPEITAS:+$SUSPEITAS
}$dll$(printf '\t')$v"
                    t_anota_suspeita "$dll" "$v"
                done
            else
                printf '%s\n' "$v" >> "$RECIBO"
            fi
            # It goes on the list either way: if the program DOES OPEN after
            # that, opening is stronger evidence than my file check, and the
            # lesson deserves to be kept.
            INSTALADOS_AGORA="$INSTALADOS_AGORA $v"
        else
            t_diz "!!! winetricks falhou em $v"
            FALHARAM="$FALHARAM $v"
        fi
    done
    wineserver -w
    t_progresso_fecha

    # If winetricks could not download, saying "I installed the dependencies
    # and it still does not open" would be a lie - and would send the owner
    # looking for the defect in the wrong place. We read winetricks' own words
    # to explain the likely cause instead of dumping the log in his face.
    if [ -n "$FALHARAM" ]; then
        RESTO="$TANDEM_TRAVAS/wt.$$"
        tail -n +"$((MARCA_WT+1))" "$LOG" > "$RESTO" 2>/dev/null || : > "$RESTO"
        # The most common cause is the internet, but claiming that without
        # evidence sends the owner looking for the defect in the wrong place -
        # which is what happened when systemd-inhibit brought the install down
        # before it even started. With no sign of a download being attempted,
        # the honest answer is not knowing.
        if grep -qiE 'saved \[|wget|Downloading|HTTP request sent' "$RESTO" 2>/dev/null; then
            PORQUE="Verifique se o computador está conectado à internet."
        else
            PORQUE="Não consegui identificar a causa. Os detalhes técnicos estão em:
$LOG"
        fi
        if grep -qi 'Failed to connect to bus' "$RESTO" 2>/dev/null; then
            PORQUE="Falta um serviço do sistema (D-Bus). Reiniciar o computador costuma resolver."
        elif grep -qi 'No space left on device' "$RESTO" 2>/dev/null; then
            PORQUE="O disco está cheio."
        elif grep -qi 'certificate\|SSL\|not yet valid\|has expired' "$RESTO" 2>/dev/null; then
            PORQUE="A data do computador parece errada, e isso derruba os downloads.
Hoje o computador acha que é $(date '+%d/%m/%Y')."
        elif grep -qi 'Could not resolve host\|Network is unreachable\|Connection timed out' "$RESTO" 2>/dev/null; then
            PORQUE="O computador não conseguiu acessar a internet."
        elif grep -qi 'sha256sum mismatch\|checksum' "$RESTO" 2>/dev/null; then
            PORQUE="O arquivo baixado veio corrompido. Tente de novo mais tarde."
        elif grep -qi 'cabextract' "$RESTO" 2>/dev/null; then
            PORQUE="Falta o programa cabextract. Instale com: sudo apt install cabextract"
        fi
        rm -f "$RESTO"
        t_erro "Não consegui instalar:
$(for v in $FALHARAM; do printf -- '- %s\n' "$(t_verbo_amigavel "$v")"; done)

$PORQUE"
        exit "$CODIGO"
    fi

    tentativa=$((tentativa+1))
done
