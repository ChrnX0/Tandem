#!/bin/bash
# Tandem - runs a Java program (.jar).
#
# A .jar fails on a double click for two reasons, and Java announces both of
# them in words nobody outside the trade can act on.
#
#   "no main manifest attribute"  means the file is a piece of a program, not a
#   program. The two are indistinguishable from the outside - same extension,
#   same icon - and the owner has no way of knowing he downloaded the wrong one.
#
#   "UnsupportedClassVersionError: class file version 65.0" means the program
#   needs a newer Java. The number 65 appears nowhere on the download page; the
#   number the page shows is 21. They differ by 44.
#
# Both are read off the file before anything runs, so the answer arrives in two
# seconds instead of after a failure.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"

t_log_init jar "$*"

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "$(t_msg sem_arquivo)"; exit 1; }
PROG="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$PROG" ] && [ -f "$PROG" ] || { t_erro "$(t_msg arquivo_sumiu "$BRUTO")"; exit 1; }

# See the long comment in tandem-exe about the braces around exec.
CHAVE="$(printf '%s' "$PROG" | cksum | tr -d ' ')"
if { exec 7> "$TANDEM_TRAVAS/jar-$CHAVE.lock"; } 2>/dev/null; then
    flock -n 7 || { t_aviso "$(t_msg ja_abrindo)"; exit 0; }
else
    t_diz "could not create the lock; continuing without it"
fi

# ------------------------------------------------- 1. Read it without running
INFO="$(t_jar_info "$PROG")"
t_diz "$INFO"
ERRO="$(t_campo "$INFO" ERRO)"
PRINCIPAL="$(t_campo "$INFO" PRINCIPAL)"
PEDE="$(t_campo "$INFO" JAVA)"
JAVAFX="$(t_campo "$INFO" JAVAFX)"
AGENTE="$(t_campo "$INFO" AGENTE)"
DEPS="$(t_campo "$INFO" DEPENDENCIAS)"

if [ -n "$ERRO" ] && t_parece_pagina_web "$PROG"; then
    # BEFORE the truncation verdict, not after. An HTML error page named .jar
    # fails as zip_invalido, because a zip's index lives at the end of the file
    # - so the honest-looking "the download stopped part way" is exactly what
    # this case produces, and it sends the owner back to the same link to fetch
    # the same page, for ever.
    t_erro "$(t_msg baixou_pagina_web "$(basename -- "$PROG")")"
    exit 1
fi
if [ "$ERRO" = zip_invalido ]; then
    # The index of a .jar lives at the end of the file, so an interrupted
    # download always breaks it here - and it breaks looking like a corrupt
    # program rather than like a partial transfer.
    t_memoria_grava "$PROG" RESULTADO "incompleto" 2>/dev/null
    t_erro "$(t_msg jar_incompleto "$(basename -- "$PROG")")"
    exit 1
fi
if [ -n "$ERRO" ]; then
    t_erro "$(t_msg nao_consegui_ler "$(t_erro_do_leitor "$ERRO")")"
    exit 1
fi

# ------------------------------------- 2. Is this a program at all? Pre-flight
if [ -z "$PRINCIPAL" ]; then
    if [ "$AGENTE" = 1 ]; then
        t_memoria_grava "$PROG" LIMITE "agente|nao abre sozinho" 2>/dev/null
        t_erro "$(t_texto_jar_agente)"
    else
        t_memoria_grava "$PROG" LIMITE "biblioteca|nao abre sozinho" 2>/dev/null
        t_erro "$(t_texto_jar_biblioteca)"
    fi
    exit 1
fi
t_diz "main class: $PRINCIPAL, needs java ${PEDE:-?}"

# --------------------------------------------------------------- 3. The Java
if ! command -v java >/dev/null 2>&1; then
    if t_pergunta "$(t_msg jar_falta_java_pergunta)" \
       "$(t_msg botao_instalar)" "$(t_msg botao_agora_nao)"; then
        t_progresso_abre "$(t_msg jar_instalando_java)"
        t_como_root "$(t_script_instalacao java)" >>"$LOG" 2>&1
        t_progresso_fecha
    fi
    command -v java >/dev/null 2>&1 || { t_erro "$(t_texto_java_falta)"; exit 1; }
    t_ok "$(t_msg jar_java_instalado)"
fi
TEM="$(t_java_versao)"
t_diz "java installed: ${TEM:-not identified}"

# Checked BEFORE running, because Java's own answer for this case names a
# number that means nothing to the owner. If the installed Java is not
# identified we do not block: not knowing is not evidence.
if [ -n "$PEDE" ] && [ -n "$TEM" ] && [ "$PEDE" -gt "$TEM" ] 2>/dev/null; then
    t_memoria_grava "$PROG" RESULTADO "java antigo" 2>/dev/null
    t_memoria_grava "$PROG" JAVA "$PEDE" 2>/dev/null
    if t_pergunta "$(t_texto_java_antigo "$PEDE" "$TEM")

$(t_msg jar_pode_instalar_java "$PEDE")" \
       "$(t_msg botao_instalar)" "$(t_msg botao_agora_nao)"; then
        t_progresso_abre "$(t_msg jar_instalando_java_versao "$PEDE")"
        t_como_root "$(t_script_instalacao "java$PEDE")" >>"$LOG" 2>&1
        t_progresso_fecha
        TEM="$(t_java_versao)"
    fi
    if [ -n "$TEM" ] && [ "$PEDE" -gt "$TEM" ] 2>/dev/null; then
        t_erro "$(t_texto_java_antigo "$PEDE" "$TEM")"
        exit 1
    fi
    t_ok "$(t_msg jar_java_versao_instalado "$PEDE")"
fi
[ -n "$PEDE" ] && t_memoria_grava "$PROG" JAVA "$PEDE" 2>/dev/null

# A Class-Path in the manifest names files that have to sit next to this one.
# When they are missing, Java fails deep inside the program with a class name -
# never with the name of the file that is actually absent.
SEM_DEPS=""
if [ -n "$DEPS" ]; then
    PASTA="$(dirname -- "$PROG")"
    for d in ${DEPS//,/ }; do
        [ -e "$PASTA/$d" ] || SEM_DEPS="$SEM_DEPS $d"
    done
    [ -n "$SEM_DEPS" ] && t_diz "declared and missing dependencies:$SEM_DEPS"
fi

INICIO=$SECONDS
t_aviso "$(t_msg abrindo "$(basename -- "$PROG")")"
# THE WORDS OF THIS RUN, in a file only this run writes to. A marker fixes
# where a slice STARTS and cannot keep another Tandem's lines out of the
# middle - and the log is shared, one file per handler with no PID in the name.
# Measured with two double clicks a second apart: the program that printed
# nothing was reported as having said the OTHER program's words, and the
# silent-success guard was defeated at the same time. See t_saida_abre.
SAIDA="$(t_saida_abre jar)"
(
    cd -- "$(dirname -- "$PROG")" || exit 1
    java -jar "$PROG" >>"$SAIDA" 2>&1
)
CODIGO=$?
t_saida_fecha "$SAIDA"

if [ "$CODIGO" -eq 0 ]; then
    DUROU=$((SECONDS-INICIO))
    t_memoria_grava "$PROG" RESULTADO abriu 2>/dev/null
    t_memoria_grava "$PROG" SEGUNDOS "$DUROU" 2>/dev/null
    t_memoria_grava "$PROG" VISTO_EM "$(date +%F)" 2>/dev/null
    t_confirma_funcionou "$PROG" "$DUROU"
    exit 0
fi

PARCIAL="$SAIDA"

# ------------------------------------------------- 4. What Java complained of
if grep -q 'UnsupportedClassVersionError' "$PARCIAL" 2>/dev/null; then
    # Reading it from the message as well as from the file: a fat jar can carry
    # one class newer than all the others, and only the failure names it.
    MAIOR="$(sed -n 's/.*class file version \([0-9]*\).*/\1/p' "$PARCIAL" | head -1)"
    [ -n "$MAIOR" ] && PEDE=$((MAIOR-44))
    rm -f "$PARCIAL"
    t_memoria_grava "$PROG" RESULTADO "java antigo" 2>/dev/null
    [ -n "$PEDE" ] && t_memoria_grava "$PROG" JAVA "$PEDE" 2>/dev/null
    t_erro "$(t_texto_java_antigo "${PEDE:-$(t_msg java_pede_desconhecido)}" "${TEM:-$(t_msg java_tem_desconhecido)}")"
    exit "$CODIGO"
fi

if grep -qi 'javafx' "$PARCIAL" 2>/dev/null || [ "$JAVAFX" = 1 ]; then
    rm -f "$PARCIAL"
    t_memoria_grava "$PROG" RESULTADO "falta javafx" 2>/dev/null
    t_erro "$(t_texto_jar_javafx)"
    exit "$CODIGO"
fi

if [ -n "$SEM_DEPS" ] &&
   grep -q 'NoClassDefFoundError\|ClassNotFoundException' "$PARCIAL" 2>/dev/null; then
    rm -f "$PARCIAL"
    t_memoria_grava "$PROG" RESULTADO "faltam arquivos" 2>/dev/null
    t_erro "$(t_msg jar_faltam_dependencias "$(for d in $SEM_DEPS; do printf -- '\n- %s' "$d"; done)")"
    exit "$CODIGO"
fi

if grep -q 'HeadlessException\|No X11 DISPLAY\|Can.t connect to X11' "$PARCIAL" 2>/dev/null; then
    rm -f "$PARCIAL"
    t_erro "$(t_msg jar_precisa_tela)"
    exit "$CODIGO"
fi

if grep -q 'Unable to access jarfile' "$PARCIAL" 2>/dev/null; then
    rm -f "$PARCIAL"
    t_erro "$(t_msg jar_java_nao_leu)"
    exit "$CODIGO"
fi

# The program's own words, in English, because they are its words: inventing a
# translation here would be inventing a cause.
ULTIMAS="$(t_palavras_do_programa "$PARCIAL")"
rm -f "$PARCIAL"
t_memoria_grava "$PROG" RESULTADO "nao abriu" 2>/dev/null
t_erro "$(t_msg fechou_com_erro "$CODIGO")${ULTIMAS:+

$(t_msg programa_disse)

$ULTIMAS}

$(t_msg registro_completo_em "$LOG")"
exit "$CODIGO"
