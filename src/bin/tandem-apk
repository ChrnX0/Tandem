#!/bin/bash
# Tandem - installs an Android app (.apk, .xapk, .apks, .apkm) into Waydroid.
. "${TANDEM_LIB:-/usr/lib/tandem}/common.sh"

t_log_init apk "$*"

BRUTO="${1:-}"
[ -n "$BRUTO" ] || { t_erro "$(t_msg sem_arquivo)"; exit 1; }
APK="$(readlink -f -- "$BRUTO" 2>/dev/null)"
[ -n "$APK" ] && [ -f "$APK" ] || { t_erro "$(t_msg arquivo_sumiu "$BRUTO")"; exit 1; }

TMP=""
limpar() {
    t_progresso_fecha
    [ -n "$TMP" ] && [ -d "$TMP" ] && rm -rf -- "$TMP"
}
trap limpar EXIT INT TERM

# Same distinction as in tandem-exe: a lock held by another process is one
# case, a lock that cannot be created at all is another. Confusing the two
# turned "home folder full" into the wrong message "another installation in
# progress". The braces keep the 2>/dev/null from becoming a permanent
# redirection of the whole program's stderr. See the long comment in
# tandem-exe: without them, every error path with no graphical session ends
# in zero bytes of output.
if { exec 9> "$TANDEM_TRAVAS/apk.lock"; } 2>/dev/null; then
    flock -w 900 9 || { t_erro "$(t_msg ja_instalando)"; exit 1; }
else
    t_diz "nao consegui criar a trava de instalacao; seguindo sem ela"
fi

# ------------------------------------------------- 1. Prior inspection
INFO="$(python3 "${TANDEM_LIB:-/usr/lib/tandem}/apkinfo.py" "$APK" 2>>"$LOG")"
t_diz "$INFO"
FORMATO=""; PACOTE=""; MINSDK=""; ABIS=""; SPLITS=1; OBB=0; ERRO=""; CIFRADO=0
while IFS='=' read -r k v; do
    case "$k" in
        FORMATO) FORMATO="$v" ;; PACOTE) PACOTE="$v" ;; MINSDK) MINSDK="$v" ;;
        ABIS) ABIS="$v" ;; SPLITS) SPLITS="$v" ;; OBB) OBB="$v" ;; ERRO) ERRO="$v" ;;
        CIFRADO) CIFRADO="$v" ;;
    esac
done <<< "$INFO"

# An .apkm the distributing site encrypted. Nothing but that site's own installer
# opens one, so there is nothing to attempt - and attempting it produces a
# Python exception in English about a missing password, which is the failure mode
# this project treats as a defect.
if [ "$CIFRADO" = 1 ]; then
    t_memoria_grava "$APK" RESULTADO "cifrado" 2>/dev/null
    t_erro "$(t_msg apk_cifrado)"
    exit 1
fi

if [ -n "$ERRO" ]; then
    # Before the reader's own complaint, which is true and useless when the
    # file is an error page the site handed back instead of the program: a
    # download that goes wrong rarely produces nothing. Same ordering and
    # same sentence tandem-deb has had since 3.8 - eight handlers were never
    # wired to a detector and a translated message that already existed.
    if t_parece_pagina_web "$APK"; then
        t_erro "$(t_msg baixou_pagina_web "$(basename -- "$APK")")"
    else
        t_erro "$(t_msg nao_consegui_ler "$(t_erro_do_leitor "$ERRO")")"
    fi
    exit 1
fi
if [ "$FORMATO" = "desconhecido" ]; then
    t_memoria_grava "$APK" RESULTADO "nao e android" 2>/dev/null
    t_erro "$(t_msg apk_nao_e_android)"; exit 1
fi

t_progresso_abre "$(t_msg apk_preparando)"
t_wd_garantir || exit 1

# ------------------------------------------- 2. Compatibility, before trying
SDK="$(t_wd_sdk)"
if [ -n "$MINSDK" ] && [ -n "$SDK" ] && [ "$MINSDK" -gt "$SDK" ] 2>/dev/null; then
    t_progresso_fecha
    # Remembered because it is a property of the FILE and this machine, and it
    # will still be true tomorrow. Every other handler writes what it learned;
    # this one wrote nothing at all, so "tandem memoria" knew nothing about an
    # .apk and "tandem socorro" carried nothing about Android.
    t_memoria_grava "$APK" RESULTADO "android antigo" 2>/dev/null
    t_memoria_grava "$APK" LIMITE "versao|$MINSDK>$SDK" 2>/dev/null
    t_erro "$(t_msg apk_sdk_novo_demais "$MINSDK" "$SDK")"
    exit 1
fi

# Only ARM libraries? Then the translator is required.
if [ -n "$ABIS" ] && ! printf '%s' "$ABIS" | grep -q 'x86'; then
    if ! t_wd_tem_arm; then
        t_progresso_fecha
        t_memoria_grava "$APK" RESULTADO "so arm" 2>/dev/null
        t_memoria_grava "$APK" LIMITE "arquitetura|arm sem tradutor" 2>/dev/null
        t_erro "$(t_msg apk_arm_com_tradutor)"
        exit 1
    fi
    t_diz "app ARM-only, tradutor presente"
fi

# ------------------------------------------------------- 3. Install
# Written out at each branch rather than through a local helper, and that is a
# decision about the INSTRUMENT rather than about style: tools/conta-literais.py
# excludes an argument by where it GOES, and it knows t_memoria_grava. Routing
# these through a wrapper made ten on-disk tokens look like ten untranslated
# sentences. Teaching the counter to follow wrappers, or adding a local function
# name to its global list, is the rule-by-name mistake that failed thirteen
# times. The values are Portuguese on-disk tokens like every other handler's.
resultado() {
    local saida="$1"
    case "$saida" in
        *NO_MATCHING_ABIS*)
            t_memoria_grava "$APK" RESULTADO "so arm" 2>/dev/null
            t_erro "$(t_msg apk_arm_sem_saida)" ;;
        *INSTALL_FAILED_OLDER_SDK*)
            t_memoria_grava "$APK" RESULTADO "android antigo" 2>/dev/null
            t_erro "$(t_msg apk_sdk_curto)" ;;
        *INSTALL_FAILED_ALREADY_EXISTS*)
            t_memoria_grava "$APK" RESULTADO "ja instalado" 2>/dev/null
            t_erro "$(t_msg apk_ja_instalado)" ;;
        *INSTALL_FAILED_VERSION_DOWNGRADE*)
            t_memoria_grava "$APK" RESULTADO "versao mais nova" 2>/dev/null
            t_erro "$(t_msg apk_versao_mais_nova)" ;;
        *INSTALL_FAILED_INSUFFICIENT_STORAGE*)
            t_memoria_grava "$APK" RESULTADO "sem espaco" 2>/dev/null
            t_erro "$(t_msg apk_sem_espaco)" ;;
        *INSTALL_PARSE_FAILED_NO_CERTIFICATES*)
            t_memoria_grava "$APK" RESULTADO "sem assinatura" 2>/dev/null
            t_erro "$(t_msg apk_sem_assinatura)" ;;
        *INSTALL_PARSE_FAILED*)
            t_memoria_grava "$APK" RESULTADO "incompleto" 2>/dev/null
            t_erro "$(t_msg apk_corrompido)" ;;
        *INSTALL_FAILED_MISSING_SPLIT*)
            t_memoria_grava "$APK" RESULTADO "faltam partes" 2>/dev/null
            t_erro "$(t_msg apk_faltam_partes)" ;;
        *Success*)
            t_memoria_grava "$APK" RESULTADO instalado 2>/dev/null
            t_memoria_grava "$APK" VISTO_EM "$(date +%F)" 2>/dev/null
            [ -n "$PACOTE" ] && t_memoria_grava "$APK" PACOTE "$PACOTE" 2>/dev/null
            t_ok "$(t_msg apk_instalado_pacote "${PACOTE:+ ($PACOTE)}")"
            return 0 ;;
        *Failure*|*INSTALL_FAILED*|*Exception*|*error:*|*Error:*)
            t_memoria_grava "$APK" RESULTADO "nao instalou" 2>/dev/null
            t_erro "$(t_msg apk_nao_instalou)" ;;
        *)
            # No keyword: confirm by asking Android itself.
            if [ -n "$PACOTE" ] && waydroid shell -- pm list packages 2>/dev/null |
                 grep -q "package:$PACOTE"; then
                t_memoria_grava "$APK" RESULTADO instalado 2>/dev/null
            t_memoria_grava "$APK" VISTO_EM "$(date +%F)" 2>/dev/null
            [ -n "$PACOTE" ] && t_memoria_grava "$APK" PACOTE "$PACOTE" 2>/dev/null
                t_ok "$(t_msg apk_instalado_simples)"
                return 0
            fi
            t_memoria_grava "$APK" RESULTADO "nao confirmou" 2>/dev/null
            t_erro "$(t_msg apk_nao_confirmou)" ;;
    esac
    return 1
}

if [ "$FORMATO" = "apk" ]; then
    t_progresso_texto "$(t_msg apk_instalando "$(basename -- "$APK")")"
    SAIDA="$(timeout 300 waydroid app install "$APK" 2>&1)"
    t_diz "$SAIDA"
    t_progresso_fecha
    resultado "$SAIDA"; exit $?
fi

# ---------------------------- 4. Split package (xapk/apks/apkm) via ADB
t_progresso_texto "$(t_msg apk_extraindo_partes "$SPLITS")"
TMP="$(mktemp -d)"
if ! unzip -q -o "$APK" -d "$TMP" 2>>"$LOG"; then
    t_progresso_fecha
    t_memoria_grava "$APK" RESULTADO "pacote nao abre" 2>/dev/null
    t_erro "$(t_msg apk_pacote_nao_abre)"
    exit 1
fi

mapfile -t PARTES < <(find "$TMP" -maxdepth 2 -type f -iname '*.apk' | sort)
[ "${#PARTES[@]}" -gt 0 ] || {
    t_progresso_fecha
    t_memoria_grava "$APK" RESULTADO "pacote vazio" 2>/dev/null
    t_erro "$(t_msg apk_pacote_vazio)"; exit 1; }

command -v adb >/dev/null 2>&1 || {
    t_progresso_fecha
    t_erro "$(t_msg apk_falta_adb)"; exit 1; }

IP="$(t_wd_ip)"
[ -n "$IP" ] || { t_progresso_fecha; t_erro "$(t_msg apk_sem_endereco)"; exit 1; }

t_progresso_texto "$(t_msg apk_conectando "$IP")"
adb connect "$IP:5555" >>"$LOG" 2>&1
for _ in $(seq 1 10); do
    adb -s "$IP:5555" get-state 2>/dev/null | grep -q device && break
    sleep 1
done
adb -s "$IP:5555" get-state 2>/dev/null | grep -q device || {
    t_progresso_fecha
    t_erro "$(t_msg apk_nao_conectou)"; exit 1; }

t_progresso_texto "$(t_msg apk_instalando_partes "${#PARTES[@]}")"
SAIDA="$(timeout 900 adb -s "$IP:5555" install-multiple -r "${PARTES[@]}" 2>&1)"
t_diz "$SAIDA"

# Extra data files (OBB), when present.
if [ "$OBB" = 1 ] && [ -d "$TMP/Android/obb" ]; then
    t_progresso_texto "$(t_msg apk_copiando_dados)"
    adb -s "$IP:5555" shell mkdir -p /sdcard/Android/obb >>"$LOG" 2>&1
    for d in "$TMP"/Android/obb/*/; do
        [ -d "$d" ] || continue
        adb -s "$IP:5555" push "$d" /sdcard/Android/obb/ >>"$LOG" 2>&1
    done
fi

adb disconnect "$IP:5555" >>"$LOG" 2>&1
t_progresso_fecha
resultado "$SAIDA"
exit $?
