<?xml version="1.0" encoding="UTF-8"?>
<!--
  freedesktop knows .apk (application/vnd.android.package-archive) but does not
  know the split-package formats. Without these types a .xapk is detected as a
  generic ZIP and the double click never reaches Tandem.

  They are declared as a subclass of application/zip: that is what makes the
  extension match win over content sniffing, which would only see a ZIP.

  The pt_BR <comment> lines are what the user reads in the file manager, so
  they stay in Portuguese.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">

  <mime-type type="application/vnd.android.xapk">
    <comment>Android app bundle (XAPK)</comment>
    <comment xml:lang="pt_BR">Pacote de aplicativo Android (XAPK)</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.xapk" weight="60"/>
    <generic-icon name="package-x-generic"/>
  </mime-type>

  <mime-type type="application/vnd.android.apks">
    <comment>Android split package (APKS)</comment>
    <comment xml:lang="pt_BR">Pacote Android dividido (APKS)</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.apks" weight="60"/>
    <generic-icon name="package-x-generic"/>
  </mime-type>

  <mime-type type="application/vnd.android.apkm">
    <comment>Android split package (APKM)</comment>
    <comment xml:lang="pt_BR">Pacote Android dividido (APKM)</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.apkm" weight="60"/>
    <generic-icon name="package-x-generic"/>
  </mime-type>

</mime-info>
